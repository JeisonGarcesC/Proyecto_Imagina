{
  "name": "proyecto-imagina",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/authApi.test.js test/authRuntime.test.js test/devAuth.test.js test/text2D.test.js server/test/accessToken.test.js server/test/authMiddleware.test.js server/test/authService.test.js server/test/bootstrapSuperadmin.test.js server/test/lastSuperadminGuard.test.js server/test/passwordService.test.js server/test/permissionResolver.test.js server/test/userDto.test.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "server:dev": "node --watch server/src/server.js",
    "server:start": "node server/src/server.js",
    "server:test": "node --test server/test",
    "test:walls": "node --test test/walls.test.js test/columns.test.js test/architectureSnap.test.js test/openings.test.js",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "admin:bootstrap": "node server/scripts/bootstrapSuperadmin.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dxf-parser": "^1.1.2",
    "dxf-writer": "^1.18.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^5.4.624",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three-stdlib": "^2.36.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
