	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}


	str material="-22015138";

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
        
	double cantidadVisor= 0;

	double cantidadKitNave=0;

	if (countFuntionDoors()==0) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 1;
	} else if (countFuntionDoors()==1) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 2;
	} else if (countFuntionDoors()==2) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 3;
	} else if (countFuntionDoors()==3) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 4;
	}

	StrBuf buf();
	buf << "LOCKERKITNAVE" # cantidadKitNave # "PFORAP_" # ancho # "_" # profundidad #  "_" # altura ;


	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMelamina() , quantity=cantidadVisor, descripcionSpecial);
	    return MplSpecialPartJeisonSpecial(this, buf.toS , getOptionsMaterialsKitNaveMelamina, withSpecialWord=true);
	} else {

	    //return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveMelamina(), quantity=cantidadVisor);
	    return MplSpecialPartJeisonSpecial(this, buf.toS , getOptionsMaterialsKitNaveMelamina, withSpecialWord=false);
	    

	}
	return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveMelamina(), quantity=cantidadVisor);
	 
      }

      // naves metalicas embebidas 


      extend public MplPart getPartKitNaveEmbebida(PartsEnv env) {

	double alturaReal= h * 100;
	double altura= 0;
	if (alturaReal <=180) {
	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal= w*100;
	double ancho= 0 ;
	if (anchoReal <=50) {
	    ancho = 50;

	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
        
	double cantidadVisor= 0;

	double cantidadKitNave=0;

	if (countFuntionDoors()==0) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 1;
	} else if (countFuntionDoors()==1) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 2;
	} else if (countFuntionDoors()==2) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 3;
	} else if (countFuntionDoors()==3) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 4;
	}

	StrBuf buf();
	buf << "LOCKERKITNAVE" # cantidadKitNave # "PLAMEM_" # ancho # "_" # profundidad #  "_" # altura # "_" # calibreReal ;


	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico() , quantity=cantidadVisor, descripcionSpecial);
	    return MplSpecialPartJeisonSpecial(this, buf.toS , getOptionsMaterialsKitNaveMetalico, withSpecialWord=true);
	} else {

	    //return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	    return MplSpecialPartJeisonSpecial(this, buf.toS , getOptionsMaterialsKitNaveMetalico, withSpecialWord=false);


	}
	return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	 
    }


    
