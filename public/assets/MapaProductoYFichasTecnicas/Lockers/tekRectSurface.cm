    // VISOR MPR280032

     extend public Primitive3D visor3D(FetchEnv3D env) {
	
        
	//c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D

	 
	double alturaTotal = h;

	double altura=alturaTotal;

	/*

	if (countFuntionDoors() == 0) {
	    altura= (alturaTotal/2)+5cm;
	} else if (countFuntionDoors() == 1) {
	    altura= (alturaTotal/4)+5cm;
	} else if (countFuntionDoors() == 2) {
	    altura= (alturaTotal/8)+5cm;
	} else if (countFuntionDoors() == 3) {
	    altura= (alturaTotal/16)+7cm;
	}
	*/

	if (countFuntionDoors() == 0) {
	    //altura= (alturaTotal/2)+15cm;
	    altura= (alturaTotal/2-150mm/2);
	} else if (countFuntionDoors() == 1) {
	    altura= (alturaTotal/4)-15cm/2 + 14.5mm;
	} else if (countFuntionDoors() == 2) {
	    altura= (alturaTotal/8)-15cm/2 + 94mm;
	} else if (countFuntionDoors() == 3) {
	    altura= (alturaTotal/16)-15cm/2 + 133mm;
	}
	
	//str url = "c:/CetDev/version14.0/extensions/custom/mepal/furniture/worksurfaces/lockers/res/models/" # cm3dM # ".cm3D";
	Primitive3D cache = cache3D(cm3DFileNameVisor(), env.detail, w,  getGrommetMaterial, altura) {


	    //cm= aqui me trajo el objeto correspondiente en 3D
	    //c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D
	    Primitive3D[] prims();

	    
	    Cm3D cm = getCm3D(urlVisor());

	    //mplGetCM3DPrimByID= ESto me retorna el objeto grommet final en si, no en cache
	    //pln("el cm: " # cm);
	    Primitive3D visor = mplGetCM3DPrimByID(env, "0", null, cm);
	    //visor.move(((w/2)-5cm, -2.1cm, altura));
	    //visor.move(((w)-135mm, -21mm, altura));
	    visor.move(((w)-135mm, -23mm, altura));

	    //visor.setMaterial(getAccessoriesMaterial.material3D); // material 3d del visor
	    visor.setColor(156, 156, 156);
	    prims << visor;
	    Primitive3D prim = safeInstance3D(prims);
	    
	    result prim;
	};
	return cache;
     }

     extend public str cm3DFileNameVisor() {
	str prefix;

	prefix="MPR280032";

	if (visorFuncion() == 0) {
	    prefix="MPR280032";
	} else {
	    prefix="Nivelador_1_1_2_IND"; // mandamos el nivelador porque esta en un layer diferente y no se va a ver
	    // pero lo mandamos, porque no es correcto enviar objetos vacios. Es mejor enviar algo que no se vea
	}
	

	//prefix = "MPR280032";//Nuevo LKAC250000

	return prefix # ".cm3D";

    }

    extend public Url urlVisor() {
	return cmFindUrl(lockersCm3dPath # cm3DFileNameVisor());
    }

  




    // DUCTO INTERMEDIO ESPECIAL CAJA

    extend public Primitive3D coraza(FetchEnv3D env) {

	//pln("la altura: " # h);
        //setDimension("h", 240cm );
        //pln("la altura toDistanceSubSet(elevationRange): " # toDistanceSubSet(elevationRange));
        /*
        for (k in dimensions) {
            if (SubSet d = dimensionDomain(k)) {
                double v = dimension(k);
                //pln("el k: " # v);
                Object o = dimension(k).distance;
                pln("el o: " # o);
                //Class co = o.class;
                //str label = getRs(("ws_" # k), #:package);
            }
        }
        */
        //        DoubleEnum e = dimensionDomain("b").DoubleEnum
        //setDimension("b", dimensionDomain("b").closest(dimension("b")+cLinkIndividualOffset).Double.v);
        //double d = dimensionDomain(getStretchDomainId(h)).closest(10cm).Double.v;
        //double let= dimensionDomain("f").first.Double.v;
        //pln("la altura que llega: " # let);
        //pln("la altura que llega: " # dimensionDomain("f").DoubleEnum);
        //double val = dimensionDomain("f").closestSucceeding(h).Double.v;
        //double val1 = dimensionDomain("f").closest(h).Double.v;
        //pln("la altura: " # val);
        //pln("la altura: " # val1);
        //if (TekRectSurface ws = otherWs.TekRectSurface) {
        //double newS = 0;
        //if (newS in dimensionDomain("f")) {
        //    pln("news: " # newS);
        //   setDimension("f", newS);
        //   animationProperties.setDistance("f", newS.distance);
        //}
        //PLN("altura de la funcion" # elevationRange.first());
        //pln("altura de la funcion" # elevationRange.hash() );
        //pln("altura de la funcion" # elevationRange.safeDouble() );
        //setDimension("f", 1800cm);
                //elevationRange.closest(10cm);
        
        //pln("elevation range : " # elevationRange("f"));
        //pln("elevation range : " # elevationRange("f"));
        //double altura= alturaCoraza;
        //double altura= alturaCoraza;
        //pln("cTekWSEdgeIdHight: " # cTekWSEdgeIdHeight);
        //pln("cTekWSEdgeIdHeight: " # cTekWSEdgeIdHeight);
        //pln("h: " # h);
        //pln("h: " # h);
        //pln("w: " # w);
        //pln("w: " # w);
        //double cutoutW = tekWidthSurfaceCode(this);
        
          //pln("lo uqe asifnee: " # cutoutW );
        //pln("lo uqe asifnee: " # getSurfaceOnEdge("rb") );
        //pln("lo uqe asifnee: " # dimension("f") );//  1.79769e+308
        //pln("lo uqe asifnee: " # dimension("ls") );  1.79769e+308

	Primitive3D[] prims();


	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;

	double height= h- alturaTapas - nivelador;

	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);

	
	// Ducto cableado
	//double w = 135mm;
        //double d = 100mm;
	//double w = 0mm;
        //double d = 0mm;

	//Loker
	double w = w;//ancho
        double d = ls;//profundidad

	//pln("w: " # w);
	//pln("d: " # d);
	
	//LOCKERS
	// Estos son los lockers, sirve para ducto doble
	
        APath2D path((0mm, 1mm));
        path.lineTo((0, d-1mm));
        path.arcTo((1mm, d), 90deg);
        path.lineTo((w-1mm, d));
        path.arcTo((w, d-1mm), 0deg);
        path.lineTo((w, 1mm));
        path.arcTo((w-1mm, 0), -90deg);
        path.lineTo((w-15mm, 0));
        path.arcTo((w-16mm, 1mm), 180deg);
        path.lineTo((w-16mm, 45mm));
        path.lineTo((w-1mm, 45mm));
        path.arcTo((w-1mm, d-2mm), 90deg);
        path.lineTo((w-2mm, d-1mm));
        path.lineTo((2mm, d-1mm));
	path.arcTo((1mm, d-2mm), 180deg);
        path.lineTo((1mm, 45mm));
        path.lineTo((16mm, 45mm));
        path.lineTo((16mm, 1mm));
        path.arcTo((15mm, 0mm), -90deg);
        path.lineTo((1mm, 0mm));
        path.arcTo((0mm, 1mm), 180deg);
        path.close();



	PolygonMesh3D mesh2(path, height=height);//altura
	// alturas originales o nominales -> 1800 y 2200
	//alturas de la coraza -> 1650 y 2200
	//alturas -> 1650- 20base - 45techo =1630  y 2200-20=2180


	//PolygonMesh3D pata1(path, 694.5mm);

	// rotar es para ducto cableado
	//mesh2.rotate((90deg, 0deg, 90deg));
	
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((0, 0, nivelador));

	/*Bool clockwise=null,
		       bool onlySides=false,
		       bool noSides=false,
		       bool doublePoints=false,
		       bool closeIfNecessary=false,
	*/

	Primitive3D p = Instance3D(prims);

	//p.setMaterial(.material3D);
	p.setMaterial(getAccessoriesMaterial.material3D);

	

 
	return p;
	//return null:
    }

    extend public Primitive3D tapaSup(FetchEnv3D env) {
	Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;
	//double height= h;//tekWidthSurfaceCode(this);
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);

	
	// Ducto cableado
	//double w = 135mm;
        //double d = 100mm;
	//double w = 0mm;
        //double d = 0mm;

	//Loker
	double w = w;//ancho
        double d = ls;//profundidad


	//double alturatapa= 1585mm;//h;
	double alturatapa= h - alturaTapas+0.1mm;
	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double espesor= alturaTapas;
	//pln("altura: " # altura);
	
	
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, d-1mm));
	path.arcTo((1mm, d), 90deg);
	path.lineTo((w-1mm, d));
	path.arcTo((w, d-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();

	PolygonMesh3D mesh2(path, height=espesor);//altura
	// alturas originales o nominales -> 1800 y 2200
	//alturas de la coraza -> 1650 y 2200
	//alturas -> 1650- 20base - 45techo =1630  y 2200-20=2180


	
	prims << mesh2;
	//Mover es para ducto cableado
	
	//mesh2.move((0, 0, alturaCoraza + nivelador + 0.2mm ));
	mesh2.move((0, 0, alturatapa ));

	/*Bool clockwise=null,
		       bool onlySides=false,
		       bool noSides=false,
		       bool doublePoints=false,
		       bool closeIfNecessary=false,
	*/

	Primitive3D p = Instance3D(prims);
	p.setMaterial(getAccessoriesMaterial.material3D);
	//p.setMaterial(getMaterial.material3D);
	

 
	return p;
	//return null:
    }

     extend public Primitive3D tapaInf(FetchEnv3D env) {
	Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;
	double height= tekWidthSurfaceCode(this);

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);

	//Loker
	double w = w;//ancho
        double d = ls;//profundidad

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double altura= alturaTapas; // jeison: desde el header - no olvidar estas notas rodolfo
	//LOCKERS
	//BASE LOCKER
 
        
	//double w = 500mm;
	//double d = 500mm;
 
 
	APath2D path((16.5mm, 1mm)); //1
	path.lineTo((16.5mm, 45.5mm)); //2
	path.lineTo((1.5mm, 45.5mm)); //3
	path.lineTo((1.5mm, d-1.5mm)); //4
	path.lineTo((w-1.5mm, d-1.5mm)); //5
	path.lineTo((w-1.5mm, 45.5mm)); //6
	path.lineTo((w-16.5mm, 45.5mm)); //7
	path.lineTo((w-16.5mm, 1.0mm)); //8
	path.arcTo((w-17.5mm, 0mm), -90deg); //9
	path.lineTo((17.5mm, 0mm)); //10
	path.arcTo((16.5mm, 1mm), 180deg); //11
	path.close();


	PolygonMesh3D mesh2(path, height=altura);//altura

	mesh2.setMaterial(getAccessoriesMaterial.material3D);
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((0, 0, nivelador));
	//mesh2.rotate((90deg, 0deg, 0deg));
	

        

	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     extend public Primitive3D kitNave(FetchEnv3D env) {
	Primitive3D[] prims();

        


	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = w-4mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;

	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
	PolygonMesh3D mesh2(path, height=thickness);//altura

	if (tipofuncionSuperficie()==0 or tipofuncionSuperficie()==2) {
	    mesh2.setMaterial(getSharedLegMaterial.material3D);
	    //mesh2.setMaterial(defaultSurfaceMaterial.material3D);
	    //mesh2.setMaterial(defaultEdgeMaterial.material3D);
	    //mesh2.setMaterial(defaultSharedLegEdgeMaterial.material3D);
	    //mplMaterialSelector(getEdgeMaterial, env)

	} else if (tipofuncionSuperficie()==1) {
	    mesh2.setMaterial(getMaterial.material3D);
	} else {
	    mesh2.setMaterial(getEdgeMaterial.material3D);
	}



	//productLineSettings.defaultSurfaceMaterial()
	//material3D(env)
	//ws.getMaterial().MplMaterial
	//ws.getEdgeMaterial().MplMaterial
	//drawerEdgeMaterial.material3D
	
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((2mm, nivelador + borde, 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));

	//prims <<? manija3D(env);// groomet
	
	prims <<? visor3D(env);// groomet

	

	if (!modulacionFuncionCerraduras().ninguno) {
	    prims <<? cerradura3D(env);// groomet
	}

	if (!modulacionFuncionCerraduras().nueve) {
	    /***************************************************************
	     * si tiene cerradura con clave , las manijas no llamaran 
	     * a su bloque
	     * nave lisa individual
	     * roob 03-01-2024
	     ***************************************************************/
	    
	    if (!modulacionFuncionVigasCostados().ninguno) {
		prims <<? manija3D2(env);// groomet
	    }
	}
	

	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     
     /**********************************************************************
      *roob : 12/12/2023
      *nave puertas en formica y melamina , las medidas no incluyen el acabado termofundido 
      *este pertenece a la clase del locker individual
      **********************************************************************/
     
     extend public Primitive3D kitNaveFormicaMelamina(FetchEnv3D env) {
	Primitive3D[] prims();

        //double height= tekWidthSurfaceCode(this);

	double altura = h;
	//pln("que es altura actual ... : " # alturaActual());

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	double canto = 2mm;//medida del canto termofundido
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde) - (2*canto) - nivelador;
	double nave2 = (nave1 - luzNave - (2*canto)) / 2;
	double nave3 = (nave1 - (luzNave*2) - (4*canto)) /3;
	double nave4 = (nave1 - (luzNave*3) - (6*canto)) /4;
	//pln("que es altura actual ... : " # nave1);
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = w - 4mm - (2*canto);//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
        
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
	PolygonMesh3D mesh2(path, height=thickness);//altura

	if (tipofuncionSuperficie()==0 or tipofuncionSuperficie()==3) {
	    mesh2.setMaterial(getSharedLegMaterial.material3D);
	    //mesh2.setMaterial(getMaterial.material3D);
	    //mesh2.setMaterial(defaultSurfaceMaterial.material3D);
	    //mesh2.setMaterial(defaultEdgeMaterial.material3D);
	    //mesh2.setMaterial(defaultSharedLegEdgeMaterial.material3D);
	    //mplMaterialSelector(getEdgeMaterial, env)

	} else if (tipofuncionSuperficie()==1) {
	    mesh2.setMaterial(getMaterial.material3D);
	} else if (tipofuncionSuperficie()==2 ) {
	    mesh2.setMaterial(getMaterial.material3D);
	} else {
	    //mesh2.setMaterial(getEdgeMaterial.material3D);
	}

	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((2mm + canto, nivelador + borde + canto, 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));
	//mesh2.rotate((0deg, 0deg, 00deg));

	//prims <<? manija3D(env);// groomet
	
	prims <<? visor3D(env);// groomet

	if (!modulacionFuncionCerradurasMadera().ninguno) {
	    prims <<? cerraduraMadera3D(env);// groomet
	}

	if (!modulacionFuncionCerradurasMadera().nueve) {
	    /***************************************************************
	     * si tiene cerradura con clave , las manijas no llamaran 
	     * a su bloque
	     * nave lisa individual
	     * roob 03-01-2024
	     ***************************************************************/
	    
	    if (!manijasFuncionMadera().ninguno) {
		prims <<? manijaMadera3D(env);// groomet
	    }
	}


	Primitive3D p = Instance3D(prims);
 
	return p;
	//return null:
     }

     /**********************************************************************
      * canto termofundido de las naves formica y melamina
      *	roob : 12/12/2023
      *	este pertenece a la clase del locker individual
      *	
      **********************************************************************/
     // El canto es este, el otro es una opcion 
    extend public Primitive3D canto2(FetchEnv3D env) {

	double f = h;//altura
	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	double canto = 2mm;//medida del canto termofundido
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde) - nivelador;
	double nave2 = (nave1 - luzNave ) / 2;
	double nave3 = (nave1 - (luzNave*2) ) /3;
	double nave4 = (nave1 - (luzNave*3) ) /4;

	double thickness = 16mm;

	double w = w - 4mm ;//ancho
        double d = ls;//profundidad

	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
	

	Primitive3D[] prims();

	box b = box((0mm, 0mm, 0mm), w, f, thickness);
	// box (-245 , -150 , -11) , 590 , 300 , 11 

	//Primitive3D hole = fastBox3D(b.p0.pointF, b.p1.pointF, top=false);
	//hole.setMaterial(plainGrayMaterial3D);
	//prims << hole;

	HollowBox3D frame(b.rect, canto, thickness);
	frame.rotate((0deg, 0deg, 90deg));
	frame.move((2mm , -2mm ,  nivelador + borde ));
	//frame.rotate((0deg, 0deg, 90deg));
	//frame.move((-(w/2), 5.5mm, 743mm));
	//isWoodSurface = true ;
	frame.setMaterial(getEdgeMaterial.material3D);
	//frame.setMaterial(plainGrayMaterial3D);
	prims << frame;
	return frame;

	

	//return safeInstance3D(prims, this);
    
    }

     
    //// Kit Nave Embebida
    /***********************************************************************
     * pertenece a la clase de locker individual
     * metodo extend original de la nave embebida metalica
     ***********************************************************************/
    

     extend public Primitive3D kitNaveEmbebida(FetchEnv3D env) {
	Primitive3D[] prims();

        


	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = h - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;


	//Loker
	double w = w-36mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
	//kit nave
 
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
 
	//// vovelmove

	PolygonMesh3D mesh2(path, height=thickness);//altura

	mesh2.setMaterial(getSharedLegMaterial.material3D);
	//mesh2.setMaterial(getMaterial.material3D);
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((18mm , nivelador + borde + luzNave , 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));
	mesh2.move((0 , 18mm , 0));
	//mesh2.move((18mm , 0 , 10mm));	

	if (!modulacionFuncionCerraduras().ninguno) {
	    Primitive3D cerraduraEmbebidas= cerraduraEmbebida3D(env);
	    cerraduraEmbebidas.move((0 , 20mm , 0));
	    prims <<? cerraduraEmbebidas;
	}

	//prims <<? manija3D(env);// groomet
	if (!modulacionFuncionVigasCostados().ninguno) {
	    Primitive3D manijasEmbebidas= manija3D2(env);
	    manijasEmbebidas.move((0 , 20mm , 0));
	    prims <<? manijasEmbebidas;// groomet
	}
	
	Primitive3D respuestaVisor3D = visor3D(env);
	respuestaVisor3D.move((0, 18mm , 0));
	prims <<? respuestaVisor3D;


        

	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
    }

   
     /**********************************************************************
      * kit nave troquel para cuerpo individual
      *	roob 27/12/2023
      **********************************************************************/
     
    extend public Primitive3D kitNaveTroquel(FetchEnv3D env) {
	Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;

	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = w-4mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}


	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
	//PARA TROQUELES ARRIBA
	// 1 troquelado
  
        APath2D path1((0mm, 1mm)); //1
	path1.lineTo((0mm, f-1mm)); //2
	path1.arcTo((1mm, f), 90deg); //3
	path1.lineTo((w-1mm, f)); //4
	path1.arcTo((w, f-1mm), 0deg); //5
	path1.lineTo((w, f-15mm)); //6
	path1.lineTo(((w/2)-125mm, f-15mm)); //7
	path1.lineTo(((w/2)-125mm, f-120mm)); //8
	path1.lineTo(((w/2)+125mm, f-120mm)); //9
	path1.lineTo(((w/2)+125mm, f-15mm)); //10
	path1.lineTo((w, f-15mm)); //11
	//path1.lineTo((w, 120mm)); //12
	//path1.lineTo(((w/2)-145mm, 120mm)); //13
	//path1.lineTo(((w/2)-145mm, 15mm)); //14
	//path1.lineTo(((w/2)+145mm, 15mm)); //15
	//path1.lineTo(((w/2)+145mm, 120mm)); //16
	//path1.lineTo((w, 120mm)); //17
	path1.lineTo((w, 1mm)); //18
	path1.arcTo((w-1mm, 0mm), -90deg); //19
	path1.lineTo((1mm, 0mm)); //20
	path1.arcTo((0mm, 1mm), -180deg); //11
	
	path1.close();

	PolygonMesh3D mesh1(path1, height=thickness);//altura

	mesh1.move((2mm, 0, 0));

	mesh1.setMaterial(getSharedLegMaterial.material3D);
 
	

	//PARA TROQUELES NAVE LOCKER DOBLE CAJA
 
	APath2D path2((0mm, 1mm)); //1
	path2.lineTo((0mm, f-1mm)); //2
	path2.arcTo((1mm, f), 90deg); //3
	path2.lineTo((w-1mm, f)); //4
	path2.arcTo((w, f-1mm), 0deg); //5
	path2.lineTo((w, f-15mm)); //6
	path2.lineTo(((w/2)-125mm, f-15mm)); //7
	path2.lineTo(((w/2)-125mm, f-120mm)); //8
	path2.lineTo(((w/2)+125mm, f-120mm)); //9
	path2.lineTo(((w/2)+125mm, f-15mm)); //10
	path2.lineTo((w, f-15mm)); //11
	path2.lineTo((w, 120mm)); //12
	path2.lineTo(((w/2)-125mm, 120mm)); //13
	path2.lineTo(((w/2)-125mm, 15mm)); //14
	path2.lineTo(((w/2)+125mm, 15mm)); //15
	path2.lineTo(((w/2)+125mm, 120mm)); //16
	path2.lineTo((w, 120mm)); //17
	path2.lineTo((w, 1mm)); //18
	path2.arcTo((w-1mm, 0mm), -90deg); //19
	path2.lineTo((1mm, 0mm)); //20
	path2.arcTo((0mm, 1mm), -180deg); //11
	
	path2.close();

	PolygonMesh3D mesh2(path2, height=thickness);//altura
	mesh2.move((2mm, 0, 0));
	mesh2.setMaterial(getSharedLegMaterial.material3D);

	//PARA TROQUELES ABAJO NAVE LOCKER 
 
	APath2D path3((0mm, 1mm)); //1
	path3.lineTo((0mm, f-1mm)); //2
	path3.arcTo((1mm, f), 90deg); //3
	path3.lineTo((w-1mm, f)); //4
	path3.arcTo((w, f-1mm), 0deg); //5
	//path.lineTo((w, f-15mm)); //6
	//path.lineTo(((w/2)-145mm, f-15mm)); //7
	//path.lineTo(((w/2)-145mm, f-120mm)); //8
	//path.lineTo(((w/2)+145mm, f-120mm)); //9
	//path.lineTo(((w/2)+145mm, f-15mm)); //10
	//path.lineTo((w, f-15mm)); //11
	path3.lineTo((w, 120mm)); //12
	path3.lineTo(((w/2)-125mm, 120mm)); //13
	path3.lineTo(((w/2)-125mm, 15mm)); //14
	path3.lineTo(((w/2)+125mm, 15mm)); //15
	path3.lineTo(((w/2)+125mm, 120mm)); //16
	path3.lineTo((w, 120mm)); //17
	path3.lineTo((w, 1mm)); //18
	path3.arcTo((w-1mm, 0mm), -90deg); //19
	path3.lineTo((1mm, 0mm)); //20
	path3.arcTo((0mm, 1mm), -180deg); //11
	
	path3.close();

	PolygonMesh3D mesh3(path3, height=thickness);//altura
	mesh3.move((2mm, 0, 0));
	mesh3.setMaterial(getSharedLegMaterial.material3D);
	//prims << mesh2;
	//Mover es para ducto cableado
	//mesh2.move((0, 35mm, 2mm));
	//mesh2.rotate((0deg, 0deg, 90deg));
	
	//pln("lo que devuelve punch : " # punchFuntionPosition());
	
	double posicionTroquelUp = (nave1 + nivelador + borde) -120mm;
	if (punchFuntionPosition.up) {
	    prims << mesh1;
	    mesh1.move((0, nivelador + borde, 2mm)); //nivelador + borde = 26mm
	    mesh1.rotate((0deg, 0deg, 90deg));
	    
	    Primitive3D troquelRespuesta2 = troquel(env);
	    prims << troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
	        troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp ));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
	        troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    }
	    troquelRespuesta2.move((2mm, 0, 0));
	    
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);

	} else if (punchFuntionPosition().down) {
	    prims << mesh3;
	    mesh3.move((0, nivelador + borde, 2mm));
	    mesh3.rotate((0deg, 0deg, 90deg));
	    Primitive3D troquelRespuesta = troquelDown(env);
	    prims << troquelRespuesta;
	    troquelRespuesta.move((w/2-(290mm/2), -18mm, 41mm));
	    troquelRespuesta.move((2mm, 0, 0));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	} else {
	    prims << mesh2;
	    mesh2.move((0, nivelador + borde, 2mm));
	    mesh2.rotate((0deg, 0deg, 90deg));
	    //Primitive3D troquelRespuesta = troquel(env);
	    Primitive3D troquelRespuesta = troquelDown(env);
	    troquelRespuesta.move((w/2-(290mm/2), -18mm, 41mm));
	    troquelRespuesta.move((2mm, 0, 0));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	    prims <<? troquelRespuesta;


	    Primitive3D troquelRespuesta2 = troquel(env);
	    //troquelRespuesta2.move((w/2-(290mm/2), -18mm, altura - 136mm));
	    
	    prims <<? troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
	        troquelRespuesta2.move(((w/2)-(290mm/2), -18mm, posicionTroquelUp ));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
	        troquelRespuesta2.move(((w/2)-(290mm/2), -18mm, posicionTroquelUp));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		troquelRespuesta2.move(((w/2)-(290mm/2), -18mm, posicionTroquelUp));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		troquelRespuesta2.move(((w/2)-(290mm/2), -18mm, posicionTroquelUp));
	    }
	    troquelRespuesta2.move((2mm, 0, 0));
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	    //return  invisiblePrimitive3D;
	}
	
        //
	//prims <<? troquelRespuesta2;
	if (!modulacionFuncionCerraduras().ninguno) {
	    prims <<? cerradura3D(env);// groomet
	}
	
        if (!modulacionFuncionCerraduras().nueve) {
	    /***************************************************************
	     * si tiene cerradura con clave , las manijas no llamaran 
	     * a su bloque
	     * nave lisa individual
	     * roob 03-01-2024
	     ***************************************************************/
	    
	    if (!modulacionFuncionVigasCostados().ninguno) {
		prims <<? manija3D2(env);// groomet
	    }
	}

	
	
	prims <<? visor3D(env);
	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
    }

    ////KitNAveEmbebidoTrqueladoSencillo
    /***********************************************************************
     * 14/12/2023
     * nave troquelada embebida
     * este metodo le pertenece a la clase locker individual
     ***********************************************************************/
    
     extend public Primitive3D kitNaveTroquelEmbebida(FetchEnv3D env) {
	Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;

	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = w-36mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}


	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
        
	//PARA TROQUELES ABAJO
	// 1 troquelado
  
        APath2D path1((0mm, 1mm)); //1
	path1.lineTo((0mm, f-1mm)); //2
	path1.arcTo((1mm, f), 90deg); //3
	path1.lineTo((w-1mm, f)); //4
	path1.arcTo((w, f-1mm), 0deg); //5
	path1.lineTo((w, f-15mm)); //6
	path1.lineTo(((w/2)-125mm, f-15mm)); //7
	path1.lineTo(((w/2)-125mm, f-120mm)); //8
	path1.lineTo(((w/2)+125mm, f-120mm)); //9
	path1.lineTo(((w/2)+125mm, f-15mm)); //10
	path1.lineTo((w, f-15mm));
	path1.lineTo((w, 1mm)); //18
	path1.arcTo((w-1mm, 0mm), -90deg); //19
	path1.lineTo((1mm, 0mm)); //20
	path1.arcTo((0mm, 1mm), -180deg); //11
	
	path1.close();

	PolygonMesh3D mesh1(path1, height=thickness);//altura

	mesh1.move((18mm, luzNave, -18mm));//ejes x , z , y
	

	

	mesh1.setMaterial(getSharedLegMaterial.material3D);
 
	

	//PARA TROQUELES NAVE LOCKER DOBLE CAJA
 
	APath2D path2((0mm, 1mm)); //1
	path2.lineTo((0mm, f-1mm)); //2
	path2.arcTo((1mm, f), 90deg); //3
	path2.lineTo((w-1mm, f)); //4
	path2.arcTo((w, f-1mm), 0deg); //5
	path2.lineTo((w, f-15mm)); //6
	path2.lineTo(((w/2)-125mm, f-15mm)); //7
	path2.lineTo(((w/2)-125mm, f-120mm)); //8
	path2.lineTo(((w/2)+125mm, f-120mm)); //9
	path2.lineTo(((w/2)+125mm, f-15mm)); //10
	path2.lineTo((w, f-15mm)); //11
	path2.lineTo((w, 120mm)); //12
	path2.lineTo(((w/2)-125mm, 120mm)); //13
	path2.lineTo(((w/2)-125mm, 15mm)); //14
	path2.lineTo(((w/2)+125mm, 15mm)); //15
	path2.lineTo(((w/2)+125mm, 120mm)); //16
	path2.lineTo((w, 120mm)); //17
	path2.lineTo((w, 1mm)); //18
	path2.arcTo((w-1mm, 0mm), -90deg); //19
	path2.lineTo((1mm, 0mm)); //20
	path2.arcTo((0mm, 1mm), -180deg); //11
	
	path2.close();

	PolygonMesh3D mesh2(path2, height=thickness);//altura
	mesh2.move((18mm, luzNave, -18mm));//ejes x , z , y
        
	mesh2.setMaterial(getSharedLegMaterial.material3D);

	//PARA TROQUELES ARRIBA NAVE LOCKER 
 
	APath2D path3((0mm, 1mm)); //1
	path3.lineTo((0mm, f-1mm)); //2
	path3.arcTo((1mm, f), 90deg); //3
	path3.lineTo((w-1mm, f)); //4
	path3.arcTo((w, f-1mm), 0deg); //5
	path3.lineTo((w, 120mm)); //12
	path3.lineTo(((w/2)-125mm, 120mm)); //13
	path3.lineTo(((w/2)-125mm, 15mm)); //14
	path3.lineTo(((w/2)+125mm, 15mm)); //15
	path3.lineTo(((w/2)+125mm, 120mm)); //16
	path3.lineTo((w, 120mm)); //17
	path3.lineTo((w, 1mm)); //18
	path3.arcTo((w-1mm, 0mm), -90deg); //19
	path3.lineTo((1mm, 0mm)); //20
	path3.arcTo((0mm, 1mm), -180deg); //11
	
	path3.close();

	PolygonMesh3D mesh3(path3, height=thickness);//altura
	mesh3.move((18mm, luzNave, -18mm));//ejes x , z , y;
	mesh3.setMaterial(getSharedLegMaterial.material3D);

	/*******************************************************************
	 * troquelado arriba , individual
	 * roob 28/12/2023
	 *******************************************************************/
	
	double posicionTroquelUp = (nave1 + nivelador + borde + luzNave +8mm) -128mm;
	if (punchFuntionPosition.up) {
	    prims << mesh1;
	    mesh1.move((0, nivelador + borde, 2mm)); //nivelador + borde = 26mm
	    mesh1.rotate((0deg, 0deg, 90deg));
	    
	    Primitive3D troquelRespuesta2 = troquel(env);
	    prims << troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
		troquelRespuesta2.move((w/2-(290mm/2)+ 18mm, 0, posicionTroquelUp ));
		//troquelRespuesta2.move((w/2-(290mm/2)+ 18mm, 0, 1653mm ));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0,  posicionTroquelUp + luzNave ));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0, (posicionTroquelUp+luzNave)));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0, (posicionTroquelUp+luzNave)));
	    }
	    //troquelRespuesta2.move((3mm, 0, 0));
	    
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	} else if (punchFuntionPosition().down) {
	    prims << mesh3;
	    mesh3.move((0, nivelador + borde, 2mm));
	    mesh3.rotate((0deg, 0deg, 90deg));
	    Primitive3D troquelRespuesta = troquelDown(env);
	    prims << troquelRespuesta;
	    troquelRespuesta.move((w/2-(290mm/2)+18mm , 0 , 50mm));
	    troquelRespuesta.move((0, 0, 3mm));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	} else {
	    prims << mesh2;
	    mesh2.move((0, nivelador + borde, 2mm));
	    mesh2.rotate((0deg, 0deg, 90deg));
	     

	    /// troquel abajo 
	    Primitive3D troquelRespuesta = troquelDown(env); // ejes x y z
	    troquelRespuesta.move((w/2-(290mm/2)+16mm , 0 , 50mm));
	    troquelRespuesta.move(( 2mm, 0 , 3mm));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	    prims <<? troquelRespuesta;

	    

	    
	    Primitive3D troquelRespuesta2 = troquel(env);
	    //troquelRespuesta2.move((w/2-(290mm/2), 20mm, 0));
	    prims <<? troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
	        troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -117mm;
	        troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -117mm;
		troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -117mm;
		troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    }
	    //troquelRespuesta2.move((30mm, 10mm, 0));
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	    //return  invisiblePrimitive3D;
	    

	}
	
	//
	//prims <<? troquelRespuesta2;

	if (!modulacionFuncionVigasCostados().ninguno) {
	    Primitive3D manijasEmbebidas= manija3D2(env);
	    manijasEmbebidas.move((0 , 20mm , 0));
	    prims <<? manijasEmbebidas;// groomet
	}

	if (!modulacionFuncionCerraduras().ninguno) {
	    Primitive3D cerraduraEmbebidas= cerraduraEmbebida3D(env);
	    cerraduraEmbebidas.move((0 , 20mm , 0));
	    prims <<? cerraduraEmbebidas;
	}

    
	Primitive3D respuestaVisor3D = visor3D(env);
	respuestaVisor3D.move((0, 18mm , 0));
	prims <<? respuestaVisor3D;
	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
    }


     

     extend public Primitive3D tabique(FetchEnv3D env) {
	Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;
	//double height= tekWidthSurfaceCode(this);
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);

	//Loker
	double w = w;//ancho
        double d = ls;//profundidad
	//double f = 1585mm;//h;
	double f = h - 25mm;//h;

        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = f - 35mm;//60mm;
	//LOCKERS
        //TABIQUE O DIVISOR LOCKERS

	APath2D path((0mm, 1mm)); //1
	path.lineTo((0mm, 40mm)); //2
	path.lineTo((15.5mm, 40mm)); //3
	path.lineTo((15.5mm, d-45.4mm)); //4
	path.lineTo((0mm, d-45.5mm));; //5
	path.lineTo((0mm, d-1.4mm)); //6
	path.lineTo((32.0mm, d-1.4mm)); //7
	path.lineTo((32.0mm, d-45.5mm)); //8
	path.lineTo((16.5mm, d-45.5mm)); //9
	path.lineTo((16.5mm, 40.0mm)); //10
	path.lineTo((32.0mm, 40.0mm)); //11
	path.lineTo((32.0mm, 1.0mm)); //12
	path.arcTo((31.0mm, 0mm), -90deg); //13
	path.lineTo((1.0mm, 0mm)); //14
	path.arcTo((0mm, 1mm), -180deg); //11
    
	path.close();
	
        //
	//prims <<? troquelRespuesta2;
	PolygonMesh3D mesh1(path, height=thickness);//altura

	mesh1.setMaterial(getAccessoriesMaterial.material3D);

	prims << mesh1;
	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     extend public Primitive3D kitEntrepano(FetchEnv3D env) {
	Primitive3D[] prims();

        

	//Loker
	double w = w;//ancho
        double d = ls;//profundidad
	//double f = 1585mm;//h;
	double f = h - 25mm;//h;

        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 20mm;//60mm;
	//LOCKERS
        //ENTREPANO LOCKERS

	APath2D path((0mm, 46mm)); //1
	path.lineTo((0mm, d-2mm-46mm)); //2
        path.lineTo((17mm, d-2mm-46mm)); //3
	path.lineTo((17mm, d-2mm)); //4
	path.lineTo((w-2mm-17mm, d-2mm));; //5
	path.lineTo((w-2mm-17mm, d-2mm-46mm));
	path.lineTo((w-2mm, d-2mm-46mm));//6
	path.lineTo((w-2mm, 46mm)); //7
	path.lineTo((w-2mm-15.7mm, 46mm)); //8
	path.lineTo((w-2mm-15.7mm, 0mm)); //9
	path.lineTo((15.7mm, 0mm)); //10
	path.lineTo((15.7mm, 46mm)); //11
	path.lineTo((0mm, 46mm)); //12
	//path.arcTo((31.0mm, 0mm), -90deg); //13
	//path.lineTo((1.0mm, 0mm)); //14
	//path.arcTo((0mm, 1mm), -180deg); //11
    
	path.close();
	
        //
	//prims <<? troquelRespuesta2;
	PolygonMesh3D mesh1(path, height=thickness);//altura

	mesh1.setMaterial(getAccessoriesMaterial.material3D);

	prims << mesh1;
	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     extend public Primitive3D anclajePared(FetchEnv3D env) {
	Primitive3D[] prims();

        

	//Loker
	double w = w;//ancho locker
	double a = 300mm;//ancho anclaje
        double d = ls;//profundidad
	//double f = 1585mm;//h;
	double f = h;//h;

        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 1.5mm;//60mm;
	double radious = 2mm;//60mm;
	//LOCKERS
        //ENTREPANO LOCKERS

	APath2D path((0mm, 0mm)); //1
	path.lineTo((0mm, thickness)); //2
	path.lineTo((50mm-radious, thickness)); //2
        path.arcTo(((50mm-thickness), radious), 0deg); //3
	path.lineTo((50mm-thickness, 50mm)); //4
	path.lineTo((50mm, 50mm));; //5
	path.lineTo((50mm, radious));
	path.arcTo(((50mm-radious), 0mm), -90deg); //3
	path.lineTo((0mm, 0mm));//6
        
	path.close();
	
        //
	//prims <<? troquelRespuesta2;
	PolygonMesh3D mesh1(path, height=a);//altura

	mesh1.setMaterial(getAccessoriesMaterial.material3D);
	mesh1.rotate((180deg, 90deg, 0deg));
	mesh1.move((w/2 + (a/2), ls, f + 50mm ));
	prims << mesh1;

	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
    }

     extend public Primitive3D zocalo3D(FetchEnv3D env) {
	Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;
	double height= tekWidthSurfaceCode(this);

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);

	//Loker
	double w = w;//ancho
        double d = ls;//profundidad

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double altura= 10cm; // jeison: desde el header - no olvidar estas notas rodolfo
	//LOCKERS
	//BASE LOCKER
 
        
	//double w = 500mm;
	//double d = 500mm;
 
 
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, d-1mm));
	path.arcTo((1mm, d), 90deg);
	path.lineTo((w-1mm, d));
	path.arcTo((w, d-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();


	PolygonMesh3D mesh2(path, height=altura);//altura

	mesh2.setMaterial(getSharedLegMaterial.material3D);
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((0, 0, nivelador));

        

	Primitive3D p = Instance3D(prims);
	p.setMaterial(getSharedSCMaterial.material3D);
	

 
	return p;
	//return null:
     }

 
  

   
