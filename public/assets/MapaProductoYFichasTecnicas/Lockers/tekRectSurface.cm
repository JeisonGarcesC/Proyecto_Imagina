    /**
     * Build quick properties, return true if done.
     * Cree propiedades rápidas, devuelva verdadero si está hecho.
     */
    public bool buildQuickProperties(QuickProperties props) {
	//super(..);

	//props.append("alturaLocker", $alturaLocker, alturaLockerFuncion(), EnumSubSet(alturaLocker));
	//append(str key, str label, Object o, SubSet domain=null, bool checkDomain=true) {

	
	//props.append("screenType", $screenType, screenType.basic, EnumSubSet(screenType));
	props.append("tipoSuperficie", $tipoSuperficie, tipofuncionSuperficie(), EnumSubSet(tipoSuperficie));
	//posicion del troquelado

	if (tipofuncionSuperficie()== 0 or tipofuncionSuperficie()== 3) {
	    props.append("punchPosition", $punchPosition, punchFuntionPosition(), EnumSubSet(punchPosition));
	    props.append("punchType", $punchType, punchFuntionType(), EnumSubSet(punchType));
	}
	
	//numero de puertas
	props.append("countDoors", $countDoors, countFuntionDoors(), EnumSubSet(countDoors));
	//posicion del troquelado
	//if (!(punchFuntionPosition.none)) {
	
	/*if (tipofuncionSuperficie() != 1) {
	    props.append("punchPosition", $punchPosition, punchFuntionPosition(), EnumSubSet(punchPosition));
	    props.append("punchType", $punchType, punchFuntionType(), EnumSubSet(punchType));
	}
	*/


	////EStas son cerraduras
	if (tipofuncionSuperficie()== 1 or tipofuncionSuperficie()== 2) {
	    //constructor(Enum e, Object[] m=null
	    //EnumSubSet(modulacionTipoCerradurasMadera, ["N"]))
	    props.append("modulacionTipoCerradurasMadera", $modulacionTipoCerradurasMadera, modulacionFuncionCerradurasMadera(), EnumSubSet(modulacionTipoCerradurasMadera));//lockable=false
	    //animationProperties.finalize(["modulacionTipoCerradurasMadera"], modulacionFuncionCerradurasMadera().timberlineCB280);
	    //initValue=modulacionFuncionCerradurasMadera().timberlineCB280
	} else if (!(tipofuncionSuperficie()== 3)) {
	    props.append("modulacionTipoCerraduras", $modulacionTipoCerraduras, modulacionFuncionCerraduras(), EnumSubSet(modulacionTipoCerraduras));
	}
        
	if (tipofuncionSuperficie()== 1 or tipofuncionSuperficie()== 2) {
	    if (!modulacionFuncionCerradurasMadera.nueve) {
		//props.append("modulacionVigasCostados", $modulacionVigasCostados, modulacionFuncionVigasCostados(), EnumSubSet(modulacionVigasCostados));
		props.append("manijasMadera", $manijasMadera, manijasFuncionMadera(), EnumSubSet(manijasMadera));
	    }

	} else {
	    if ((tipofuncionSuperficie() == 0) and !modulacionFuncionCerraduras.nueve  ) {
		props.append("modulacionVigasCostados", $modulacionVigasCostados, modulacionFuncionVigasCostados(), EnumSubSet(modulacionVigasCostados));
	    } else {
		if ((tipofuncionSuperficie() == 3)) {
		    props.append("modulacionVigasCostados", $modulacionVigasCostados, modulacionFuncionVigasCostados(), EnumSubSet(modulacionVigasCostados));
		}
		//props.append("modulacionVigasCostados", $modulacionVigasCostados, modulacionFuncionVigasCostados(), EnumSubSet(modulacionVigasCostados));
	    }
	}
		
	props.append("zocalo", $zocalo, zocaloLockerFuncion(), EnumSubSet(zocalo));

	props.append("visor", $visor, visorFuncion(), EnumSubSet(visor));

	props.append("special", $special, isSpecial, BoolSubSet());

	//props.append("calibre", $calibre, calibre, BoolSubSet());

	props.append("entrepano", $entrepano, entrepano, BoolSubSet());

	//props.append("orientacionTextura", $orientacionTextura, orientacionTexturaFuncion(), EnumSubSet(orientacionTextura));



	return true;
    }
    
    
    /**
     * Property 'key' has changed to 'value'.
     */
    // Elegir que cosas le agregas
    // Aqui se pueden observar si se presiono las  condiciones de entrada, como parametros o ( checkbox )
    public bool quickPropertyChanged(QuickProperties props, str key, Object value, bool testChangeOnly) {

	//pln("la llave: " # key);
	if (!testChangeOnly) {
	    //pln("entro supercor key: " # key);
	    //pln("testChangeOnly: " # testChangeOnly);
	    if (key == "supercor") {
		//pln("value: " # value);
		if (value as Bool) {
		    thicknessChangedCheck(value.v, false);
		    for (ws in this.allConnected) {
			if (ws as TekRectSurface) {
			    ws.thicknessChangedCheck(value.v, false);
			}
		    }
		    invalidate;
		}
	    }
	    
	    if (key == "calibre") {
		//pln("entro propiedas es: " # !testChangeOnly);
		if (value as Bool) {
		    calibre = value.v;
		    for (ws in this.allConnected) {
			if (ws as TekRectSurface) {
			    ws.calibre = value.v;
			    ws.invalidate3D;
			}
		    }
		    invalidate3D;
		}
	    }

	     if (key == "entrepano") {
		//pln("entro propiedas es: " # !testChangeOnly);
		if (value as Bool) {
		    entrepano = value.v;
		    for (ws in this.allConnected) {
			if (ws as TekRectSurface) {
			    ws.entrepano= value.v;
			    ws.invalidate3D;
			}
		    }
		    invalidate3D;
		}
	    }


	    if (key == "special") {
		//pln("entro propiedas es: " # !testChangeOnly);
		if (value as Bool) {
		    isSpecial = value.v;
		    for (ws in this.allConnected) {
			if (ws as TekRectSurface) {
			    ws.isSpecial = value.v;
			    ws.invalidate3D;
			}
		    }
		    invalidate3D;
		}
	    }
	   
	    /*
	    if (key == "tipoSuperficie") {
		quickModify(this) {
		    if (value as TipoSuperficie) {
			if (value.v != tipofuncionSuperficie) {
			    _lastProdStyle = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
		}
	    */

	    if (key == "tipoSuperficie") {
		quickModify(this) {
		    if (value as TipoSuperficie) {
			//pln("value: " # value);
			if (value.v != tipofuncionSuperficie) {
			    _lastProdStyle = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
			bool formica=false ;
 
			
			if (tipofuncionSuperficie() == 1) {
			    //pln("formica de 30");
			    formica=true;
			} else if (tipofuncionSuperficie() == 2) {
			    //pln("formica de 25");
			    formica=false;
			} else {
			    //pln("melamina");
			    formica=false;
			}
 
			thicknessChangedCheck(formica, false);
			for (ws in this.allConnected) {
			    if (ws as TekRectSurfaceDouble) {
				ws.thicknessChangedCheck(formica, false);
			    }
			}
			invalidate;
		    }
		}
	    }


	    if (key == "punchPosition") {
		quickModify(this) {
		    if (value as PunchPosition) {
			if (value.v != punchFuntionPosition) {
			    _punchPosition = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "countDoors") {
		quickModify(this) {
		    if (value as CountDoors) {
			if (value.v != countFuntionDoors) {
			    _countDoors = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "punchType") {
		quickModify(this) {
		    if (value as PunchType) {
			if (value.v != punchFuntionType) {
			    _punchType = value.v;
			}

		    }
		}
	    }
	    if (key == "alturaLocker") {
		quickModify(this) {
		    if (value as AlturaLocker) {
			if (value.v != alturaLockerFuncion) {
			    _alturaLockerVariable = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "orientacionTextura") {
		quickModify(this) {
		    if (value as OrientacionTextura) {
			if (value.v != orientacionTexturaFuncion) {
			    _orientacionTexturaVariable = value.v;
			    
			}
		    }
		}
	    }
	    if (key == "modulacionVigasCostados") {
		quickModify(this) {
		    if (value as ModulacionVigasCostados) {
			if (value.v != modulacionFuncionVigasCostados) {
			    _modulacionVigasCostadosVariable = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "manijasMadera") {
		quickModify(this) {
		    if (value as ManijasMadera) {
			if (value.v != manijasFuncionMadera) {
			    _manijasMaderaVariable = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "modulacionTipoCerraduras") {
		quickModify(this) {
		    if (value as ModulacionTipoCerraduras) {
			if (value.v != modulacionFuncionCerraduras) {
			    _modulacionCerraduraVariable = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "modulacionTipoCerradurasMadera") {
		quickModify(this) {
		    if (value as ModulacionTipoCerradurasMadera) {
			if (value.v != modulacionFuncionCerradurasMadera) {
			    _modulacionCerraduraVariableMadera = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    if (key == "visor") {
		quickModify(this) {
		    if (value as Visor) {
			if (value.v != visorFuncion) {
			    _visorVariable = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }
	    
	    if (key == "zocalo") {
		quickModify(this) {
		    if (value as Zocalo) {
			if (value.v != zocaloLockerFuncion) {
			   _zocaloLockerVariable = value.v;
			    //invalidateQuickProperties();
			    //updateConnectors();
			    //change = true;
			}
		    }
		}
	    }


	    invalidateWorldPrice(space.world);
	}
	return super(..);
    }
  

