    /**
     
     * obtener Estilo No Dimensiones
     * MELAMINICO o FORMICA
     * AQui es para volver la superficie especial en el lookup
     */
    public str getStyleNoDimensions() {
	//pln("ingreso a la clase getStyleNoDimensions: ");
	StrBuf buf();
	MplStraightWorksurface backWs = getSurfaceOnEdge("b").MplStraightWorksurface;

	//pln("dssdgsd: " # getSurfaceOnEdge("b").MplStraightWorksurface );
	/*
	if (MplStraightWorksurface backWs = getSurfaceOnEdge("b").MplStraightWorksurface) {
	    if (this == backWs.getSurfaceOnEdge("b")) {
	        pln("tenemos espalda");
	    }
	    }
	*/

	/*if (this == backWs.getSurfaceOnEdge("b")) {
	    pln("tenemos espalda");
	    }
	*/

	double largo =  w();
	double profundidad = ls();
	//pln("largo; " # largo);
	//pln("profundidad; " # profundidad);

	if (isSpecial) {
	    //pln("ahora tenemos especiales superficies");
	    if (largo<=1.0) {
		buf << "100";
	    } else if ( largo > 1.0 and largo<=1.2) {
		buf << "120";
	    } else if ( largo > 1.2 and largo<=1.5) {
		buf << "150";
	    } else if ( largo > 1.5) {
		buf << "180"; //este no existe, solo lo agrego como una forma de observar
	    }
	    if (backWs) {
                 if ( profundidad <= 0.5) {
                     buf << "100";
                 } else if ( profundidad >0.5 and profundidad<= 0.6) {
                     buf << "120";
                 } else if ( profundidad >0.6 and profundidad<= 0.75) {
                     buf << "150";
                 }
            } else {
                 if ( profundidad <= 0.6) {
                     buf << "060";
                 } else if ( profundidad >0.6 and profundidad<= 0.75) {
                     buf << "075";
                 } else if ( profundidad >0.75 and profundidad<= 1.0) {
                     buf << "100Senc";
                 }
            }
	   

	} else {
	    //buf <<? super();
	    if (largo<=1.0) {
                buf << "100";
            } else if ( largo > 1.0 and largo<=1.2) {
                buf << "120";
            } else if ( largo > 1.2 and largo<=1.5) {
                buf << "150";
            }
            if (backWs) {
                 if ( profundidad <= 0.5) {
                     buf << "100";
                 } else if ( profundidad >0.5 and profundidad<= 0.6) {
                     buf << "120";
                 } else if ( profundidad >0.6 and profundidad<= 0.75) {
                     buf << "150";
                 }
            } else {
                 if ( profundidad <= 0.6) {
                     buf << "060";
                 } else if ( profundidad >0.6 and profundidad<= 0.75) {
                     buf << "075";
                 } else if ( profundidad >0.75 and profundidad<= 1.0) {
                     buf << "100Senc";
                 }
            }
	}


	
	//pln("tamaño ls" #  mplCMToSThreeDigit(ls));

	//pln("Aqui me entrega los datos: " # buf);
	buf << "RECT";

	/*

	if (findUnneededSupports.any or isTekGerencial()) {
	    //pln("ingreso a la parte de credenza");
	    buf << "CRED";
	} else {
	    if (?TekSurfaceSettings settings = productLineSettings) {
		if (settings.formica) buf << "3";
		else buf << "2";
	    }
	    }*/

	if (?TekSurfaceSettings settings = productLineSettings) {
	    if (settings.formica) {
		buf << "3";
	    }  else {
		buf << "2";
	    }
	}

	// Volver aqui
	//pln("buf.toS(): " # buf.toS());
	return buf.toS();
    }


