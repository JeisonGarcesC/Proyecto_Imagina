     extend public Primitive3D kitNaveFormicaMelamina3DTriple(FetchEnv3D env) {

	 double ancho = w ;

	 double moverACentro=(w/3) + 0.6mm;
	 double moverAFinal=(w/1.5) + 1.3mm;

	 

	 //naves
	 double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
