    public void build2D() {
 

 
	GInstance gs((0, ls, h - 16mm ));
        
        
	gs << GRect(rect((0, 0), (w, -ls)), fillColor=gray);//blackDotLineType ESTA ES EL CUERPO O CORAZA
        //pln("que es .... " #  localBound.rect);

	if (tipofuncionSuperficie() == 3) {
	    gs << kitNaveEmbebida2D();
	} else {
	    gs << kitNave2D();
	}
       
	
	gs << tabique2D();
	gs << costado2D();
	gs << cost2D();
        
	//gs << get2D(this);
        graph = GInstance([gs]);
 
    }
   
    extend public GInstance kitNave2D() {
	GInstance kitNave2D();
	
	kitNave2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	
	kitNave2D.move((0, -ls-2cm-2mm , 0));//
	return kitNave2D;
    }

    extend public GInstance kitNaveEmbebida2D() {
	GInstance kitNaveEmbebida2D();
	double thickness = 16mm ;
	double luzNave = 2mm ;
	double costado = 16mm ;
	double ancho = w ;
	double prof = ls ;
	
	kitNaveEmbebida2D << GRect(rect(((costado + luzNave), 0mm), (w-((costado + luzNave)), thickness)), lineType=LineType(black, lineStyle.dot));
	kitNaveEmbebida2D.setRefinement(24);
	
	kitNaveEmbebida2D.move((0, -ls , 0));//
	return kitNaveEmbebida2D;
    }

    extend public GInstance costado2D() {
	GInstance costado2D();
	double thickness = 16mm ;
	double luzNave = 2mm ;
	double costado = 16mm ;
	double ancho = w ;
	double prof = ls ;
	
	costado2D << GRect(rect((0mm, 0mm), (thickness , prof)), lineType=LineType(black, lineStyle.dot));
	costado2D.setRefinement(24);
	
	costado2D.move((0, -ls , 0));//
	return costado2D;
    }

    extend public GInstance cost2D() {
	GInstance cost2D();
	double thickness = 16mm ;
	double luzNave = 2mm ;
	double costado = 16mm ;
	double ancho = w ;
	double prof = ls ;
	
	cost2D << GRect(rect((0mm, 0mm), (thickness , prof)), lineType=LineType(black, lineStyle.dot));
	cost2D.setRefinement(24);
	
	cost2D.move((w - thickness, -ls , 0));//
	return cost2D;
    }


    extend public GInstance tabique2D() {
	GInstance tabique2D();
	
	return null;
    }


    /**
      * Gets the 2D for the grommet
      */
    extend public Graph getSuperficie() {
	
	LineType lineType(color(0, 200, 0), lineStyle.solid);

	GRect r( rect(((w/2)-256mm, -0.001m), ((w/2)+256mm, -0.117m)), veryThickGrayLineType);
	//r.lineType = lineType(color(0, 0, 0), lineStyle.dot);

	if (getSurfaceOnEdge(cTekWSEdgeIdBack) != null) {
	    GRect r( rect(((w/2)-256mm, -0.001m), ((w/2)+256mm, -0.117m)), veryThickGrayLineType);
	    //r.lineType = lineType(color(0, 0, 0), lineStyle.dot);
	    return r;
	} else {
	    GRect r( rect(((w/2)-256mm, -0.022m), ((w/2)+256mm, -0.138m)), veryThickGrayLineType);
	    //r.lineType = lineType(color(0, 0, 0), lineStyle.dot);
	    return r;
	}
	

	return r;
    }


