		     * roob 03-01-2024
		     *******************************************************/
		    
		    if (owner.modulacionFuncionCerradurasMadera.nueve) {

			buf << " - " <<  "no lleva perforacion manija "  ;
			return buf.toS;
					
		    } else {

			if (owner.manijasFuncionMadera.dos) {
			    //pln("entro aqui");
