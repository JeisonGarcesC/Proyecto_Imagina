    /**
     * Adjust to animationProperties.
     * Ajuste a las propiedades de animación.
     */
    public void adjustToAnimationProperties(AnimationProperties aps) {
	super(..);

	//pln("Ingreso a la animacion: " # aps);
	if (AnimationProperty ap = aps.property("supercor")) {
	    
	    if (?Bool b = ap.value) {
		thicknessChangedCheck(b.v, true);
	    }
	    
	    //thicknessChangedCheck(true, true);
	    //pln("prueba 1");
	}
	if (AnimationProperty ap = aps.property("wired")) {
	    if (?Bool b = ap.value) {
		wiredChanged(b.v, true);
	    }
	    //pln("Prueba 2");
	}
    }

    //cableado cambiado
    extend public void wiredChanged(bool newVal, bool duringAnimation) {
	//pln("ingreso a wiredChanged: " # newVal # " " # duringAnimation);
	//OJO con esto , nada que descubro porque se acciona
	if (productLineSettings as TekSurfaceSettings) {
	    if (productLineSettings.wired != newVal) {
		productLineSettings.wired = newVal;
		_wiredDuct = productLineSettings.wired;
		if (!duringAnimation) {
		    mainSpace.world.invalidateWorldPrice();
		} else {
		    _lastWiredDuct = newVal;
		}
		invalidate();
		build2D();
	    }
	}
    }



    /**
     * Thickness changed.
     * El grosor cambió.
     */

    //Verifica los Cambios de espesor de la parte superior de la mesa el parametro (checkbox) que dice 30mm
    // Esta funcion la usa quickPropertyChanged y adjustToAnimationProperties
    extend public void thicknessChangedCheck(bool newVal,
					     bool duringAnimation) {
	//pln("newVal visualizar: " # newVal # duringAnimation);
	//
	if (productLineSettings as TekSurfaceSettings) {
	    if (productLineSettings.formica != newVal) {
		productLineSettings.formica = newVal;
		_formica = productLineSettings.formica;
		//recordar que el grosor permitido lo trae de TekSurfaceSettings 3cm->0.03mm o 2.5cm->0.025
		thickness = productLineSettings.thickness();
		setMaterial(productLineSettings.defaultSurfaceMaterial());
		setEdgeMaterial(productLineSettings.defaultEdgeMaterial());
		if (!isWoodSurface) {
		    if (edge as MplTermofundidoEdge) {
		        edge.setHeight(thickness);
			//pln("entro: " # thickness);
		    }
		}
		buildPath(force=true);
		invalidate();
		if (!duringAnimation) {
		    mainSpace.world.invalidateWorldPrice();
		} else {
		    _lastFormica = newVal;
		}
	    }
	}
    }

    /**
     * Sycronize the infeed on the ducts
     * Sincronizar la alimentación en los conductos
     * Aqui se visualiza que opcion de Ducts queremos elegir. 
     */

    extend public void syncFloorDuct(bool isWiredDuct,
				     bool isDoubleWired,
				     bool isTBoxWiredDuct,
				     str key) {
	//pln("ingreso a syncFloorDuct: " # isWiredDuct # " " # isDoubleWired # " " # isTBoxWiredDuct # " " # key);
	wiredFloorDuct = isWiredDuct;
	wired2ConnFloorDuct = isDoubleWired;
	wiredTConnFloorDuct = isTBoxWiredDuct;

	if (wiredFloorDuct or wiredTConnFloorDuct) {
	    infeedDuct = 1;
	} else if (wired2ConnFloorDuct) {
	    infeedDuct = 2;
	}


	if (?Bool prop = getProp(key)) {
	    if (prop.v == false) infeedDuct = 0;
	}
    }
    


