    public GInstance kitNave2D() {
	GInstance kitNave2D();
	//kitNave2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)));
	kitNave2D << GRect(rect((2mm, 2mm), ((w/3)-2mm, 18mm)), fillColor=gray);
	kitNave2D << GRect(rect(((w/3)+2mm, 2mm), (w-(w/3)-2mm, 18mm)), fillColor=gray);
	kitNave2D << GRect(rect((w-(w/3)+2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	
	//kitNave2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	kitNave2D.move((0, -ls-2cm-2mm , 0));//
	return kitNave2D;
    }
 
    public GInstance tabique2D() {
	GInstance tabique2D();
	LineType lineType(color(50, 50, 50), lineStyle.thick);
	color fillColor = black;// whiteWiredDuct ? white : black;
	tabique2D << GRect(rect(((w/3)-16mm, 23mm), ((w/3)+16mm, ls+20mm)), lineType=LineType(black, lineStyle.dot));
	tabique2D << GRect(rect((w-(w/3)-16mm, 23mm), (w-(w/3)+16mm, ls+20mm)), lineType=LineType(black, lineStyle.dot));
	// Tambien para Lineas punteadas. visibleDotLineType(black) 
	//tabique2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	tabique2D.move((0, -ls-2cm-2mm , 0));//
	//return kitNave2D;
	return tabique2D;


	//return null;
    }

    public GInstance kitNaveEmbebida2D() {
	GInstance kitNaveEmbebida2D();
	double thickness = 16mm ;
	double luzNave = 2mm ;
	double costado = 16mm ;
	double tabique = 32mm ;
	double ancho = (w - (luzNave*6) - (tabique*2) - (costado*2)) / 3 ;
	double prof = ls ;
	
	
	kitNaveEmbebida2D << GRect(rect(((costado + luzNave), 0mm), ((costado + luzNave + ancho), thickness)), lineType=LineType(black, lineStyle.dot));
	kitNaveEmbebida2D << GRect(rect(((costado + ((luzNave)*3) + tabique + ancho) , 0mm), (((costado + ((luzNave)*3) + tabique + (ancho*2)), thickness))), lineType=LineType(black, lineStyle.dot));
	kitNaveEmbebida2D << GRect(rect(((costado + ((luzNave)*5) + (tabique*2) + (ancho*2)) , 0mm), ((w - costado - luzNave), thickness )), lineType=LineType(black, lineStyle.dot));
	//kitNaveEmbebida2D << GRect(rect((((w+(tabique + (luzNave*4)))/3) , 0mm), (((((w+(tabique + (luzNave*4)))/3))*2, thickness))), lineType=LineType(black, lineStyle.dot));
	//kitNaveEmbebida2D << GRect(rect((((w+(tabique + (luzNave*4)))/3) , 0mm), ((w-((costado + luzNave)), thickness))), lineType=LineType(black, lineStyle.dot));
	kitNaveEmbebida2D.setRefinement(24);
	kitNaveEmbebida2D.move((0, -ls , 0));//
	return kitNaveEmbebida2D;
    }


}


public class MplSpecialPartJeisonSpecial extends  MplSpecialPartJeison {

    /**
     * Modify the description. Provides the opportunity to add/remove text from the 
     * Product Node's description text.
     */
     public str modifyDescription(str description, Snapper owner) {

	if (owner as MplWorksurface) {
	    //pln("el owner : " # owner );
	    //$depth
	    if (owner as TekRectSurface) {
		
		
		StrBuf buf(super(description, owner));
		buf << " - " <<  $height << ": ";
		buf << centimetersS(owner.dimension("h"));
		buf << " - ";
		buf << $long << " nave "<< ": ";
		buf << centimetersS(owner.dimension("b"));
	        
		/*
		buf << $depth << ": ";
		buf << centimetersS(owner.dimension("s"));
		*/
	        /***********************************************************
		 *Nota para posicion del troquelado
		 *roob 28/12/2023
		 ***********************************************************/		
	        
		if ((owner.punchFuntionPosition.upDown) and !(owner.tipofuncionSuperficie.formica25 or owner.tipofuncionSuperficie.melamina15)) {
		    buf << " - " <<  "troquelados : " << $punchPosition.upDown ;

		} else if (owner.punchFuntionPosition.up and !(owner.tipofuncionSuperficie.formica25 or owner.tipofuncionSuperficie.melamina15)) {
		    buf << " - " <<  "troquelados : " << $punchPosition.up ;
		} else if (owner.punchFuntionPosition.down and !(owner.tipofuncionSuperficie.formica25 or owner.tipofuncionSuperficie.melamina15)) {
		    buf << " - " <<  "troquelados : " << $punchPosition.down ;
		} else {
		    if (!(owner.tipofuncionSuperficie == 1 or owner.tipofuncionSuperficie == 2 )) {
			buf << " - " <<  "nave : " << $punchPosition.none ;
		    }
		    
		}
		/***********************************************************
		 * Si es nave madera (tipoFuncionSuperficie 1 o 2) retorna la nota
		 * sino continua escribiendo el tipo de troquelado
		 * utiliza la lista enum de...
		 * 
		 * private enum modulacionTipoCerradurasMadera : field access {
		 * modulacionFuncionCerradurasMadera     
                  nueve; //cerradura clave 4 digitos
                  diez; // cerradura amstrong
                  timberlineCB280;
                  ninguno;
                  }
		 ***********************************************************/
		
		if ((owner.tipofuncionSuperficie == 1 or owner.tipofuncionSuperficie == 2 ) and (owner.modulacionFuncionCerraduras >= 0)) {
		    //pln("entro aqui nave melaminica");
		    if (owner.modulacionFuncionCerradurasMadera.nueve) {
			//pln("entro aqui nave melaminica 2 ");
			buf << " - " <<  "perforacion  " << $modulacionTipoCerradurasMadera.nueve ;
			
		    } else if (owner.modulacionFuncionCerradurasMadera.diez or owner.modulacionFuncionCerradurasMadera.timberlineCB280 ) {
			buf << " - " <<  "perforacion para cerradura "  ;
			
		    } else {
			//pln("entro aqui 2");
		    }
		    /*******************************************************
		     * si el kit nave tiene cerradura con clave de 4 digitos 
		     * no se escribe la nota de la manija
		     * roob 03-01-2024
		     *******************************************************/
		    
		    if (owner.modulacionFuncionCerradurasMadera.nueve) {

			buf << " - " <<  "no lleva perforacion manija "  ;
			return buf.toS;
					
		    } else {

			if (owner.manijasFuncionMadera.dos) {
			    //pln("entro aqui");
			    buf << " - " <<  "perforacion manija " << $manijasMadera.dos ;
			    //return buf.toS;
			} else if (owner.manijasFuncionMadera.uno) {
			    buf << " - " <<  "perforacion " << $manijasMadera.uno ;
			    
			} else if (owner.manijasFuncionMadera.cinco) {
			    buf << " - " <<  "perforacion manija " << $manijasMadera.cinco ;
			
			} else if (owner.manijasFuncionMadera.siete) {
			    buf << " - " <<  "perforacion manija " << $manijasMadera.siete ;
			
			} else {
			    buf << " - " <<  "no lleva perforacion manija ";
			    //pln("entro aqui 2");
			}
		    }

		    return buf.toS;
		} else {
		    /*******************************************************
		     * si salta a este else 
		     * evalua si la nave es metalica o metalica embebida
		     * tambien evalua si tiene troquelados 
		     * si no tiene devuelve nave lisa
		     * roob : 02-01-2024
		     *******************************************************/
		    
		    
		    if ((owner.tipofuncionSuperficie == 0 or owner.tipofuncionSuperficie == 3 ) and (owner.punchFuntionPosition.none) and !(owner.modulacionFuncionCerraduras >= 0)) {
			return buf.toS;
		    } else if ((owner.punchFuntionType >= 0 and owner.punchFuntionType <= 4) and !(owner.punchFuntionPosition.none)) {
			/***************************************************
			 * este if evalua el tipo de punzonado
			 * roob : 02-01-2024
			 ***************************************************/
			
			if ((owner.punchFuntionType.tipo2)) {
			    buf << " - " << $punchType.tipo2 ;

			} else if (owner.punchFuntionType.tipo3) {
			    buf << " - " << $punchType.tipo3 ;

			} else if (owner.punchFuntionType.tipo4) {
			    buf << " - " << $punchType.tipo4 ;

			} else if (owner.punchFuntionType.tipo1) {
			    buf << " - " << $punchType.tipo1 ;

			} else if (owner.punchFuntionPosition.none) {
			    //pln("entro aqui sin troquelados");
			    //buf << " - " << $punchType.tipo1 ;
			}
			
			/***************************************************
			 * este if evalua el tipo de cerradura
			 * roob : 02-01-2024
			 ***************************************************/
			
			if (owner.modulacionFuncionCerraduras.ocho) {
			    //pln("entro aqui");
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;
			    //return buf.toS;
			} else if (owner.tipofuncionSuperficie == 3) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;

			} else if (owner.modulacionFuncionCerraduras.nueve) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.nueve ;

			} else if (owner.modulacionFuncionCerraduras.diez or owner.modulacionFuncionCerraduras.timberlineCB280 ) {
			    buf << " - " <<  "perforacion para cerradura "  ;

			} else {
			    //pln("entro aqui 2");
			}
			/***************************************************
			 * este if evalua el tipo de manijas 
			 * si lleva cerradura con clave , no escribe la nota de las manijas
			 * roob : 02-01-2024
			 ***************************************************/
			if (owner.modulacionFuncionCerraduras.nueve and !(owner.tipofuncionSuperficie == 3)) {
			    buf << " - " <<  "no lleva perforacion manija "  ;
			    return buf.toS;
			} else {
			    if (owner.modulacionFuncionVigasCostados.seis) {
				//pln("entro aqui");
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.seis ;
				//return buf.toS;
			    } else if (owner.modulacionFuncionVigasCostados.uno) {
				buf << " - " <<  "perforacion " << $modulacionVigasCostados.uno ;

			    } else if (owner.modulacionFuncionVigasCostados.tres) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.tres ;

			    } else if (owner.modulacionFuncionVigasCostados.cuatro) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.cuatro ;

			    } else {
				buf << " - " <<  "no lleva perforacion manija ";
				//pln("entro aqui 2");
			    }
			}
		    } else {

			/***************************************************
			 * si las naves son lisas 
			 * salta a escribir estas notas
			 * roob : 02-01-2024
			 ***************************************************/
			
			
			if (owner.modulacionFuncionCerraduras.ocho) {
			    //pln("entro aqui");
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;
			    //return buf.toS;
			} else if (owner.tipofuncionSuperficie == 3) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;

			} else if (owner.modulacionFuncionCerraduras.nueve) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.nueve ;

			} else if (owner.modulacionFuncionCerraduras.diez or owner.modulacionFuncionCerraduras.timberlineCB280 ) {
			    buf << " - " <<  "perforacion para cerradura "  ;

			} else {
			    //pln("entro aqui 2");
			}

			if (owner.modulacionFuncionCerraduras.nueve and !(owner.tipofuncionSuperficie == 3)) {
			    buf << " - " <<  "no lleva perforacion manija "  ;
			    return buf.toS;
			} else {
			    if (owner.modulacionFuncionVigasCostados.seis) {
				//pln("entro aqui");
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.seis ;
				//return buf.toS;
			    } else if (owner.modulacionFuncionVigasCostados.uno) {
				buf << " - " <<  "perforacion " << $modulacionVigasCostados.uno ;

			    } else if (owner.modulacionFuncionVigasCostados.tres) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.tres ;
				
			    } else if (owner.modulacionFuncionVigasCostados.cuatro) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.cuatro ;
				
			    } else {
				buf << " - " <<  "no lleva perforacion manija ";
				//pln("entro aqui 2");
			    }
			}

		    }


		}
		

		return buf.toS;
		
	    }
	}

	return super(description, owner);
    }
    
}

public class MplSpecialPartJeisonSpecialNaveDoble extends  MplSpecialPartJeison {

    /**
     * Modify the description. Provides the opportunity to add/remove text from the 
     * Product Node's description text.
     */
     public str modifyDescription(str description, Snapper owner) {

	if (owner as MplWorksurface) {
	    //pln("el owner : " # owner );
	    //$depth
	    if (owner as TekRectSurfaceDouble) {
		
		
		StrBuf buf(super(description, owner));
		buf << " - " <<  $height << ": ";
		buf << centimetersS(owner.dimension("h"));
		buf << " - ";
		buf << $long << " nave "<< ": ";
		buf << centimetersS(owner.dimension("b") / 2);
	        
		/*
		buf << $depth << ": ";
		buf << centimetersS(owner.dimension("s"));
		*/
	        /***********************************************************
		 *Nota para posicion del troquelado
		 *roob 28/12/2023
		 ***********************************************************/		
	        
		if ((owner.punchFuntionPosition.upDown) and !(owner.tipofuncionSuperficie.formica25 or owner.tipofuncionSuperficie.melamina15)) {
		    buf << " - " <<  "troquelados : " << $punchPosition.upDown ;

		} else if (owner.punchFuntionPosition.up and !(owner.tipofuncionSuperficie.formica25 or owner.tipofuncionSuperficie.melamina15)) {
		    buf << " - " <<  "troquelados : " << $punchPosition.up ;
		} else if (owner.punchFuntionPosition.down and !(owner.tipofuncionSuperficie.formica25 or owner.tipofuncionSuperficie.melamina15)) {
		    buf << " - " <<  "troquelados : " << $punchPosition.down ;
		} else {
		    if (!(owner.tipofuncionSuperficie == 1 or owner.tipofuncionSuperficie == 2 )) {
			buf << " - " <<  "nave : " << $punchPosition.none ;
		    }
		    
		}
		/***********************************************************
		 * Si es nave madera (tipoFuncionSuperficie 1 o 2) retorna la nota
		 * sino continua escribiendo el tipo de troquelado
		 * utiliza la lista enum de...
		 * 
		 * private enum modulacionTipoCerradurasMadera : field access {
		 * modulacionFuncionCerradurasMadera     
                  nueve; //cerradura clave 4 digitos
                  diez; // cerradura amstrong
                  timberlineCB280;
                  ninguno;
                  }
		 ***********************************************************/
		
		if ((owner.tipofuncionSuperficie == 1 or owner.tipofuncionSuperficie == 2 ) and (owner.modulacionFuncionCerraduras >= 0)) {
		    //pln("entro aqui nave melaminica");
		    if (owner.modulacionFuncionCerradurasMadera.nueve) {
			//pln("entro aqui nave melaminica 2 ");
			buf << " - " <<  "perforacion  " << $modulacionTipoCerradurasMadera.nueve ;
			
		    } else if (owner.modulacionFuncionCerradurasMadera.diez or owner.modulacionFuncionCerradurasMadera.timberlineCB280 ) {
			buf << " - " <<  "perforacion para cerradura "  ;
			
		    } else {
			//pln("entro aqui 2");
		    }
		    /*******************************************************
		     * si el kit nave tiene cerradura con clave de 4 digitos 
		     * no se escribe la nota de la manija
		     * roob 03-01-2024
		     *******************************************************/
		    
		    if (owner.modulacionFuncionCerradurasMadera.nueve) {

			buf << " - " <<  "no lleva perforacion manija "  ;
			return buf.toS;
					
		    } else {

			if (owner.manijasFuncionMadera.dos) {
			    //pln("entro aqui");
			    buf << " - " <<  "perforacion manija " << $manijasMadera.dos ;
			    //return buf.toS;
			} else if (owner.manijasFuncionMadera.uno) {
			    buf << " - " <<  "perforacion " << $manijasMadera.uno ;
			    
			} else if (owner.manijasFuncionMadera.cinco) {
			    buf << " - " <<  "perforacion manija " << $manijasMadera.cinco ;
			
			} else if (owner.manijasFuncionMadera.siete) {
			    buf << " - " <<  "perforacion manija " << $manijasMadera.siete ;
			
			} else {
			    buf << " - " <<  "no lleva perforacion manija ";
			    //pln("entro aqui 2");
			}
		    }

		    return buf.toS;
		} else {
		    /*******************************************************
		     * si salta a este else 
		     * evalua si la nave es metalica o metalica embebida
		     * tambien evalua si tiene troquelados 
		     * si no tiene devuelve nave lisa
		     * roob : 02-01-2024
		     *******************************************************/
		    
		    
		    if ((owner.tipofuncionSuperficie == 0 or owner.tipofuncionSuperficie == 3 ) and (owner.punchFuntionPosition.none) and !(owner.modulacionFuncionCerraduras >= 0)) {
			return buf.toS;
		    } else if ((owner.punchFuntionType >= 0 and owner.punchFuntionType <= 4) and !(owner.punchFuntionPosition.none)) {
			/***************************************************
			 * este if evalua el tipo de punzonado
			 * roob : 02-01-2024
			 ***************************************************/
			
			if ((owner.punchFuntionType.tipo2)) {
			    buf << " - " << $punchType.tipo2 ;

			} else if (owner.punchFuntionType.tipo3) {
			    buf << " - " << $punchType.tipo3 ;

			} else if (owner.punchFuntionType.tipo4) {
			    buf << " - " << $punchType.tipo4 ;

			} else if (owner.punchFuntionType.tipo1) {
			    buf << " - " << $punchType.tipo1 ;

			} else if (owner.punchFuntionPosition.none) {
			    //pln("entro aqui sin troquelados");
			    //buf << " - " << $punchType.tipo1 ;
			}
			
			/***************************************************
			 * este if evalua el tipo de cerradura
			 * roob : 02-01-2024
			 ***************************************************/
			
			if (owner.modulacionFuncionCerraduras.ocho) {
			    //pln("entro aqui");
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;
			    //return buf.toS;
			} else if (owner.tipofuncionSuperficie == 3) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;

			} else if (owner.modulacionFuncionCerraduras.nueve) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.nueve ;

			} else if (owner.modulacionFuncionCerraduras.diez or owner.modulacionFuncionCerraduras.timberlineCB280 ) {
			    buf << " - " <<  "perforacion para cerradura "  ;

			} else {
			    //pln("entro aqui 2");
			}
			/***************************************************
			 * este if evalua el tipo de manijas 
			 * si lleva cerradura con clave , no escribe la nota de las manijas
			 * roob : 02-01-2024
			 ***************************************************/
			if (owner.modulacionFuncionCerraduras.nueve and !(owner.tipofuncionSuperficie == 3)) {
			    buf << " - " <<  "no lleva perforacion manija "  ;
			    return buf.toS;
			} else {
			    if (owner.modulacionFuncionVigasCostados.seis) {
				//pln("entro aqui");
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.seis ;
				//return buf.toS;
			    } else if (owner.modulacionFuncionVigasCostados.uno) {
				buf << " - " <<  "perforacion " << $modulacionVigasCostados.uno ;

			    } else if (owner.modulacionFuncionVigasCostados.tres) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.tres ;

			    } else if (owner.modulacionFuncionVigasCostados.cuatro) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.cuatro ;

			    } else {
				buf << " - " <<  "no lleva perforacion manija ";
				//pln("entro aqui 2");
			    }
			}
		    } else {

			/***************************************************
			 * si las naves son lisas 
			 * salta a escribir estas notas
			 * roob : 02-01-2024
			 ***************************************************/
			
			
			if (owner.modulacionFuncionCerraduras.ocho) {
			    //pln("entro aqui");
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;
			    //return buf.toS;
			} else if (owner.tipofuncionSuperficie == 3) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.ocho ;

			} else if (owner.modulacionFuncionCerraduras.nueve) {
			    buf << " - " <<  "perforacion  " << $modulacionTipoCerraduras.nueve ;

			} else if (owner.modulacionFuncionCerraduras.diez or owner.modulacionFuncionCerraduras.timberlineCB280 ) {
			    buf << " - " <<  "perforacion para cerradura "  ;

			} else {
			    //pln("entro aqui 2");
			}

			if (owner.modulacionFuncionCerraduras.nueve and !(owner.tipofuncionSuperficie == 3)) {
			    buf << " - " <<  "no lleva perforacion manija "  ;
			    return buf.toS;
			} else {
			    if (owner.modulacionFuncionVigasCostados.seis) {
				//pln("entro aqui");
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.seis ;
				//return buf.toS;
			    } else if (owner.modulacionFuncionVigasCostados.uno) {
				buf << " - " <<  "perforacion " << $modulacionVigasCostados.uno ;

			    } else if (owner.modulacionFuncionVigasCostados.tres) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.tres ;
				
			    } else if (owner.modulacionFuncionVigasCostados.cuatro) {
				buf << " - " <<  "perforacion manija " << $modulacionVigasCostados.cuatro ;
				
			    } else {
				buf << " - " <<  "no lleva perforacion manija ";
				//pln("entro aqui 2");
			    }
			}

		    }


		}
		

		return buf.toS;
		
	    }
	}

	return super(description, owner);
    }
    
}

