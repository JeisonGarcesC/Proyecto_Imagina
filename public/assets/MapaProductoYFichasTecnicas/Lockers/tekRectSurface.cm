    public MplPart getPartZocalo(PartsEnv env) {


	double alturaReal= h * 100;
	double altura= 0;
	if (alturaReal <=180) {
	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal=w*100;
	double ancho= 0 ;
	if (anchoReal <=80) {
	    ancho = 80;

	} else if (anchoReal >80 and anchoReal<=100) {
	    ancho = 100;

	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;

	// zocalo solo en calibre 22


	/*if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;

	    }*/





	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
        
	double cantidadVisor= 0;

	double cantidadKitNave=0;

	if (countFuntionDoors()==0) {
	    cantidadVisor= 1 * 1;
	} else if (countFuntionDoors()==1) {
	    cantidadVisor= 1 * 1;
	} else if (countFuntionDoors()==2) {
	    cantidadVisor= 1 * 1;
	} else if (countFuntionDoors()==3) {
	    cantidadVisor= 1 * 1;
	}

	StrBuf buf();
	buf << "LOCKERZOCALO" # 2 # "P_" # ancho # "_" # profundidad #  "_" # 10 # "_" # calibreReal ;


	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico() , quantity=cantidadVisor, descripcionSpecial);
	    //return PriRectWsSpecialPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(),  quantity=cantidadVisor);
	    return MplSpecialPartZocalo(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=true);
	} else {


	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	    return MplSpecialPartZocalo(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=false);

	}

	//return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	return MplSpecialPartZocalo(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=false);
	 
    }

