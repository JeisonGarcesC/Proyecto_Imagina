      /*********************************************************************
       * 14/12/2023
       * este metodo le pertenece a la clase de locker triple
       * es el primer kit nave , metodo public que modifica al original
       * 
       *********************************************************************/
      
     public Primitive3D kitNaveEmbebida(FetchEnv3D env) {
	 Primitive3D[] prims();

        


	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;


	//Loker
	double w = (w/3) - 36mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
	//kit nave
 
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
 
	//// vovelmove

	PolygonMesh3D mesh2(path, height=thickness);//altura

	mesh2.setMaterial(getSharedLegMaterial.material3D);
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((18mm , nivelador + borde + luzNave , 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));
	mesh2.move((0 , 18mm , 0));
	//mesh2.move((18mm , 0 , 10mm));

	//prims <<? manija3D(env);// groomet
        if (!modulacionFuncionCerraduras().ninguno) {
	    Primitive3D cerraduraEmbebidas= cerraduraEmbebida3D(env);
	    cerraduraEmbebidas.move((0 , 20mm , 0));
	    prims <<? cerraduraEmbebidas;
	}

	//prims <<? manija3D(env);// groomet
	if (!modulacionFuncionVigasCostados().ninguno) {
	    Primitive3D manijasEmbebidas= manija3D2(env);
	    manijasEmbebidas.move((0 , 20mm , 0));
	    prims <<? manijasEmbebidas;// groomet
	}
	
	Primitive3D respuestaVisor3D = visor3D(env);
	respuestaVisor3D.move((0, 18mm , 0));
	prims <<? respuestaVisor3D;


        

	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }



         ///// kit Nave embebido triple
     /**********************************************************************
      * 14/12/2023
      * este metodo le pertenece a la clase de locker triple
      * es el primer kit nave troquelado , metodo public que modifica al original
      **********************************************************************/
     
     public Primitive3D kitNaveTroquelEmbebida(FetchEnv3D env) {
	 Primitive3D[] prims();

        //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	//double yTrav= ls*-1;

	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = (w/3) - 36mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}


	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
        
	//PARA TROQUELES ABAJO
	// 1 troquelado
  
        APath2D path1((0mm, 1mm)); //1
	path1.lineTo((0mm, f-1mm)); //2
	path1.arcTo((1mm, f), 90deg); //3
	path1.lineTo((w-1mm, f)); //4
	path1.arcTo((w, f-1mm), 0deg); //5
	path1.lineTo((w, f-15mm)); //6
	path1.lineTo(((w/2)-125mm, f-15mm)); //7
	path1.lineTo(((w/2)-125mm, f-120mm)); //8
	path1.lineTo(((w/2)+125mm, f-120mm)); //9
	path1.lineTo(((w/2)+125mm, f-15mm)); //10
	path1.lineTo((w, f-15mm));
	path1.lineTo((w, 1mm)); //18
	path1.arcTo((w-1mm, 0mm), -90deg); //19
	path1.lineTo((1mm, 0mm)); //20
	path1.arcTo((0mm, 1mm), -180deg); //11
	
	path1.close();

	PolygonMesh3D mesh1(path1, height=thickness);//altura

	mesh1.move((18mm, luzNave, -18mm));//ejes x , z , y
	

	

	mesh1.setMaterial(getSharedLegMaterial.material3D);
 
	

	//PARA TROQUELES NAVE LOCKER DOBLE CAJA
 
	APath2D path2((0mm, 1mm)); //1
	path2.lineTo((0mm, f-1mm)); //2
	path2.arcTo((1mm, f), 90deg); //3
	path2.lineTo((w-1mm, f)); //4
	path2.arcTo((w, f-1mm), 0deg); //5
	path2.lineTo((w, f-15mm)); //6
	path2.lineTo(((w/2)-125mm, f-15mm)); //7
	path2.lineTo(((w/2)-125mm, f-120mm)); //8
	path2.lineTo(((w/2)+125mm, f-120mm)); //9
	path2.lineTo(((w/2)+125mm, f-15mm)); //10
	path2.lineTo((w, f-15mm)); //11
	path2.lineTo((w, 120mm)); //12
	path2.lineTo(((w/2)-125mm, 120mm)); //13
	path2.lineTo(((w/2)-125mm, 15mm)); //14
	path2.lineTo(((w/2)+125mm, 15mm)); //15
	path2.lineTo(((w/2)+125mm, 120mm)); //16
	path2.lineTo((w, 120mm)); //17
	path2.lineTo((w, 1mm)); //18
	path2.arcTo((w-1mm, 0mm), -90deg); //19
	path2.lineTo((1mm, 0mm)); //20
	path2.arcTo((0mm, 1mm), -180deg); //11
	
	path2.close();

	PolygonMesh3D mesh2(path2, height=thickness);//altura
	mesh2.move((18mm, luzNave, -18mm));//ejes x , z , y
        
	mesh2.setMaterial(getSharedLegMaterial.material3D);

	//PARA TROQUELES ARRIBA NAVE LOCKER 
 
	APath2D path3((0mm, 1mm)); //1
	path3.lineTo((0mm, f-1mm)); //2
	path3.arcTo((1mm, f), 90deg); //3
	path3.lineTo((w-1mm, f)); //4
	path3.arcTo((w, f-1mm), 0deg); //5
	path3.lineTo((w, 120mm)); //12
	path3.lineTo(((w/2)-125mm, 120mm)); //13
	path3.lineTo(((w/2)-125mm, 15mm)); //14
	path3.lineTo(((w/2)+125mm, 15mm)); //15
	path3.lineTo(((w/2)+125mm, 120mm)); //16
	path3.lineTo((w, 120mm)); //17
	path3.lineTo((w, 1mm)); //18
	path3.arcTo((w-1mm, 0mm), -90deg); //19
	path3.lineTo((1mm, 0mm)); //20
	path3.arcTo((0mm, 1mm), -180deg); //11
	
	path3.close();

	PolygonMesh3D mesh3(path3, height=thickness);//altura
	mesh3.move((18mm, luzNave, -18mm));//ejes x , z , y;
	mesh3.setMaterial(getSharedLegMaterial.material3D);
        
	double posicionTroquelUp = (nave1 + nivelador + borde + luzNave +8mm) -128mm;
	if (punchFuntionPosition.up) {
	    prims << mesh1;
	    mesh1.move((0, nivelador + borde, 2mm)); //nivelador + borde = 26mm
	    mesh1.rotate((0deg, 0deg, 90deg));
	    
	    Primitive3D troquelRespuesta2 = troquel(env);
	    prims << troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
		troquelRespuesta2.move((w/2-(290mm/2)+ 18mm, 0, posicionTroquelUp ));
		//troquelRespuesta2.move((w/2-(290mm/2)+ 18mm, 0, 1653mm ));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0,  posicionTroquelUp + luzNave ));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0, (posicionTroquelUp+luzNave)));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0, (posicionTroquelUp+luzNave)));
	    }
	    //troquelRespuesta2.move((3mm, 0, 0));
	    
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	} else if (punchFuntionPosition().down) {
	    prims << mesh3;
	    mesh3.move((0, nivelador + borde, 2mm));
	    mesh3.rotate((0deg, 0deg, 90deg));
	    Primitive3D troquelRespuesta = troquelDown(env);
	    prims << troquelRespuesta;
	    troquelRespuesta.move((w/2-(290mm/2)+18mm , 0 , 50mm));
	    troquelRespuesta.move((0, 0, 3mm));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	} else {
	    prims << mesh2;
	    mesh2.move((0, nivelador + borde, 2mm));
	    mesh2.rotate((0deg, 0deg, 90deg));
	     

	    /// troquel abajo 
	    Primitive3D troquelRespuesta = troquelDown(env); // ejes x y z
	    troquelRespuesta.move((w/2-(290mm/2)+16mm , 0 , 50mm));
	    troquelRespuesta.move(( 2mm, 0 , 3mm));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	    prims <<? troquelRespuesta;

	    

	    
	    Primitive3D troquelRespuesta2 = troquel(env);
	    //troquelRespuesta2.move((w/2-(290mm/2), 20mm, 0));
	    prims <<? troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
	        troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -117mm;
	        troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -117mm;
		troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -117mm;
		troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	    }
	    //troquelRespuesta2.move((30mm, 10mm, 0));
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	    //return  invisiblePrimitive3D;
	    

	}
	
	//
	//prims <<? troquelRespuesta2;

        if (!modulacionFuncionVigasCostados().ninguno) {
	    Primitive3D manijasEmbebidas= manija3D2(env);
	    manijasEmbebidas.move((0 , 20mm , 0));
	    prims <<? manijasEmbebidas;// groomet
	}

	if (!modulacionFuncionCerraduras().ninguno) {
	    Primitive3D cerraduraEmbebidas= cerraduraEmbebida3D(env);
	    cerraduraEmbebidas.move((0 , 20mm , 0));
	    prims <<? cerraduraEmbebidas;
	}

    
	Primitive3D respuestaVisor3D = visor3D(env);
	respuestaVisor3D.move((0, 18mm , 0));
	prims <<? respuestaVisor3D;
	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     
    

     ///////buil3DTriple



    public void build3D(FetchEnv3D env) {
	super(..);

	//double moverACentro=(w/3) + 0.6mm;
	//double moverAFinal=(w/1.5) + 1.3mm;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;

	
	Primitive3D[] prims();
	Primitive3D[] prims2();
	Primitive3D[] prims3();
	//prims << super(env);

	Primitive3D tabiqueRespuesta = tabique(env) ;
	tabiqueRespuesta.move((w/3-16mm, 0, 35mm));
	prims2 <<? tabiqueRespuesta;

	Primitive3D tabiqueRespuesta2 = tabique(env) ;
	tabiqueRespuesta2.move(((w/3)*2-16mm, 0, 35mm));
	prims3 <<? tabiqueRespuesta2;

	

	Primitive3D kitNaveTercera = kitNave3DTriple(env);
	kitNaveTercera.move((w/3, 0 , 0));

	Primitive3D kitNaveTerceraFormicaMelamina = kitNaveFormicaMelamina3DTriple(env);
	kitNaveTerceraFormicaMelamina.move((w/3, 0 , 0));
	


	//prims3 <<? kitNave3DTripleTroquelado(env);

	
	if (tipofuncionSuperficie()==0 ) {
	    prims2 <<? kitNave3DTriple(env);
	    prims3 <<? kitNaveTercera;
	    
	} else if (tipofuncionSuperficie()==1) {
	    //prims2 <<? kitNave3DTriple(env);
	    prims2 <<? kitNaveFormicaMelamina3DTriple(env);
	    prims3 <<? kitNaveTerceraFormicaMelamina;

	    //pln("no existe");
	    //prims <<?kitNave3D(env);
	} else if (tipofuncionSuperficie()==2) {
	    //prims2 <<? kitNave3DTriple(env);
	    prims2 <<? kitNaveFormicaMelamina3DTriple(env);
	    prims3 <<? kitNaveTerceraFormicaMelamina;
	    //pln("no existe");
	    //prims <<?kitNave3D(env);
	} else {
	    //pln("entro las embebidas");
	    prims2 <<?kitNave3DEmbebidaDoble(env);
	    prims3 <<?kitNave3DEmbebidaTriple(env);
	}


	Primitive3D kitNavesConZocalo = Instance3D(prims2);
	kitNavesConZocalo.move((0, 0, elevacionCoraza));

	Primitive3D kitNavesConZocalo2 = Instance3D(prims3);
	kitNavesConZocalo2.move((0, 0, elevacionCoraza));


	if (zocaloLockerFuncion().verdadero) {
	    model = safeInstance3D([model] + [kitNavesConZocalo] + [kitNavesConZocalo2] + prims );

	} else {
	    model = safeInstance3D([model] + prims + prims2 + prims3 );

	}
	

    }

    
    /**
     * Domain.
     */
    //Los parametro de las dimensiones de la mesa. Que tanto puede crece
    // el grommet y el tubo no se estira en lo ancho
    // la sobrecapa y las patas no se ponen si estiro largo

    public SubSet dimensionDomain(str id) {


	if (isSpecial) {
	    if (id == "b") return DoubleStepRange(90cm, 100cm, 1cm); //22-08-2023
	    if (id == "s") return DoubleStepRange(30cm, 50cm, 1cm);
	    if (id == "h") return DoubleStepRange(165cm, 220cm, 1cm);
	} else {
	    if (id == "b") return DoubleEnum(100cm);
	    if (id == "s") return DoubleEnum(50cm);
	    if (id == "h") return DoubleEnum(180cm, 220cm);

	}

	return null;
    }




    //inicia  getPartCoraza de la coraza Triple

    public MplPart getPartCoraza(PartsEnv env) {

	double alturaReal = h * 100;
	double altura= 0;
	if (alturaReal <=180) {
	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal= (w/3)*100;
	double ancho= 0;
	if (anchoReal <=100) {
	    ancho = 100;
	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
        
	double cantidadVisor= 0;

	double cantidadKitNave=0;

	if (countFuntionDoors()==0) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 1;
	} else if (countFuntionDoors()==1) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 2;
	} else if (countFuntionDoors()==2) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 3;
	} else if (countFuntionDoors()==3) {
	    cantidadVisor= 1 * 1;
	    cantidadKitNave= 4;
	}

	StrBuf buf();
	buf << "LOCKERCORAZA3P_" # ancho # "_" # profundidad # "_" # altura # "_" # calibreReal;


	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico() , quantity=cantidadVisor, descripcionSpecial);
	    //return PriRectWsSpecialPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(),  quantity=cantidadVisor);
	    return MplSpecialPartCoraza(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=true);
	} else {

	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	    return MplSpecialPartCoraza(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=false);

	}
	return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	 
    }

    public MplPart getPartManijas(PartsEnv env) {

	StrBuf buf();
	buf << "LOCKER";

        if (modulacionFuncionVigasCostados()==0) {
	    buf << "MANINCR";
	} else if (modulacionFuncionVigasCostados()==1) {
	    buf << "MANBOTALAM";
	} else if (modulacionFuncionVigasCostados()==2) {
	    buf << "MANSCHLAM";
	} else if (modulacionFuncionVigasCostados()==3) {
	    buf << "MANEMBLAM";
	} else {
	    buf << "MANINCR";
	}
	double cantidadManijas= 0;

	if (countFuntionDoors()==0) {
	    cantidadManijas= 1 * 3;
	} else if (countFuntionDoors()==1) {
	    cantidadManijas= 2 * 3;
	} else if (countFuntionDoors()==2) {
	    cantidadManijas= 3 * 3;
	} else if (countFuntionDoors()==3) {
	    cantidadManijas= 4 * 3;
	}


	//return MplPart(this, buf.toS, getOptions() , quantity=2, alturaS);
	return MplPart(this, buf.toS, quantity=cantidadManijas);
    }

