     ***********************************************************************/


    
    public MplWorksurface getRearSurface(str edgeId) {
	return getSurfaceOnEdge(cTekWSEdgeIdBack);
    }

    //obtener 120 superficie adjunta a la izquierda
    extend public Tek120DegSurface get120SurfaceAttachedLeft() {
	if (?Tek120DegSurface leftSurface = getSurfaceOnEdge(cTekWSEdgeIdLeft)) {
	    return leftSurface;
	}
	return null;
    }

    //obtener 120 superficie adjunta a la derecha
    extend public Tek120DegSurface get120SurfaceAttachedRight() {
	if (?Tek120DegSurface rightSurface = getSurfaceOnEdge(cTekWSEdgeIdRight)) {
	    return rightSurface;
	}
	return null;
    }

    //obtener Superficie Adjunta a la Izquierda
    extend public TekRectSurface getSurfaceAttachedLeft() {
	if (?TekRectSurface leftSurface = getSurfaceOnEdge(cTekWSEdgeIdLeft)) {
	    return leftSurface;
	}
	return null;
    }

    //obtener la superficie adjunta a la derecha
    extend public TekRectSurface getSurfaceAttachedRight() {
	if (?TekRectSurface rightSurface = getSurfaceOnEdge(cTekWSEdgeIdRight)) {
	    return rightSurface;
	}
	return null;
    }

    //volver a conectar la superficie o obtener si esta atras
    extend public TekRectSurface getSurfaceAttachedBack() {
	//Aqui retorna TekRectSurface((id=208, copy=146)) que es una isla de 2 meses
	// nos dice si la mesa esta conectada por la espalda
	if (?TekRectSurface backSurface = getSurfaceOnEdge(cTekWSEdgeIdBack)) {
	    //pln("backSurface: " # backSurface);
	    return backSurface;
	}
	return null;
    }

    //es superficie intermedia
    extend public bool isIntermediateSurface() {
	if (getSurfaceAttachedLeft() and getSurfaceAttachedRight()) {
	    return true;
	}
	return false;
    }


    extend public bool needsSingleDuct() {
	//usa getSurfaceAttachedBack que es el objeto mesa de 2 o isla
	if (!getSurfaceAttachedBack()) {
	    return true;
	}
	return false;
	
    }


    /***********************************************************************
     * Counting the wired surfaces
     * Contando las superficies cableadas
     ***********************************************************************/

    /**
     * Total wired surfaces
     * Superficies cableadas totales
     */
    
    extend public bool isSingle() {
	//Funcion de rodolfo 04-09-2023
	if (!getSurfaceAttachedRight() and !getSurfaceAttachedLeft()) {
	    return true;
	}
	return false;
    }

    extend public int totalWiredSurfacesAttached() {
	if (getSurfaceAttachedBack()) {
	    //pln("total de superficies cableadas" # countWiredSurfacesAttached());
	    return countWiredSurfacesAttached();
	}
	return totalLinealWiredSurfacesAttached();
    }


    /**
     * Total lineal wired surfaces
     * Superficies lineales totales alambradas
     */
    
    extend public int totalLinealWiredSurfacesAttached() {
	return attachedWiredSurfacesToLeft() + attachedWiredSurfacesToRight();
    }


    /**
     * Surfaces to left
     * Superficies a la izquierda
     */

    extend public int attachedWiredSurfacesToLeft() {
	//Funcion rodolfo  04-09-2023
        if (isSingle()) {
	    //pln("esta ");
	    return 1;
	} else	if (getSurfaceAttachedLeft()) {
	    //pln("iingreseo 2");
	    //pln("getChairAttachedRight().attachedSofasToRight()+1:" # getChairAttachedRight().attachedSofasToRight()+1);
	    return getSurfaceAttachedLeft().attachedWiredSurfacesToLeft()+1;
	} else {
	    //pln("iingreseo 3");
	    return 1;
	}
	return 0;
    }

    
    extend public int attachedmesas() {

	return mesas;
    }
    extend public int attachedWiredSurfacesToRight() {

	if (isSingle()) {
	    //pln("esta ");
	    return 1;
	} else	if (getSurfaceAttachedRight()) {
	    //pln("iingreseo 2");
	    //pln("getChairAttachedRight().attachedSofasToRight()+1:" # getChairAttachedRight().attachedSofasToRight()+1);
	    return getSurfaceAttachedRight().attachedWiredSurfacesToRight()+1;
	} else {
	    //pln("iingreseo 3");
	    return 1;
	}
	
	return 0;
    }


    /**
     * countWiredSurfacesAttached()
     * This method will count the attached surfaces when the configurations is island type
     * or back to back configuration.
     
     */

    //Contar superficies cableadas conectadas (Analizar bien esta clase)
    extend public int countWiredSurfacesAttached() {
	int attachedWiredSurfaces = _wiredDuct ? 1 : 0;
	bool continueCount = false;

	TekRectSurface attachedLeft = getSurfaceAttachedLeft();
	//pln("borrar: TekRectSurface attachedLeft " # getSurfaceAttachedLeft());
	Tek120DegSurface attached120Left = get120SurfaceAttachedLeft();

	//pln("attachedLeft:" # attachedLeft);
	//pln("attached120Left:" # attached120Left);
	
	if (attachedLeft == null and attached120Left == null) {
	    if (getSurfaceAttachedBack() != null) {
		attachedLeft = getSurfaceAttachedBack();
	    }
	}

	if (attachedLeft != null or attached120Left != null) {
	    continueCount = true;
	}
	
	while (continueCount) {
	    if (attachedLeft != null) {
		if (attachedLeft.id == this.id) {
		    continueCount = false;
		} else {
		    attachedWiredSurfaces += attachedLeft._wiredDuct ? 1 : 0;
		    if (attachedLeft.getSurfaceAttachedLeft() == null) {
			if (attachedLeft.get120SurfaceAttachedLeft() != null) {
			    attached120Left = attachedLeft.get120SurfaceAttachedLeft();
			    attachedLeft = null;
			} else if (attachedLeft.getSurfaceAttachedBack() != null) {
			    attachedLeft = attachedLeft.getSurfaceAttachedBack();
			}
		    } else {
			attachedLeft = attachedLeft.getSurfaceAttachedLeft();
		    }
		}
	    } else if (attached120Left != null) {
		attachedWiredSurfaces += attached120Left.wiredDuct ? 2 : 0;
		if (attached120Left.getSurfaceAttachedLeft() != null) {
		    attachedLeft = attached120Left.getSurfaceAttachedLeft();
		    attached120Left = null;
		} else if (attached120Left.getSurfaceAttachedLeftBack() != null) {
		    attached120Left = attached120Left.getSurfaceAttachedLeftBack();
		} else {
		    continueCount = false;
		}
	    } else {
		continueCount = false;
	    }
	}
	return attachedWiredSurfaces;
    }


    /***********************************************************************
     * Choose the pre-wired box type
     * Cambiar el tipo de caja precableada
     ***********************************************************************/
    
    /**
     * Selects the box type white is B, black is type A
     * Selecciona el tipo de cuadro blanco es B, negro es tipo A
     */    

    extend public bool whiteTypeWireBox() {
	int totalWiredSurfaces = totalWiredSurfacesAttached();
	//pln("que hay aqui: borrar: " # totalWiredSurfaces);
	if (totalWiredSurfaces>=0) {
	    int groups = totalWiredSurfaces/6;
    
	    if (groups % 2 == 0) {
		return false;
	    } else {
		return true;
	    }
	}
	return false;
    }

    /**
     * This method will define if there is a wired infeed 
     * Este método definirá si hay una alimentación cableada
     */
    // Este metodo es utilizado por totalLinealFloorDuctsAttached
    extend public bool hasWiredFloorDuct() {

	return false;
    }


    /***********************************************************************
     * Count the floor ducts or ceiling ducts
     * Cuente los conductos de piso o los conductos de techo
     ***********************************************************************/



    //Ductos de piso cableados
    extend public int countWiredFloorDucts() {
	int floorDucts = infeedDuct;
	
	bool continueCount = false;

	TekRectSurface attachedLeft = getSurfaceAttachedLeft();
	Tek120DegSurface attached120Left = get120SurfaceAttachedLeft();
	
	if (attachedLeft == null and attached120Left == null) {
	    if (getSurfaceAttachedBack() != null) {
		attachedLeft = getSurfaceAttachedBack();
	    }
	}

	if (attachedLeft != null or attached120Left != null) {
	    continueCount = true;
	}
	
	while (continueCount) {
	    if (attachedLeft != null) {
		if (attachedLeft.id == this.id) {
		    continueCount = false;
		} else {
		    floorDucts += attachedLeft.infeedDuct;
		    if (attachedLeft.getSurfaceAttachedLeft() == null) {
			if (attachedLeft.get120SurfaceAttachedLeft() != null) {
			    attached120Left = attachedLeft.get120SurfaceAttachedLeft();
			    attachedLeft = null;
			} else if (attachedLeft.getSurfaceAttachedBack() != null) {
			    attachedLeft = attachedLeft.getSurfaceAttachedBack();
			}
		    } else {
			attachedLeft = attachedLeft.getSurfaceAttachedLeft();
		    }
		}
	    } else if (attached120Left != null) {
		floorDucts += attached120Left.infeedDuct;
		if (attached120Left.getSurfaceAttachedLeft() != null) {
		    attachedLeft = attached120Left.getSurfaceAttachedLeft();
		    attached120Left = null;
		} else if (attached120Left.getSurfaceAttachedLeftBack() != null) {
		    attached120Left = attached120Left.getSurfaceAttachedLeftBack();
		} else {
		    continueCount = false;
		}
	    } else {
		continueCount = false;
	    }
	}
	return floorDucts;
    }

    

}

