    /***********************************************************************
     * Snapping
     * chasquido
     ***********************************************************************/

    /**
     *Allow snap
     *Permitir chasquido
     *este metodo permite que los conectores de un snappers reconozcan los conectores del que se va a pegar con el
     */
    public bool allowSnap(Connector s, Connector a) {
	//pln(" quien es s : " # s);
	//pln(" quien es s : " # a);
	if (s as WorksurfaceConnectLine) {
	    if (s.edgeId == cTekWSEdgeIdFront or s.edgeId == cTekWSEdgeIdBack) {
			return false;
	    }
	    if (s.edgeId == cTekWSEdgeIdLeft) {
			return false;
	    }
	    //pln(" quien es s.edgeId : " # s.edgeId);
	    //pln(" quien es cTekWSEdgeIdFront : " # cTekWSEdgeIdFront);
	    //pln(" quien es cTekWSEdgeIdBack : " # cTekWSEdgeIdBack);
	    
	    if (s.edgeId == cTekWSEdgeIdFront) {
		if (a as WorksurfaceConnectLine) {
		    //pln(" entro al conector a : ");
		    //Don't allow snapping Front to Front nor Front to Back
		    //pln(" quien es a.edgeId : " # a.edgeId);
		    if (a.edgeId == cTekWSEdgeIdFront or a.edgeId == cTekWSEdgeIdBack) {
			return false;
		    }
		}
	    }
	}

	return super(..);
	//return false;// con este false Los snappers no seran reconocidos por el otro
	
    }



