    extend public MplWorksurfacePart getWorksurfacePart(MplWorksurface ws, str styleNo, MplSpecOption[] options, double quantity) {
	//pln("this : " # this);
	//pln("styleNo : " # styleNo);
	//pln("getOptions() : " # getOptions());

        return MplWorksurfacePart(ws, styleNo, options, quantity);
    }

    
    public MplPart getWorksurfacePart() {

	//pln("asjbjbasf: " # getSurfaceOnEdge(cTekWSEdgeIdBack));
	bool hasBack = getSurfaceOnEdge(cTekWSEdgeIdBack) != null;
	//pln("asjbjbasf: " # cTekWSEdgeIdBack);

	MplPart p;
	
	str styleNo = getStyleNo();
	//pln("esto de donde;: " # styleNo);

	//pln("this : " # this);
	//pln("styleNo : " # styleNo);
	//pln("getOptions() : " # getOptions());
	if (styleNo and styleNo.any) {
	    
	    //pln("tamaño anchio : " # hasBack);
	    

	    if (isSpecial) {
		if (hasBack ) {
		    p = PriRectWsSpecialPart(this, styleNo, getOptions(),  quantity=0.5);
		} else {
		    p = PriRectWsSpecialPart(this, styleNo, getOptions());
		}
	    } else {
		if (hasBack ) {
		    p = getWorksurfacePart(this, styleNo, getOptions(), quantity=0.5);
		} else {
		    p = productLineSettings.getWorksurfacePart(this, styleNo, getOptions());
		}
	    }

	    
	}

	return p;
     }
    

    /**
     * horizontalTextureDirection
     * IMPORANTE para la posicion de las texturas
     */
    public bool horizontalTextureDirection() {

	if (orientacionTexturaFuncion() == 0) {
	    
	    return true;
	} else {
	    return false;
	}
	//return w > ls;
	return true;
    }


    /**
     * addOptions
     * OJO
     */
    public MplSpecOption[] getOptions() {
	MplSpecOption[] options();

	if (MplMaterial surfaceM = getMaterial().MplMaterial) {
	    MplSpecOption o;

	    //MplPart s =  MplPart(this, "hola", useSpecificInLookup=useSpecificInLookup(), quantity=0.5);

	     //pln( " que esta vaina: " # surfaceM.comWoodMtrl());
	     //pln( " que esta vaina: " # surfaceM);
	    if (surfaceM.comWoodMtrl()) {
		o = MplSpecOption(surfaceM, mplSpecOptionType.main, useInLookup=false, useSpecificInLookup=useSpecificInLookup(), exportToXML=false);

	    } else {
		o = MplSpecOption(surfaceM, mplSpecOptionType.main, useInLookup=useSurfaceOptionInLookup(), useSpecificInLookup=useSpecificInLookup(), exportToXML=exportToXML() );//quantity=1
		 
	    }
	     
	    
	    options << o;
	    
	}
	
	if (MplMaterial edgeM = getEdgeMaterial().MplMaterial) {
	    if (!edgeM.comWoodMtrl) {
		options << MplSpecOption(edgeM, mplSpecOptionType.extSideMat1, useInLookup=false);
	    }
	}

	//pln( " que esta vaina: " # options);
	
	return options;
    }
    
    /**
     * Get parts.
     * Obtener partes para los precios, aqui defino los precios de cada objeto correspondiente
     * CODIGOS
     */

    //IMPORTANTE  Partes codigo, grommet, ducto cableado, punteras, puntera gerencial, ducto piso.
    public void getParts(PartsEnv env, Snapper{} visited) {

	MplPart metalica = getPartKitNaveMetalica(env);
	MplPart formica = getPartKitNaveFormica(env);
	MplPart melamina = getPartKitNaveMelamina(env);
	MplPart embebida = getPartKitNaveEmbebida(env);

	if (tipofuncionSuperficie == 3 and countFuntionDoors.nave1) {

	    env.parts <<? embebida;

	} else {

	    //env.parts <<? corazaPart();
	    //env.parts <<? getPartCoraza();
	    MplPart coraza = getPartCoraza(env);
	    env.parts <<? coraza;
	    
	    if (tipofuncionSuperficie == 0) {

		MplPart cerraduras = getPartCerraduras(env);
		if (!modulacionFuncionCerraduras().ninguno) {
		    env.parts <<? cerraduras;
		}

	    } else if (tipofuncionSuperficie == 3) {

		MplPart cerraduras = getPartCerradurasEmbebida(env);
		env.parts <<? cerraduras;
		/*
		  if (!modulacionFuncionCerraduras().ninguno) {
		  env.parts <<? cerraduras;
		  }
		*/
	    } else {

		MplPart cerradurasMadera = getPartCerradurasMadera(env);
		if (!modulacionFuncionCerradurasMadera().ninguno) {
		    env.parts <<? cerradurasMadera;
		}

	    }

	    if (((tipofuncionSuperficie == 0 or tipofuncionSuperficie == 3) and !modulacionFuncionCerraduras.nueve)) {

		MplPart manijas = getPartManijas(env);
		if (!modulacionFuncionVigasCostados().ninguno) {
		    env.parts <<? manijas;
		}
	    } else if (tipofuncionSuperficie == 3) {

		MplPart manijas = getPartManijas(env);
		if (!modulacionFuncionVigasCostados().ninguno) {
		    env.parts <<? manijas;
		}
		
	    } else if (((tipofuncionSuperficie == 1 or tipofuncionSuperficie == 2) and !modulacionFuncionCerradurasMadera.nueve)) {

		MplPart manijas = getPartManijasMadera(env);
		if (!manijasFuncionMadera().ninguno) {
		    env.parts <<? manijas;
		}

	    }

	    MplPart visor = getPartVisor(env);
	    if (visorFuncion()==0) {
		env.parts <<? visor;
	    }

	    MplPart entrepano = getPartEntrepano(env);
	    if (entrepano()) {
		env.parts <<? entrepano;
	    }
	    
	    MplPart kitAnclaje = getPartKitAnclaje(env);
	    if (isSpecial) {
		if (ls <= 0.4) {
		    env.parts <<? kitAnclaje;

		}
	    
	    }

	    MplPart zocalo = getPartZocalo(env);
	    //pln("valor del zocalo: " # zocaloLockerFuncion());
	    if (zocaloLockerFuncion().verdadero) {
		env.parts <<? zocalo;
	    }
	    
	    //----------------------------------------------------------------
	
	    if (tipofuncionSuperficie()==0) {
		
		env.parts <<? metalica;
	    } else if (tipofuncionSuperficie()==1) {
		env.parts <<? formica;

	    }  else if (tipofuncionSuperficie()==2) {
		env.parts <<? melamina;

	    }  else if (tipofuncionSuperficie()==3) {
		env.parts <<? embebida;

	    }
	}

    }


    extend public MplSpecOption[] getOptionsMaterialsCoraza() {

	

	 MplSpecOption[] options();


	 

	 if (MplMaterial corazaM = getAccessoriesMaterial().MplMaterial) {
	     //options <<  MplSpecOption(corazaM, mplSpecOptionType.paintColor);//
	     options <<  MplSpecOption(corazaM, mplSpecOptionType.main, useInLookup=useSurfaceOptionInLookup(), useSpecificInLookup=useSpecificInLookup(), exportToXML=exportToXML());
	    //MplSpecOption o;
	    //o = MplSpecOption(surfaceM, mplSpecOptionType.main, useInLookup=false, useSpecificInLookup=useSpecificInLookup(), exportToXML=false);
	    //o =   MplSpecOption(surfaceM, mplSpecOptionType.paintColor);
	    //o = MplSpecOption(surfaceM, mplSpecOptionType.main, useInLookup=false, useSpecificInLookup=useSpecificInLookup(), exportToXML=false);
	    //o =  MplSpecOption(surfaceM, mplSpecOptionType.main, useInLookup=useSurfaceOptionInLookup(), useSpecificInLookup=useSpecificInLookup(), exportToXML=exportToXML() );//quantity=1
	    //o =  MplSpecOption(surfaceM, mplSpecOptionType.main, useInLookup=false, useSpecificInLookup=useSpecificInLookup(),  exportToXML=false);
	    //options << o;
	    
	}

	 //pln("opcion:  " # options);
