    /// TROQUEL
    extend public Primitive3D troquel(FetchEnv3D env) {
	
        
	
	Primitive3D cache = cache3D(cm3DFileNameTroquel(), env.detail, w,  getGrommetMaterial) {


	    //cm= aqui me trajo el objeto correspondiente en 3D
	    //c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D
	    Primitive3D[] prims();

	    
	    Cm3D cm = getCm3D(urlTroquel);

	    //mplGetCM3DPrimByID= ESto me retorna el objeto grommet final en si, no en cache
	    //pln("el cm: " # cm);
	    Primitive3D grommet = mplGetCM3DPrimByID(env, "0", null, cm);
	    
	    prims << grommet;
	    Primitive3D prim = safeInstance3D(prims);
	    
	    result prim;
	};
	return cache;
    }

    /// TROQUEL
    /***********************************************************************
     * este troquel es el de abajo cuando se llama troquelado arriba y abajo al mismo tiempo
     * roob 27/12/2023
     ***********************************************************************/
    
    extend public Primitive3D troquelDown(FetchEnv3D env) {
	
        
	
	Primitive3D cache = cache3D(cm3DFileNameTroquelDown(), env.detail, w,  getGrommetMaterial) {


	    //cm= aqui me trajo el objeto correspondiente en 3D
	    //c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D
