    /***********************************************************************
     * Paths
     * Caminos o conectores
     ***********************************************************************/
    
    /**
     * Build path.
     * MESA construir conectores
     */


    // LOCKER Construir camino
    // una figura echa a partir de formas geometricas
    public void buildPath(bool force=false) {
	bool splitWS = hasCredenza;
	//double ductGap = splitWS ? 0 : 10cm;//este es el espacio del ducto. pero aqui vamos con la superficie completa
	double ductGap = splitWS ? 0 : 0cm;
	//pln("path:" # path # " force: " # force # " splitWS: " # splitWS);
	if ((!path or force) and !splitWS) {
	    //pln("ingreso al if:");
	    //pln("ingreso al w: " # w);// largo de la mesa
	    //pln("ingreso al ductGap: " # ductGap);
	    //pln("ingreso al ls: " # ls); // tamaño ancho: 0.6 y 0.75
	    //Esta es la mesa rectangular surface
	    MplWorksurfacePath p((0, 0));

	    
	    p.lineTo((w, 0));
	    p.set("b", worksurfaceConnectType.back, edge, gap=ductGap);
	    
	    p.lineTo((w, ls));
	    p.set("rs", worksurfaceConnectType.rightSide, edge, start=ductGap);
	    
	    p.lineTo((0, ls));
	    p.set("f", worksurfaceConnectType.front, edge);
	    
	    p.lineTo((0, 0));
	    p.set("ls", worksurfaceConnectType.leftSide, edge, end=ductGap);
	    
	    p.close;
	    this.path = p;

	 
	    this.deductedPath = null;
	    
	    updateConnectLines();
	} else if ((!path or force)) {
	    //pln("ingreso al else:");
	    //Esta es la mesa gerencial
	    double channelGapW = 10cm;
	    double wsEndW = flipSupportChannel ? w - 13cm - channelGapW : 13cm;
	    MplWorksurfacePath p((0, 0));
	    
	    p.lineTo((w, 0));
	    p.set("b", worksurfaceConnectType.back, edge, gap=ductGap);
	    
	    p.lineTo((w, -ls));
	    p.set("rs", worksurfaceConnectType.rightSide, edge);
	    
	    p.lineTo((0 + channelGapW + wsEndW, -ls));
	    p.set("f", worksurfaceConnectType.front, edge, end=channelGapW + wsEndW);

	    p.lineTo((0 + channelGapW + wsEndW, -.1cm));
	    p.lineTo((0 + wsEndW, -.1cm));
	    p.lineTo((0 + wsEndW, -ls));
	    p.lineTo((0, -ls));
	    
	    p.lineTo((0, 0));
	    p.set("ls", worksurfaceConnectType.leftSide, edge);
	    
	    p.close;
	    this.path = p;
	    this.deductedPath = null;

	    updateConnectLines();
	}
    }


