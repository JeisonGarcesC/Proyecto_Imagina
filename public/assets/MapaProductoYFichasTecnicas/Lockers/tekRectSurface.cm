	//r.lineType = lineType(color(0, 0, 0), lineStyle.dot);

	if (getSurfaceOnEdge(cTekWSEdgeIdBack) != null) {
	    GRect r( rect(((w/2)-256mm, -0.001m), ((w/2)+256mm, -0.117m)), veryThickGrayLineType);
	    //r.lineType = lineType(color(0, 0, 0), lineStyle.dot);
	    return r;
	} else {
	    GRect r( rect(((w/2)-256mm, -0.022m), ((w/2)+256mm, -0.138m)), veryThickGrayLineType);
	    //r.lineType = lineType(color(0, 0, 0), lineStyle.dot);
	    return r;
	}
	
	
	return r;
    }


    

