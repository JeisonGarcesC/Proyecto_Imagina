public class PriRectWsSpecialPart extends MplSpecialPart {

    public str modifyDescription(str description, Snapper owner) {
	//pln("owner" #  owner);
	if (owner as MplWorksurface) {
	    MplWorksurface backWs = owner.getSurfaceOnEdge("b");
	    bool hasBack = backWs != null;
	    
	    if (owner as TekRectSurface) {

		StrBuf buf(super(description, owner));
		//pln("buf 1" # buf);
		buf  << " - " <<  $depth << ": ";
		if (true) {
		     // * 2
		    if (hasBack) {
			//pln("entro aqui con doble ");
			buf << owner.dimension("s") * 100 * 2 << " cm ";
			//pln("cuantos cm hay  " # owner.dimension("s"));
		    } else {
			buf << centimetersS(owner.dimension("s"));
		    }
		    
		} else {
		    buf << centimetersS(owner.dimension("s"));
		}
	    
		buf << " - ";
		buf  << $long << ": ";
		//pln("buf 2" # $capWidthLabel);
		//buf << "45";//centimetersS(owner.dimension("b")).toUpper();
		buf << centimetersS(owner.dimension("b"));
		buf << " - ";
		buf  << $height << ": ";

		if ( owner.alturaLockerFuncion()== 0 ) {
		    //pln("altura: " # owner.alturaLockerFuncion());
		    buf << "180cm";
		    //buf << 180cm;//;centimetersS(owner.dimension("h"));
		} else {
		    buf << "220cm";
		}

		
	    }
	}
	
	//pln("super: " # super(description, owner));
	return super(description, owner);
	//return null;
    }


}

