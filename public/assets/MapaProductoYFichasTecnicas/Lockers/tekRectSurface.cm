    extend public MplPart getPartCoraza(PartsEnv env) {

	double alturaReal= h * 100;
	//pln("altura real.. " # alturaReal);
	double altura= 0;
	if (alturaReal <=180) {
	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal= w*100;
	double ancho= 0 ;
	if (anchoReal <=50) {
	    ancho = 50;

	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
	
	StrBuf buf();
	buf << "LOCKERCORAZA1P_" # ancho # "_" # profundidad # "_" # altura # "_" # calibreReal;

	//return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1, todo ); // para el especial
	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1, descripcionSpecial);
	    // Crear el espacial Manual:
	    //JeisonCoraza
	    //StrBuf buf4(super(this));
	    
	    // pln("buf 2: " # buf4);
	    //MplDescriptiveSpecOption
	    //return PriRectWsSpecialPart(this, buf.toS, getOptionsMaterialsCoraza(),  quantity=1);
	    return MplSpecialPartCoraza(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=true);
	} else {
	    /***************************************************************
	     * se reemplaza este return para que siempre salgan las notas y medidas especiales en cualquier medida
	     * roob 12/11/2024
	     * //return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1);
	     ***************************************************************/
	    
	    //return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1);
	    return MplSpecialPartCoraza(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=false);

	}
	return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1);
    }

    extend public MplPart getPartManijas(PartsEnv env) {

	StrBuf buf();
	buf << "LOCKER";

	if (modulacionFuncionVigasCostados()==0) {
	    buf << "MANINCR";
	} else if (modulacionFuncionVigasCostados()==1) {
	    buf << "MANBOTALAM";
	} else if (modulacionFuncionVigasCostados()==2) {
	    buf << "MANSCHLAM";
	} else if (modulacionFuncionVigasCostados()==3) {
	    buf << "MANEMBLAM";
	} else {
	    buf << "MANINCR";
	}

	double cantidadManijas= 0;

	if (countFuntionDoors()==0) {
	    cantidadManijas= 1 * 1;
	} else if (countFuntionDoors()==1) {
	    cantidadManijas= 2 * 1;
	} else if (countFuntionDoors()==2) {
	    cantidadManijas= 3 * 1;
	} else if (countFuntionDoors()==3) {
	    cantidadManijas= 4 * 1;
	}


	//return MplPart(this, buf.toS, getOptions() , quantity=2, alturaS);
	return MplPart(this, buf.toS, quantity=cantidadManijas);
    }

