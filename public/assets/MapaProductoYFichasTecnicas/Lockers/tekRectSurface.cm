    // VISOR MPR280032

     public Primitive3D visor3D(FetchEnv3D env) {
	
        
	//c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D

	 
	double alturaTotal = h;

	double altura=alturaTotal;

	/*

	if (countFuntionDoors() == 0) {
	    altura= (alturaTotal/2)+5cm;
	} else if (countFuntionDoors() == 1) {
	    altura= (alturaTotal/4)+5cm;
	} else if (countFuntionDoors() == 2) {
	    altura= (alturaTotal/8)+5cm;
	} else if (countFuntionDoors() == 3) {
	    altura= (alturaTotal/16)+7cm;
	}
	*/

	if (countFuntionDoors() == 0) {
	    //altura= (alturaTotal/2)+15cm;
	    altura= (alturaTotal/2-150mm/2);
	} else if (countFuntionDoors() == 1) {
	    altura= (alturaTotal/4)-15cm/2 + 14.5mm;
	} else if (countFuntionDoors() == 2) {
	    altura= (alturaTotal/8)-15cm/2 + 94mm;
	} else if (countFuntionDoors() == 3) {
	    altura= (alturaTotal/16)-15cm/2 + 133mm;
	}
	
	//str url = "c:/CetDev/version14.0/extensions/custom/mepal/furniture/worksurfaces/lockers/res/models/" # cm3dM # ".cm3D";
	Primitive3D cache = cache3D(cm3DFileNameVisor(), env.detail, w,  getGrommetMaterial, altura) {


	    //cm= aqui me trajo el objeto correspondiente en 3D
	    //c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D
	    Primitive3D[] prims();

	    
	    Cm3D cm = getCm3D(urlVisor());

	    //mplGetCM3DPrimByID= ESto me retorna el objeto grommet final en si, no en cache
	    //pln("el cm: " # cm);
	    Primitive3D visor = mplGetCM3DPrimByID(env, "0", null, cm);
	    //visor.move(((w/2)-5cm, -2.1cm, altura));
	    //visor.move(((w)-135mm, -21mm, altura));
	    visor.move(((w/2)-135mm, -23mm, altura));

	    //visor.setMaterial(getAccessoriesMaterial.material3D); // material 3d del visor
	    visor.setColor(156, 156, 156);
	    prims << visor;
	    Primitive3D prim = safeInstance3D(prims);
	    
	    result prim;
	};
	return cache;
     }

     public str cm3DFileNameVisor() {
	str prefix;

	prefix="MPR280032";

	if (visorFuncion() == 0) {
	    prefix="MPR280032";
	} else {
	    prefix="Nivelador_1_1_2_IND"; // mandamos el nivelador porque esta en un layer diferente y no se va a ver
	    // pero lo mandamos, porque no es correcto enviar objetos vacios. Es mejor enviar algo que no se vea
	}
	

	//prefix = "MPR280032";//Nuevo LKAC250000

	return prefix # ".cm3D";

    }

    public Url urlVisor() {
	return cmFindUrl(lockersCm3dPath # cm3DFileNameVisor());
    }

    public Primitive3D kitNave(FetchEnv3D env) {
	Primitive3D[] prims();


	double alturaActual= h;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	
	double w = (w/2)-4mm;//ancho
	//pln("que es w... : " # w);
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;

	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
 


	PolygonMesh3D mesh2(path, height=thickness);//altura

	mesh2.setMaterial(getSharedLegMaterial.material3D);
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((2mm, nivelador + borde, 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));

	/*
	if (!modulacionFuncionVigasCostados().ninguno) {
	    prims <<? manija3D2(env);// groomet
	}
	*/
	if (!modulacionFuncionCerraduras().ninguno) {
	    prims <<? cerradura3D(env);// groomet
	}

	if (!modulacionFuncionCerraduras().nueve) {
	    /***************************************************************
	     * si tiene cerradura con clave , las manijas no llamaran 
	     * a su bloque
	     * nave lisa individual
	     * roob 03-01-2024
	     ***************************************************************/
	    
	    if (!modulacionFuncionVigasCostados().ninguno) {
		prims <<? manija3D2(env);// groomet
	    }
	}

	prims <<? visor3D(env);// groomet
	
        

	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
    }

    /***********************************************************************
     * kit nave troquel para el locker doble
     * corresponde al primer kit nave 
     * metodo public
     * roob 28-12-2023
     ***********************************************************************/
    
     public Primitive3D kitNaveTroquel(FetchEnv3D env) {
	Primitive3D[] prims();

       

	double alturaActual= h;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = (w/2)-4mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
	//PARA TROQUELES ABAJO
	// 1 troquelado
  
        APath2D path1((0mm, 1mm)); //1
	path1.lineTo((0mm, f-1mm)); //2
	path1.arcTo((1mm, f), 90deg); //3
	path1.lineTo((w-1mm, f)); //4
	path1.arcTo((w, f-1mm), 0deg); //5
	path1.lineTo((w, f-15mm)); //6
	path1.lineTo(((w/2)-125mm, f-15mm)); //7
	path1.lineTo(((w/2)-125mm, f-120mm)); //8
	path1.lineTo(((w/2)+125mm, f-120mm)); //9
	path1.lineTo(((w/2)+125mm, f-15mm)); //10
	path1.lineTo((w, f-15mm)); //11
	//path1.lineTo((w, 120mm)); //12
	//path1.lineTo(((w/2)-145mm, 120mm)); //13
	//path1.lineTo(((w/2)-145mm, 15mm)); //14
	//path1.lineTo(((w/2)+145mm, 15mm)); //15
	//path1.lineTo(((w/2)+145mm, 120mm)); //16
	//path1.lineTo((w, 120mm)); //17
	path1.lineTo((w, 1mm)); //18
	path1.arcTo((w-1mm, 0mm), -90deg); //19
	path1.lineTo((1mm, 0mm)); //20
	path1.arcTo((0mm, 1mm), -180deg); //11
	
	path1.close();

	PolygonMesh3D mesh1(path1, height=thickness);//altura
	mesh1.move((2mm, 0, 0));
	mesh1.setMaterial(getSharedLegMaterial.material3D);
 
	

	//PARA TROQUELES NAVE LOCKER DOBLE CAJA
 
	APath2D path2((0mm, 1mm)); //1
	path2.lineTo((0mm, f-1mm)); //2
	path2.arcTo((1mm, f), 90deg); //3
	path2.lineTo((w-1mm, f)); //4
	path2.arcTo((w, f-1mm), 0deg); //5
	path2.lineTo((w, f-15mm)); //6
	path2.lineTo(((w/2)-125mm, f-15mm)); //7
	path2.lineTo(((w/2)-125mm, f-120mm)); //8
	path2.lineTo(((w/2)+125mm, f-120mm)); //9
	path2.lineTo(((w/2)+125mm, f-15mm)); //10
	path2.lineTo((w, f-15mm)); //11
	path2.lineTo((w, 120mm)); //12
	path2.lineTo(((w/2)-125mm, 120mm)); //13
	path2.lineTo(((w/2)-125mm, 15mm)); //14
	path2.lineTo(((w/2)+125mm, 15mm)); //15
	path2.lineTo(((w/2)+125mm, 120mm)); //16
	path2.lineTo((w, 120mm)); //17
	path2.lineTo((w, 1mm)); //18
	path2.arcTo((w-1mm, 0mm), -90deg); //19
	path2.lineTo((1mm, 0mm)); //20
	path2.arcTo((0mm, 1mm), -180deg); //11
	
	path2.close();

	PolygonMesh3D mesh2(path2, height=thickness);//altura
	mesh2.move((2mm, 0, 0));
	mesh2.setMaterial(getSharedLegMaterial.material3D);

	//PARA TROQUELES ARRIBA NAVE LOCKER 
 
	APath2D path3((0mm, 1mm)); //1
	path3.lineTo((0mm, f-1mm)); //2
	path3.arcTo((1mm, f), 90deg); //3
	path3.lineTo((w-1mm, f)); //4
	path3.arcTo((w, f-1mm), 0deg); //5
	//path.lineTo((w, f-15mm)); //6
	//path.lineTo(((w/2)-145mm, f-15mm)); //7
	//path.lineTo(((w/2)-145mm, f-120mm)); //8
	//path.lineTo(((w/2)+145mm, f-120mm)); //9
	//path.lineTo(((w/2)+145mm, f-15mm)); //10
	//path.lineTo((w, f-15mm)); //11
	path3.lineTo((w, 120mm)); //12
	path3.lineTo(((w/2)-125mm, 120mm)); //13
	path3.lineTo(((w/2)-125mm, 15mm)); //14
	path3.lineTo(((w/2)+125mm, 15mm)); //15
	path3.lineTo(((w/2)+125mm, 120mm)); //16
	path3.lineTo((w, 120mm)); //17
	path3.lineTo((w, 1mm)); //18
	path3.arcTo((w-1mm, 0mm), -90deg); //19
	path3.lineTo((1mm, 0mm)); //20
	path3.arcTo((0mm, 1mm), -180deg); //11
	
	path3.close();

	PolygonMesh3D mesh3(path3, height=thickness);//altura
	mesh3.move((2mm, 0, 0));
	mesh3.setMaterial(getSharedLegMaterial.material3D);
	//prims << mesh2;
	//Mover es para ducto cableado
	//mesh2.move((0, 35mm, 2mm));
	//mesh2.rotate((0deg, 0deg, 90deg));
	
	//pln("lo que devuelve punch : " # punchFuntionPosition());
	
	double posicionTroquelUp = (nave1 + nivelador + borde) -120mm;
	if (punchFuntionPosition.up) {
	    prims << mesh1;
	    mesh1.move((0, nivelador + borde, 2mm)); //nivelador + borde = 26mm
	    mesh1.rotate((0deg, 0deg, 90deg));
	    
	    Primitive3D troquelRespuesta2 = troquel(env);
	    prims << troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
	        troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp ));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
	        troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    }
	    troquelRespuesta2.move((2mm, 0, 0));
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	} else if (punchFuntionPosition().down) {
	    prims << mesh3;
	    mesh3.move((0, nivelador + borde, 2mm));
	    mesh3.rotate((0deg, 0deg, 90deg));
	    Primitive3D troquelRespuesta = troquelDown(env);
	    prims << troquelRespuesta;
	    troquelRespuesta.move((w/2-(290mm/2), -18mm, 41mm));
	    troquelRespuesta.move((2mm, 0, 0));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	} else {
	    prims << mesh2;
	    mesh2.move((0, nivelador + borde, 2mm));
	    mesh2.rotate((0deg, 0deg, 90deg));
	    //Primitive3D troquelRespuesta = troquel(env);
	    Primitive3D troquelRespuesta = troquelDown(env);
	    troquelRespuesta.move((w/2-(290mm/2), -18mm, 41mm));
	    troquelRespuesta.move((2mm, 0, 0));
	    troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	    prims <<? troquelRespuesta;
	    Primitive3D troquelRespuesta2 = troquel(env);
	    //troquelRespuesta2.move((w/2-(290mm/2), -18mm, altura - 136mm));
	    
	    prims <<? troquelRespuesta2;
	    if (countFuntionDoors.nave1) {
	        troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp ));
	    } else if (countFuntionDoors.nave2) {
		posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
	        troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    } else if (countFuntionDoors.nave3) {
		posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    } else {
		posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		troquelRespuesta2.move((w/2-(290mm/2), -18mm, posicionTroquelUp));
	    }
	    troquelRespuesta2.move((2mm, 0, 0));
	    troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	    //return  invisiblePrimitive3D;
	}
	
        //
	//prims <<? troquelRespuesta2;

	/*
	if (!modulacionFuncionVigasCostados().ninguno) {
	    prims <<? manija3D2(env);// groomet
	}
	*/
	if (!modulacionFuncionCerraduras().ninguno) {
	    prims <<? cerradura3D(env);// groomet
	}

	if (!modulacionFuncionCerraduras().nueve) {
	    /***************************************************************
	     * si tiene cerradura con clave , las manijas no llamaran 
	     * a su bloque
	     * nave troquel doble
	     * roob 10-01-2024
	     ***************************************************************/
	    
	    if (!modulacionFuncionVigasCostados().ninguno) {
		prims <<? manija3D2(env);// groomet
	    }
	}

	prims <<? visor3D(env);// groomet
	
	
	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     /**********************************************************************
      *roob : 13/12/2023
      *Esta puerta es la primer kit nave, pertenece a la clase del Locker Doble (metodo public)
      *nave puertas en formica y melamina , las medidas no incluyen el acabado termofundido 
      **********************************************************************/
     
     public Primitive3D kitNaveFormicaMelamina(FetchEnv3D env) {
	Primitive3D[] prims();

        //double height= tekWidthSurfaceCode(this);

	double alturaActual= h;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	double canto = 2mm;//medida del canto termofundido
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde) - (2*canto) - nivelador;
	double nave2 = (nave1 - luzNave - (2*canto)) / 2;
	double nave3 = (nave1 - (luzNave*2) - (4*canto)) /3;
	double nave4 = (nave1 - (luzNave*3) - (6*canto)) /4;
	
	//pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	//Loker
	double w = ((w - 8mm - (4*canto))/2);//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
        
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
	PolygonMesh3D mesh2(path, height=thickness);//altura

	if (tipofuncionSuperficie()==0 or tipofuncionSuperficie()==3) {
	    mesh2.setMaterial(getSharedLegMaterial.material3D);
	    //mesh2.setMaterial(getMaterial.material3D);
	    //mesh2.setMaterial(defaultSurfaceMaterial.material3D);
	    //mesh2.setMaterial(defaultEdgeMaterial.material3D);
	    //mesh2.setMaterial(defaultSharedLegEdgeMaterial.material3D);
	    //mplMaterialSelector(getEdgeMaterial, env)

	} else if (tipofuncionSuperficie()==1) {
	    mesh2.setMaterial(getMaterial.material3D);
	} else if (tipofuncionSuperficie()==2 ) {
	    mesh2.setMaterial(getMaterial.material3D);
	} else {
	    mesh2.setMaterial(getEdgeMaterial.material3D);
	}

	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((2mm + canto, nivelador + borde + canto, 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));
	//mesh2.setTextureSpace(YPlaneTextureSpace3D());
	//mesh2.setXPlaneTextureSpace(10);
	//mesh2.setYPlaneTextureSpace(10);
	/*
	/** * SET X plane texture space (the Z axis is the 'up' vector for 2D textures). */
	final public void setXPlaneTextureSpace(double scale=1) {
	    setTextureSpace(XPlaneTextureSpace3D(scale));
	    }
	*/
	//mesh2.setTextureSpace(XPlaneTextureSpace3D());
	//mesh2.setTextureSpace(ZPlaneTextureSpace3D());
	//mesh2.setTextureSpace(PlaneTextureSpace3D((0, 1, 1), (0, 1, 1), (1, 0, 1)));
	//PlaneTextureSpace3D((1, 0, 0), (0, 0, 1), (0, 1, 0));
	//PlaneTextureSpace3D((1, 0, 0), (0, 0, 1), (1, 0, 0));
	//YPlaneTextureSpace3D()
	//getSurfaceTextureSpace()
	//setTextureSpace(autoAxisTextureSpace3D());

	//prims <<? manija3D(env);// groomet
	
	prims <<? visor3D(env);// groomet
	/*
	if (!modulacionFuncionVigasCostados().ninguno) {
	    prims <<? manija3D2(env);// groomet
	}
	*/
	if (!modulacionFuncionCerradurasMadera().ninguno) {
	    prims <<? cerraduraMadera3D(env);// groomet
	}

	if (!modulacionFuncionCerradurasMadera().nueve) {
	    /***************************************************************
	     * si tiene cerradura con clave , las manijas no llamaran 
	     * a su bloque
	     * nave formica/melamina doble
	     * roob 10-01-2024
	     ***************************************************************/
	    
	    if (!manijasFuncionMadera().ninguno) {
		prims <<? manijaMadera3D(env);// groomet
	    }
	}


	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }

     /**********************************************************************
      * canto termofundido de las naves formica y melamina
      *	*Este canto pertenece a la primera puerta del Locker Doble (metodo public)
      *	roob : 12/12/2023
      **********************************************************************/
     // El canto es este, el otro es una opcion 
     public Primitive3D canto2(FetchEnv3D env) {

	double f = h;//altura
	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	double canto = 2mm;//medida del canto termofundido
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde) - nivelador;
	double nave2 = (nave1 - luzNave ) / 2;
	double nave3 = (nave1 - (luzNave*2) ) /3;
	double nave4 = (nave1 - (luzNave*3) ) /4;

	double thickness = 16mm;

	double w = ((w - 8mm)/2) ;//ancho
        double d = ls;//profundidad

	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
	

	Primitive3D[] prims();

	box b = box((0mm, 0mm, 0mm), w, f, thickness);
	// box (-245 , -150 , -11) , 590 , 300 , 11 

	//Primitive3D hole = fastBox3D(b.p0.pointF, b.p1.pointF, top=false);
	//hole.setMaterial(plainGrayMaterial3D);
	//prims << hole;

	HollowBox3D frame(b.rect, canto, thickness);
	frame.rotate((0deg, 0deg, 90deg));
	frame.move((2mm , -2mm ,  nivelador + borde ));
	//frame.rotate((0deg, 0deg, 90deg));
	//frame.move((-(w/2), 5.5mm, 743mm));
	//isWoodSurface = true ;
	frame.setMaterial(getEdgeMaterial.material3D);
	//frame.setMaterial(plainGrayMaterial3D);
	prims << frame;
	return frame;

	

	//return safeInstance3D(prims, this);
    
    }

    /**
     * Build 3D.
     * Construir 3D
     */

     extend public Primitive3D kitNave3DDoble(FetchEnv3D env) {

	 double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	 //double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	 double nivelador = 10mm;//medida desde piso a tapa inferior
	 double luzNave = 2mm;//medida de luz entre naves
	 //double alturaTapas = 25mm;//medida desde piso a tapa inferior
	 //double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	 double nave1 = h - (2*borde)- nivelador;
	 double nave2 = (nave1 - luzNave) / 2;
	 double nave3 = (nave1 - (luzNave*2)) /3;
	 double nave4 = (nave1 - (luzNave*3)) /4;

	 double ancho = w ;
	
	 double moverACentro=w/2;

	 Primitive3D top3D = cache3D(env.detail , punchFuntionPosition , countFuntionDoors , h , punchFuntionPosition() , punchPosition , punchFuntionType() , punchType, modulacionTipoCerraduras, modulacionFuncionCerraduras(), modulacionVigasCostados, modulacionVigasCostados, modulacionFuncionVigasCostados() , getSharedLegMaterial, visor, visorFuncion() , w , ls , ancho , moverACentro  ) {


	     Primitive3D[] prims2();

	
	     //naves lisas
	     Primitive3D kitNave1Respuesta = kitNave(env) ;
	     Primitive3D kitNave2Respuesta = kitNave(env) ;
	     Primitive3D kitNave3Respuesta = kitNave(env) ;
	     Primitive3D kitNave4Respuesta = kitNave(env) ;
	
	     //naves troqueladas
	     Primitive3D kitNaveTroquel1Respuesta = kitNaveTroquel(env) ;
	     Primitive3D kitNaveTroquel2Respuesta = kitNaveTroquel(env) ;
	     Primitive3D kitNaveTroquel3Respuesta = kitNaveTroquel(env) ;
	     Primitive3D kitNaveTroquel4Respuesta = kitNaveTroquel(env) ;
	
	     //naves lisas
	     if (punchFuntionPosition.none) {
		 if (countFuntionDoors.nave1) {
		     kitNave1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNave1Respuesta;
		 } else if (countFuntionDoors.nave2) {
		     kitNave1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNave1Respuesta;
		     kitNave2Respuesta.move((moverACentro, 0, nave2 + (luzNave)));
		     prims2 <<? kitNave2Respuesta;
		 } else if (countFuntionDoors.nave3) {
		     kitNave1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNave1Respuesta;
		     kitNave2Respuesta.move((moverACentro, 0, nave3 + (luzNave)));
		     prims2 <<? kitNave2Respuesta;
		     kitNave3Respuesta.move(((moverACentro/2, 0, nave3 + (luzNave))*2));
		     prims2 <<? kitNave3Respuesta;
		 } else {
		     kitNave1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNave1Respuesta;
		     kitNave2Respuesta.move((moverACentro, 0, nave4 + (luzNave)));
		     prims2 <<? kitNave2Respuesta;
		     kitNave3Respuesta.move(((moverACentro/2, 0, nave4 + (luzNave))*2));
		     prims2 <<? kitNave3Respuesta;
		     kitNave4Respuesta.move(((moverACentro/3, 0, nave4 + (luzNave))*3));
		     prims2 <<? kitNave4Respuesta;
		 }
	    
		 //naves troqueladas
	     } else {
		 if (countFuntionDoors.nave1) {
		     kitNaveTroquel1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveTroquel1Respuesta;
		 } else if (countFuntionDoors.nave2) {
		     kitNaveTroquel1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveTroquel1Respuesta;
		     kitNaveTroquel2Respuesta.move((moverACentro, 0, nave2 + (luzNave)));
		     prims2 <<? kitNaveTroquel2Respuesta;
		 } else if (countFuntionDoors.nave3) {
		     kitNaveTroquel1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveTroquel1Respuesta;
		     kitNaveTroquel2Respuesta.move((moverACentro, 0, nave3 + (luzNave)));
		     prims2 <<? kitNaveTroquel2Respuesta;
		     kitNaveTroquel3Respuesta.move(((moverACentro/2, 0, nave3 + (luzNave))*2));
		     prims2 <<? kitNaveTroquel3Respuesta;
		 } else {
		     kitNaveTroquel1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveTroquel1Respuesta;
		     kitNaveTroquel2Respuesta.move((moverACentro, 0, nave4 + (luzNave)));
		     prims2 <<? kitNaveTroquel2Respuesta;
		     kitNaveTroquel3Respuesta.move(((moverACentro/2, 0, nave4 + (luzNave))*2));
		     prims2 <<? kitNaveTroquel3Respuesta;
		     kitNaveTroquel4Respuesta.move(((moverACentro/3, 0, nave4 + (luzNave))*3));
		     prims2 <<? kitNaveTroquel4Respuesta;
		 }
	    
	     }

	    
	    //kitNave1Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    //kitNave2Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    //kitNave3Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    //kitNave4Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    
	     result prims2.any ? Instance3D(prims2) : invisiblePrimitive3D;
	    

	 };

	
       
	 return top3D;
      
     }

     /**********************************************************************
      *roob : 13/12/2023
      *nave puertas en formica y melamina , construye el segundo kit nave del
      *locker Doble y se agrega el canto termofundido
      **********************************************************************/

     extend public Primitive3D kitNaveFormicaMelamina3DDoble(FetchEnv3D env) {

	 double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	 //double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	 double nivelador = 10mm;//medida desde piso a tapa inferior
	 double luzNave = 2mm;//medida de luz entre naves
	 //double alturaTapas = 25mm;//medida desde piso a tapa inferior
	 //double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	 double nave1 = h - (2*borde)- nivelador;
	 double nave2 = (nave1 - luzNave) / 2;
	 double nave3 = (nave1 - (luzNave*2)) /3;
	 double nave4 = (nave1 - (luzNave*3)) /4;

	 double ancho = w ;
	
	 double moverACentro=w/2 ;

	 Primitive3D top3D = cache3D(env.detail , countFuntionDoors , countFuntionDoors(), countDoors , h , modulacionTipoCerradurasMadera , modulacionTipoCerraduras, modulacionFuncionCerraduras(), modulacionFuncionCerradurasMadera() , modulacionVigasCostados, modulacionVigasCostados, modulacionFuncionVigasCostados() , getSharedLegMaterial, visor, visorFuncion() , w , ls , ancho , moverACentro, getMaterial, getEdgeMaterial, manijasMadera, manijasFuncionMadera()  ) {


	     Primitive3D[] prims2();

	
	     //naves lisas
	     Primitive3D kitNaveFormicaMelamina1Respuesta = kitNaveFormicaMelamina(env) ;
	     Primitive3D kitNaveFormicaMelamina2Respuesta = kitNaveFormicaMelamina(env) ;
	     Primitive3D kitNaveFormicaMelamina3Respuesta = kitNaveFormicaMelamina(env) ;
	     Primitive3D kitNaveFormicaMelamina4Respuesta = kitNaveFormicaMelamina(env) ;
	     
	     //canto troqueladas
	     Primitive3D cantoFormicaMelamina1Respuesta = canto2(env) ;
	     Primitive3D cantoFormicaMelamina2Respuesta = canto2(env) ;
	     Primitive3D cantoFormicaMelamina3Respuesta = canto2(env) ;
	     Primitive3D cantoFormicaMelamina4Respuesta = canto2(env) ;
	     
	     //naves lisas
	     if (true) {
		 if (countFuntionDoors.nave1) {
		     prims2 <<? kitNaveFormicaMelamina1Respuesta;
		     kitNaveFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? cantoFormicaMelamina1Respuesta;
		     cantoFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     
		 } else if (countFuntionDoors.nave2) {
		     prims2 <<? kitNaveFormicaMelamina1Respuesta;
		     kitNaveFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? cantoFormicaMelamina1Respuesta;
		     cantoFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveFormicaMelamina2Respuesta;
		     kitNaveFormicaMelamina2Respuesta.move((moverACentro, 0, nave2 + (luzNave)));
		     prims2 <<? cantoFormicaMelamina2Respuesta;
		     cantoFormicaMelamina2Respuesta.move((moverACentro, 0, nave2 + (luzNave)));
		     
		 } else if (countFuntionDoors.nave3) {
		     prims2 <<? kitNaveFormicaMelamina1Respuesta;
		     kitNaveFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? cantoFormicaMelamina1Respuesta;
		     cantoFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveFormicaMelamina2Respuesta;
		     kitNaveFormicaMelamina2Respuesta.move((moverACentro, 0, nave3 + (luzNave)));
		     prims2 <<? cantoFormicaMelamina2Respuesta;
		     cantoFormicaMelamina2Respuesta.move((moverACentro, 0, nave3 + (luzNave)));
		     prims2 <<? kitNaveFormicaMelamina3Respuesta;
		     kitNaveFormicaMelamina3Respuesta.move(((moverACentro/2, 0, nave3 + (luzNave))*2));
		     prims2 <<? cantoFormicaMelamina3Respuesta;
		     cantoFormicaMelamina3Respuesta.move(((moverACentro/2, 0, nave3 + (luzNave))*2));
		     
		 } else {
		     prims2 <<? kitNaveFormicaMelamina1Respuesta;
		     kitNaveFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? cantoFormicaMelamina1Respuesta;
		     cantoFormicaMelamina1Respuesta.move((moverACentro, 0, 0));
		     prims2 <<? kitNaveFormicaMelamina2Respuesta;
		     kitNaveFormicaMelamina2Respuesta.move((moverACentro, 0, nave4 + (luzNave)));
		     prims2 <<? cantoFormicaMelamina2Respuesta;
		     cantoFormicaMelamina2Respuesta.move((moverACentro, 0, nave4 + (luzNave)));
		     prims2 <<? kitNaveFormicaMelamina3Respuesta;
		     kitNaveFormicaMelamina3Respuesta.move(((moverACentro/2, 0, nave4 + (luzNave))*2));
		     prims2 <<? cantoFormicaMelamina3Respuesta;
		     cantoFormicaMelamina3Respuesta.move(((moverACentro/2, 0, nave4 + (luzNave))*2));
		     prims2 <<? kitNaveFormicaMelamina4Respuesta;
		     kitNaveFormicaMelamina4Respuesta.move(((moverACentro/3, 0, nave4 + (luzNave))*3));
		     prims2 <<? cantoFormicaMelamina4Respuesta;
		     cantoFormicaMelamina4Respuesta.move(((moverACentro/3, 0, nave4 + (luzNave))*3));
		     
		 }
	    
		 //naves troqueladas
	     } else {
		 
	    
	     }

	    
	    
	     result prims2.any ? Instance3D(prims2) : invisiblePrimitive3D;
	    

	 };

	
       
	 return top3D;
      
     }


     extend public Primitive3D kitNave3DEmbebidaDoble(FetchEnv3D env) {
	 Primitive3D  prims();
	 Primitive3D  copiaEmbebida= kitNave3DEmbebida(env);
	 copiaEmbebida.move(((w/2) , 0 , 0));
	 return copiaEmbebida;




     }

     /**********************************************************************
      * 14/12/2023
      *	le pertenece a la clase de locker doble
      *	metodo public , modifica la nave embebida original 
      **********************************************************************/
     
     public Primitive3D kitNaveEmbebida(FetchEnv3D env) {
	Primitive3D[] prims();

        


	//double height= tekWidthSurfaceCode(this);

	double alturaActual= h;
        
	//naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;


	//Loker
	double w = (w/2)-36mm;//ancho
        double d = ls;//profundidad
	double f = h;//altura
	if (countFuntionDoors.nave1) {
	    f = nave1;//altura
	} else if (countFuntionDoors.nave2) {
	    f = nave2;//altura
	} else if (countFuntionDoors.nave3) {
	    f = nave3;//altura
	} else {
	    f = nave4;//altura
	}
        

	//pln("w: " # w);
	//pln("d: " # d);
	//double altura= 1585mm;
	double thickness = 16mm;
	//LOCKERS
	//BASE LOCKER
 
        
	//double w = 500mm;
	//double d = 500mm;
	//kit nave
 
        
 
 
	APath2D path((0mm, 1mm));
	path.lineTo((0mm, f-1mm));
	path.arcTo((1mm, f), 90deg);
	path.lineTo((w-1mm, f));
	path.arcTo((w, f-1mm), 0deg);
	path.lineTo((w, 1mm));
	path.arcTo((w-1mm, 0mm), -90deg);
	path.lineTo((1mm, 0mm));
	path.arcTo((0mm, 1mm), 180deg);
	path.close();
 
 
	//// vovelmove

	PolygonMesh3D mesh2(path, height=thickness);//altura

	mesh2.setMaterial(getSharedLegMaterial.material3D);
	prims << mesh2;
	//Mover es para ducto cableado
	mesh2.move((0, nivelador + borde, 2mm));
	mesh2.rotate((0deg, 0deg, 90deg));
	//mesh2.move((0 , 18mm , 0));
	mesh2.move((18mm , 18mm , luzNave));

	//prims <<? manija3D(env);// groomet


	if (!modulacionFuncionCerraduras().ninguno) {
	    Primitive3D cerraduraEmbebidas= cerraduraEmbebida3D(env);
	    cerraduraEmbebidas.move((0 , 20mm , 0));
	    prims <<? cerraduraEmbebidas;
	}

	//prims <<? manija3D(env);// groomet
	if (!modulacionFuncionVigasCostados().ninguno) {
	    Primitive3D manijasEmbebidas= manija3D2(env);
	    manijasEmbebidas.move((0 , 20mm , 0));
	    prims <<? manijasEmbebidas;// groomet
	}

	
	Primitive3D respuestaVisor3D = visor3D(env);
	respuestaVisor3D.move((0, 18mm , 0));
	prims <<? respuestaVisor3D;


        

	Primitive3D p = Instance3D(prims);

	

 
	return p;
	//return null:
     }


     //// kitNavetroquelembebidoDoble
     
     /**********************************************************************
      * 14/12/2023
      *	kit nave troquelada embebida
      *	le pertenece a la clase de locker doble (metodo public) , modifica al metodo original
      *	es el primer kit nave del locker
      **********************************************************************/
     
     public Primitive3D kitNaveTroquelEmbebida(FetchEnv3D env) {
	 Primitive3D[] prims();

	 //double yTrav= tekWidthSurfaceCode(this);//996.2mm; //
	 //double yTrav= ls*-1;

	 //double height= tekWidthSurfaceCode(this);

	 double alturaActual= h;

	 //naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;
	
	 //pln("lo que me entrega el y osea es la profundidad: " # yTrav);



	 //Loker
	 double w =(w/2)-36mm;//ancho
	 double d = ls;//profundidad
	 double f = h;//altura
	 if (countFuntionDoors.nave1) {
	     f = nave1;//altura
	 } else if (countFuntionDoors.nave2) {
	     f = nave2;//altura
	 } else if (countFuntionDoors.nave3) {
	     f = nave3;//altura
	 } else {
	     f = nave4;//altura
	 }


	 //pln("w: " # w);
	 //pln("d: " # d);
	 //double altura= 1585mm;
	 double thickness = 16mm;
	 //LOCKERS
	 //BASE LOCKER
 
        
	 //PARA TROQUELES ABAJO
	 // 1 troquelado
  
	 APath2D path1((0mm, 1mm)); //1
	 path1.lineTo((0mm, f-1mm)); //2
	 path1.arcTo((1mm, f), 90deg); //3
	 path1.lineTo((w-1mm, f)); //4
	 path1.arcTo((w, f-1mm), 0deg); //5
	 path1.lineTo((w, f-15mm)); //6
	 path1.lineTo(((w/2)-125mm, f-15mm)); //7
	 path1.lineTo(((w/2)-125mm, f-120mm)); //8
	 path1.lineTo(((w/2)+125mm, f-120mm)); //9
	 path1.lineTo(((w/2)+125mm, f-15mm)); //10
	 path1.lineTo((w, f-15mm));
	 path1.lineTo((w, 1mm)); //18
	 path1.arcTo((w-1mm, 0mm), -90deg); //19
	 path1.lineTo((1mm, 0mm)); //20
	 path1.arcTo((0mm, 1mm), -180deg); //11
	
	 path1.close();

	 PolygonMesh3D mesh1(path1, height=thickness);//altura

	 mesh1.move((18mm, luzNave, -18mm));//ejes x , z , y
	

	

	 mesh1.setMaterial(getSharedLegMaterial.material3D);
 
	

	 //PARA TROQUELES NAVE LOCKER DOBLE CAJA
 
	 APath2D path2((0mm, 1mm)); //1
	 path2.lineTo((0mm, f-1mm)); //2
	 path2.arcTo((1mm, f), 90deg); //3
	 path2.lineTo((w-1mm, f)); //4
	 path2.arcTo((w, f-1mm), 0deg); //5
	 path2.lineTo((w, f-15mm)); //6
	 path2.lineTo(((w/2)-125mm, f-15mm)); //7
	 path2.lineTo(((w/2)-125mm, f-120mm)); //8
	 path2.lineTo(((w/2)+125mm, f-120mm)); //9
	 path2.lineTo(((w/2)+125mm, f-15mm)); //10
	 path2.lineTo((w, f-15mm)); //11
	 path2.lineTo((w, 120mm)); //12
	 path2.lineTo(((w/2)-125mm, 120mm)); //13
	 path2.lineTo(((w/2)-125mm, 15mm)); //14
	 path2.lineTo(((w/2)+125mm, 15mm)); //15
	 path2.lineTo(((w/2)+125mm, 120mm)); //16
	 path2.lineTo((w, 120mm)); //17
	 path2.lineTo((w, 1mm)); //18
	 path2.arcTo((w-1mm, 0mm), -90deg); //19
	 path2.lineTo((1mm, 0mm)); //20
	 path2.arcTo((0mm, 1mm), -180deg); //11
	
	 path2.close();
	
	 PolygonMesh3D mesh2(path2, height=thickness);//altura
	 mesh2.move((18mm, luzNave, -18mm));//ejes x , z , y
        
	 mesh2.setMaterial(getSharedLegMaterial.material3D);

	 //PARA TROQUELES ARRIBA NAVE LOCKER
 
	 APath2D path3((0mm, 1mm)); //1
	 path3.lineTo((0mm, f-1mm)); //2
	 path3.arcTo((1mm, f), 90deg); //3
	 path3.lineTo((w-1mm, f)); //4
	 path3.arcTo((w, f-1mm), 0deg); //5
	 path3.lineTo((w, 120mm)); //12
	 path3.lineTo(((w/2)-125mm, 120mm)); //13
	 path3.lineTo(((w/2)-125mm, 15mm)); //14
	 path3.lineTo(((w/2)+125mm, 15mm)); //15
	 path3.lineTo(((w/2)+125mm, 120mm)); //16
	 path3.lineTo((w, 120mm)); //17
	 path3.lineTo((w, 1mm)); //18
	 path3.arcTo((w-1mm, 0mm), -90deg); //19
	 path3.lineTo((1mm, 0mm)); //20
	 path3.arcTo((0mm, 1mm), -180deg); //11
	
	 path3.close();

	 PolygonMesh3D mesh3(path3, height=thickness);//altura
	 mesh3.move((18mm, luzNave, -18mm));//ejes x , z , y;
	 mesh3.setMaterial(getSharedLegMaterial.material3D);
        
	 double posicionTroquelUp = (nave1 + nivelador + borde + luzNave) -120mm;
	 if (punchFuntionPosition.up) {
	     prims << mesh1;
	     mesh1.move((0, nivelador + borde , 2mm)); //nivelador + borde = 26mm
	     mesh1.rotate((0deg, 0deg, 90deg));
	    
	     Primitive3D troquelRespuesta2 = troquel(env);
	     prims << troquelRespuesta2;
	     if (countFuntionDoors.nave1) {
		 troquelRespuesta2.move((w/2-(290mm/2)+ 18mm, 0, posicionTroquelUp ));
		 //troquelRespuesta2.move((w/2-(290mm/2)+ 18mm, 0, 1653mm ));
	     } else if (countFuntionDoors.nave2) {
		 posicionTroquelUp = (nave2 + nivelador + borde) -120mm;
		 troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0,  posicionTroquelUp + luzNave ));
	     } else if (countFuntionDoors.nave3) {
		 posicionTroquelUp = (nave3 + nivelador + borde) -120mm;
		 troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0, (posicionTroquelUp+luzNave)));
	     } else {
		 posicionTroquelUp = (nave4 + nivelador + borde) -120mm;
		 troquelRespuesta2.move((w/2-(290mm/2)+18mm, 0, (posicionTroquelUp+luzNave)));
	     }
	     //troquelRespuesta2.move((3mm, 0, 0));
	    
	     troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	 } else if (punchFuntionPosition().down) {
	     prims << mesh3;
	     mesh3.move((0, nivelador + borde , 2mm));
	     mesh3.rotate((0deg, 0deg, 90deg));
	     Primitive3D troquelRespuesta = troquelDown(env);
	     prims << troquelRespuesta;
	     troquelRespuesta.move((w/2-(290mm/2)+18mm , 0 , 50mm));
	     troquelRespuesta.move((0, 0, 3mm));
	     troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	 } else {
	     prims << mesh2;
	     mesh2.move((0, nivelador + borde , 2mm));
	     mesh2.rotate((0deg, 0deg, 90deg));
	     

	     /// troquel abajo
	     Primitive3D troquelRespuesta = troquelDown(env); // ejes x y z
	     troquelRespuesta.move((w/2-(290mm/2)+16mm , 0 , 50mm));
	     troquelRespuesta.move(( 2mm, 0 , 3mm));
	     troquelRespuesta.setMaterial(getSharedLegMaterial.material3D);
	     prims <<? troquelRespuesta;

	    

	    
	     Primitive3D troquelRespuesta2 = troquel(env);
	     //troquelRespuesta2.move((w/2-(290mm/2), 20mm, 0));
	     prims <<? troquelRespuesta2;
	     if (countFuntionDoors.nave1) {
		 troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp ));
	     } else if (countFuntionDoors.nave2) {
		 posicionTroquelUp = (nave2 + nivelador + borde) -117mm;
		 troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	     } else if (countFuntionDoors.nave3) {
		 posicionTroquelUp = (nave3 + nivelador + borde) -117mm;
		 troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	     } else {
		 posicionTroquelUp = (nave4 + nivelador + borde) -117mm;
		 troquelRespuesta2.move(((w/2)-(290mm/2)+18mm, 0, posicionTroquelUp));
	     }
	     //troquelRespuesta2.move((30mm, 10mm, 0));
	     troquelRespuesta2.setMaterial(getSharedLegMaterial.material3D);
	     //return  invisiblePrimitive3D;
	    

	 }
	
	 //
	 //prims <<? troquelRespuesta2;

	 if (!modulacionFuncionVigasCostados().ninguno) {
	    Primitive3D manijasEmbebidas= manija3D2(env);
	    manijasEmbebidas.move((0 , 20mm , 0));
	    prims <<? manijasEmbebidas;// groomet
	}

	if (!modulacionFuncionCerraduras().ninguno) {
	    Primitive3D cerraduraEmbebidas= cerraduraEmbebida3D(env);
	    cerraduraEmbebidas.move((0 , 20mm , 0));
	    prims <<? cerraduraEmbebidas;
	}


    
	 Primitive3D respuestaVisor3D = visor3D(env);
	 respuestaVisor3D.move((0, 18mm , 0));
	 prims <<? respuestaVisor3D;
	
	
	 Primitive3D p = Instance3D(prims);

	

 
	 return p;
	 //return null:
     }


 



     //////////
     //buil3ddoble

    public void build3D(FetchEnv3D env) {
	super(..);

	double ancho = w ;
	
        double moverACentro=(w/2);
	//double moverAFinal=(w/1.5) + 1.3mm;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;

	
	Primitive3D[] prims();
	Primitive3D[] prims2();
	Primitive3D tabiqueRespuesta = tabique(env) ;
	tabiqueRespuesta.move(((ancho/2)-16mm, 0, 35mm));
	prims2 <<? tabiqueRespuesta;
	//entrepaños 
	//Primitive3D entrepanoRespuesta = entrepano(env) ;
	//entrepanoRespuesta.move((w*2, 0, 35mm));
	//prims2 <<? entrepanoRespuesta;

	
	if (tipofuncionSuperficie()==0 ) {
	    prims2 <<?kitNave3DDoble(env);
	} else if (tipofuncionSuperficie()==1) {
	    //pln("no existe");
	    prims2 <<?kitNaveFormicaMelamina3DDoble(env);
	} else if (tipofuncionSuperficie()==2) {
	    //pln("no existe");
	    prims2 <<?kitNaveFormicaMelamina3DDoble(env);
	} else {
	    prims2 <<? kitNave3DEmbebidaDoble(env);
	    //pln("entro las embebidas");
	    //prims2 <<?kitNave3DEmbebida(env);
	}
	  

	

	//elevacionCoraza

	//model = safeInstance3D(prims);
	
        //pln("model" # model);


	Primitive3D kitNavesConZocalo = Instance3D(prims2);
	kitNavesConZocalo.move((0, 0, 10cm));


	if (zocaloLockerFuncion().verdadero) {
	    model = safeInstance3D([model] + prims + [kitNavesConZocalo] );

	} else {
	    model = safeInstance3D([model] + prims + prims2 );

	}
    }

    
    /**
     * Domain.
     */
    //Los parametro de las dimensiones de la mesa. Que tanto puede crece
    // el grommet y el tubo no se estira en lo ancho
    // la sobrecapa y las patas no se ponen si estiro largo

    public SubSet dimensionDomain(str id) {


	if (isSpecial) {
	    if (id == "b") return DoubleStepRange(60cm, 100cm, 1cm);
	    if (id == "s") return DoubleStepRange(30cm, 50cm, 1cm); //22-08-2023
	    if (id == "h") return DoubleStepRange(165cm, 220cm, 1cm);
	} else {

	    if (id == "b") return DoubleEnum(80cm, 100cm);
	    if (id == "s") return DoubleEnum(50cm);
	    if (id == "h") return DoubleEnum(180cm, 220cm);
	    
	}

	return null;
    }
     

    // Este es GetPartCoraza del Doble--------------

    public MplPart getPartCoraza(PartsEnv env) {

	double alturaReal= h * 100;
	double altura= 0;
	if (alturaReal <=180) {
	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal = w*100;
	double ancho= 0 ;
	if (anchoReal <=80) {
	    ancho = 80;
	} else if (anchoReal >80 and anchoReal<=100) {
	    ancho = 100;
	    
	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
	
	StrBuf buf();
	buf << "LOCKERCORAZA2P_" # ancho # "_" # profundidad # "_" # altura # "_" # calibreReal;

	//return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1, todo ); // para el especial
	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1, descripcionSpecial);
	    // Crear el espacial Manual:
	    //JeisonCoraza
	    //StrBuf buf4(super(this));
	    
	    // pln("buf 2: " # buf4);
	    //MplDescriptiveSpecOption
	    //return PriRectWsSpecialPart(this, buf.toS, getOptionsMaterialsCoraza(),  quantity=1);
	    return MplSpecialPartCoraza(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=true);
	} else {


	    //return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1);
	    return MplSpecialPartCoraza(this, buf.toS , getOptionsMaterialsCoraza, withSpecialWord=false);


	}
	return MplPart(this, buf.toS, getOptionsMaterialsCoraza() , quantity=1);
    }

    public MplPart getPartManijas(PartsEnv env) {

	StrBuf buf();
	buf << "LOCKER";

        if (modulacionFuncionVigasCostados()==0) {
