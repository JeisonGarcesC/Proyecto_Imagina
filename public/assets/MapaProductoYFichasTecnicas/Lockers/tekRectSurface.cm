    extend public Primitive3D manija3D2(FetchEnv3D env) {
	
        
	//c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D
	
	
        double alturaTotal = h ;
	double luzNave = 2mm ;
	double altura = alturaTotal - 16mm - 26mm ;

	if (tipofuncionSuperficie == 3) {
	    luzNave = 3mm;
	    altura = alturaTotal - 25mm - 35mm ;

	}
	if (countFuntionDoors() == 0) {
	    altura= altura/2 - (luzNave * 2);
	} else if (countFuntionDoors() == 1) {
	    altura= ((altura - (luzNave * 4)) / 4);
	} else if (countFuntionDoors() == 2) {
	    //altura= (alturaTotal/8)+5cm;
	    altura= ((altura - (luzNave * 6)) / 6);
	} else if (countFuntionDoors() == 3) {
	    altura= ((altura - (luzNave * 8)) / 8);
	}

	
	//str url = "c:/CetDev/version14.0/extensions/custom/mepal/furniture/worksurfaces/lockers/res/models/" # cm3dM # ".cm3D";
	Primitive3D cache = cache3D(cm3DFileNameManija(), env.detail, w,  getGrommetMaterial, altura) {

	    //cm= aqui me trajo el objeto correspondiente en 3D
	    //c:\CetDev\version13.5\extensions\custom\mepal\furniture\worksurfaces\tek\res\models\TKAC240000_120.cm3D
	    Primitive3D[] prims();

	    Cm3D cm = getCm3D(urlManija());

	    //mplGetCM3DPrimByID= ESto me retorna el objeto grommet final en si, no en cache
	    //pln("el cm: " # cm);
	    Primitive3D manija = mplGetCM3DPrimByID(env, "2", null, cm);
	    //Primitive3D manijaLlave = mplGetCM3DPrimByID(env, "6", null, cm);

	    /////// abelmanijas
	    /*
	    if (modulacionFuncionVigasCostados() == 0) {
		manija.move((4cm, -21mm, altura));
	    } else if (modulacionFuncionVigasCostados() == 1) {
		manija.move((21mm, -28mm, altura-50mm));
	    } else if (modulacionFuncionVigasCostados() == 2) {
		manija.move((5cm, -36mm, altura));
	    } else if (modulacionFuncionVigasCostados() == 3) {
		manija.move((4cm, -21mm, altura));
	    } else {
		manija.move((4cm, -21mm, altura));
	    }
	    */
	    if (modulacionFuncionVigasCostados() == 0) {
		if (countFuntionDoors.nave1) {
		    manija.move((65.5mm, -21mm, altura - 12.5mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 10.5mm));
		    }
		} else if (countFuntionDoors.nave2) {
		    manija.move((65.5mm, -21mm, altura - 15mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 5mm));
		    }
		} else if (countFuntionDoors.nave3) {
		    manija.move((65.5mm, -21mm, altura - 15mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 4mm));
		    }
		} else {
		    manija.move((65.5mm, -21mm, altura - 15mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 3mm));
		    }
		}

		
	    } else if (modulacionFuncionVigasCostados() == 1) {
		//manija.move((2cm, -20mm, altura));
		
		if (countFuntionDoors.nave1) {
		    manija.move((76mm, -28mm, altura + 20.5mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 11mm));
		    }
		} else if (countFuntionDoors.nave2) {
		    manija.move((76mm, -28mm, altura + 18mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 6mm));
		    }
		} else if (countFuntionDoors.nave3) {
		    manija.move((76mm, -28mm, altura + 18mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 4mm));
		    }
		} else {
		    manija.move((76mm, -28mm, altura + 18mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 3mm));
		    }
		}
		
	    } else if (modulacionFuncionVigasCostados() == 2) {
		

		if (countFuntionDoors.nave1) {
		    manija.move((74mm , -36mm, altura - 45mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 11mm));
		    }
		} else if (countFuntionDoors.nave2) {
		    manija.move((74mm , -36mm, altura - 47.5mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 6mm));
		    }
		} else if (countFuntionDoors.nave3) {
		    manija.move((74mm , -36mm, altura - 47.5mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 4mm));
		    }
		} else {
		    manija.move((74mm , -36mm, altura - 47.5mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 3mm));
		    }
		}
		//manijaLlave.move((50mm, -36mm, altura));
	    } else if (modulacionFuncionVigasCostados() == 3) {
		
		if (countFuntionDoors.nave1) {
		    manija.move((70mm, -21mm, altura - 66.5mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 11mm));
		    }
		} else if (countFuntionDoors.nave2) {
		    manija.move((70mm , -21mm, altura - 69mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 6mm));
		    }
		} else if (countFuntionDoors.nave3) {
		    manija.move((70mm , -21mm, altura - 69mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 4mm));
		    }
		} else {
		    manija.move((70mm , -21mm, altura - 69mm));
		    if (tipofuncionSuperficie == 3) {
			manija.move((0mm, 0mm, 3mm));
		    }
		}
		//manijaLlave.move((40mm, -21mm, altura));
	    } else {
		//manija.move((2cm, -22mm, altura));
	    }
	    
	    prims << manija;
	    Primitive3D prim = safeInstance3D(prims);
	    
	    result prim;
	};
	//cache.setMaterial(aluminumMaterial3D);
	return cache;
    }

