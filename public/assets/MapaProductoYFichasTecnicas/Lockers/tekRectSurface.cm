    // build2D coraza doble
    ///////////////////////////////////////////


    public GInstance kitNave2D() {
	GInstance kitNave2D();
	//kitNave2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)));
	kitNave2D << GRect(rect((2mm, 2mm), ((w/2)-2mm, 18mm)), fillColor=gray);
	kitNave2D << GRect(rect(((w/2)+2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	//kitNave2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	kitNave2D.move((0, -ls-2cm-2mm , 0));//
	return kitNave2D;
    }

    public GInstance kitNaveEmbebida2D() {
	GInstance kitNaveEmbebida2D();
	double thickness = 16mm ;
	double luzNave = 2mm ;
	double costado = 16mm ;
	double ancho = w ;
	double prof = ls ;
	double tabique = 32mm ;
	
	kitNaveEmbebida2D << GRect(rect(((costado + luzNave), 0mm), ((w-((tabique + (luzNave*2))))/2, thickness)), lineType=LineType(black, lineStyle.dot));
	kitNaveEmbebida2D << GRect(rect((((w+(tabique + (luzNave*2)))/2) , 0mm), ((w-((costado + luzNave)), thickness))), lineType=LineType(black, lineStyle.dot));
	kitNaveEmbebida2D.setRefinement(24);
	kitNaveEmbebida2D.move((0, -ls , 0));//
	return kitNaveEmbebida2D;
    }
 
    public GInstance tabique2D() {
	GInstance tabique2D();
	LineType lineType(color(50, 50, 50), lineStyle.thick);
	color fillColor = black;// whiteWiredDuct ? white : black;
	tabique2D << GRect(rect(((w/2)-16mm, 23mm), ((w/2)+16mm, ls+20mm)), lineType=LineType(black, lineStyle.dot));
	// Tambien para Lineas punteadas. visibleDotLineType(black) 
	//tabique2D << GRect(rect((2mm, 2mm), (w-2mm, 18mm)), fillColor=gray);
	tabique2D.move((0, -ls-2cm-2mm , 0));//
	//return kitNave2D;
	return tabique2D;


	//return null;
    }


}

