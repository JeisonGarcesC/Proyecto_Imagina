     * ¿Permitir adjuntar?
     * Credenzas
     */
    public bool allowAttach(Connector a, Connector s) {
	if (a as WorksurfaceConnectLine) {
	   
	}
	return MplWorksurface.allowAttach(this, a, s);
	//return false;// no se conectan los snappers
	
