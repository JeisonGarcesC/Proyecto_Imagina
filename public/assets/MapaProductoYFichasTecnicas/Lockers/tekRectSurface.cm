	    cantidadKitNave= 4;
	}

	StrBuf buf();
	buf << "LOCKERKITNAVE" # cantidadKitNave # "PLAMAP_" # ancho # "_" # profundidad #  "_" # altura # "_" # calibreReal ;
	
	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico() , quantity=cantidadVisor, descripcionSpecial);
