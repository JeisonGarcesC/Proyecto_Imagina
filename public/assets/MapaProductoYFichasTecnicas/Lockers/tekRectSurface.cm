    public MplPart getPartKitNaveMetalica(PartsEnv env) {

	double alturaReal= h * 100;
	double altura= 0;
	if (alturaReal <=180) {
	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal= (w/2)*100;
	double ancho= 0;
	if (anchoReal <=40) {
	    ancho = 50;
	} else if (anchoReal >40 and anchoReal<=50) {
	    ancho = 50;

	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
        
	double cantidadVisor= 0;

	double cantidadKitNave=0;

	if (countFuntionDoors()==0) {
	    cantidadVisor= 1 * 2;
	    cantidadKitNave= 1;
	} else if (countFuntionDoors()==1) {
	    cantidadVisor= 2 * 1;
	    cantidadKitNave= 2;
	} else if (countFuntionDoors()==2) {
	    cantidadVisor= 2 * 1;
	    cantidadKitNave= 3;
	} else if (countFuntionDoors()==3) {
	    cantidadVisor= 2 * 1;
	    cantidadKitNave= 4;
	}

	StrBuf buf();
	buf << "LOCKERKITNAVE" # cantidadKitNave # "PLAMAP_" # ancho # "_" # profundidad # "_" # altura # "_" # calibreReal ;


	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico() , quantity=cantidadVisor, descripcionSpecial);
	    //return PriRectWsSpecialPart(this, buf.toS, getOptionsMaterialsKitNaveMetalico(),  quantity=cantidadVisor);
	    return MplSpecialPartJeisonSpecialNaveDoble(this, buf.toS , getOptionsMaterialsKitNaveMetalico, quantity=cantidadVisor , withSpecialWord=true);
	} else {

	    /***************************************************************
	     * 13/11/2024 
	     * roob se cambia el return
	     ***************************************************************/
	    
	    //return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	    return MplSpecialPartJeisonSpecialNaveDoble(this, buf.toS , getOptionsMaterialsKitNaveMetalico, quantity=cantidadVisor , withSpecialWord=false);
	}
	return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveMetalico(), quantity=cantidadVisor);
	 
    }


