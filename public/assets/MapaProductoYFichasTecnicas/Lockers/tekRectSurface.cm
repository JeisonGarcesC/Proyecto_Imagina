    /**
     * Auto generate supports.
     * Auto generar soportes.
     */
    public void autoGenerateSupports() {
	super();
	deleteUnneededSupports();
    }


    public MplCabinet[] findUnneededSupports() {
	MplCabinet[] cabs();
	MplWorksurface[] wss();
	wss << this;
	//pln("lo que es wss: " # wss);
	for (n in neighbors) {
	    //pln("lo que hay en n: " # n);
	    if (n as MplWorksurface) wss << n;
	}

	for (ws in wss) {
	    for (cl in ws.connectLines) {
		for (s in cl.connectedSnappers()) {
		    if (cl as WorksurfaceConnectLine) {
			if (cl.edgeId == cTekWSEdgeIdRight) {
			    rightCredenza = true;
			} else if (cl.edgeId == cTekWSEdgeIdLeft) {
			    rightCredenza = false;
			}
		    }
		    //if (s as PymPedestal) {
		    //pln("encontramos pedestales");
		    //}
		    if (s as MplCabinet) {
			/*if (s as TekPedestal) {
			    //pln("Se puso un pedestal en find :");
			} else {
			    cabs << s;
			    }*/
			cabs << s;
			
			//pln("la vaina esta de s" # s);
		    }
		}
	    }
	}
	
        
	//ojo jeison cuidado
	//
	//pln("cabs: " # cabs);
	return cabs;
	//return null;
    }
    


    extend public void deleteUnneededSupports() {
	MplCabinet[] cabs();
	MplWorksurface[] wss();
	wss << this;
	//pln("Lista de wss: " # wss); // me devuelve la linea  [MplWorksurface, count=1: TekRectSurface(*dead*, space==null (id=-304, orig))]
	for (n in neighbors) {
	    //pln("Lista de n: " # n); // me devuelve todas las clases que se usan o objetos
	    if (n as MplWorksurface) {
		wss << n;
		//pln("Lista de wss: " # wss);
	    }
	}
	for (ws in wss) {
	    //pln("Lista de ws: " # ws); //TekRectSurface((id=98, copy=76))
	    for (cl in ws.connectLines) {
		//pln("Lista de cl: " # cl);//WorksurfaceConnectLine(ls, TekRectSurface(*dead*, space==null (id=-402, orig)), "sbRule")
		for (s in cl.connectedSnappers()) {
		    //pln("Lista de s: " # s); //  conexiones laterales
		    if (s as MplCabinet) {
			cabs << s;
		    }
		    
		}
	    }
	}
	
	for (cab in cabs) {
	    for (sup in supports) {
		//pln("Lista de sup: " # sup);//todos los objetos de soporte
		if (sup in MplSharedLeg) {
		    if (sup.spaceBound(this).intersects(cab.userBound.rect)) {
			support.removeSupport(sup);
		    }
		    if (sup in TekPaintedIntermediateLeg) {
			support.removeSupport(sup);
		    }
		}

		if (sup in MplSharedSC) {
		    //pln("Lista de sup: " # sup);
		    if (sup.spaceBound(this).intersects(cab.userBound.rect)) {
			support.removeSupport(sup);
		    }
		}

	    }
	}
    }

 
    /**
     * Connected.
     * conectores
     */

    public void connected(Connector c0, Connector c1, bool snapped, bool attached) {
	super(..);
	
	setDrawDoubleFlag(c1.?snapper.?TekRectSurface);

	if (c1.snapper in MplModestyScreen or c1.snapper in MplWorksurface) invalidate;
	//pln("MplModestyScreen:" # c1.snapper);
	//pln("MplModestyScreen cq:" # cq.snapper);
	// Aqui en cq.snapper -> TekStraightCornerIntegrationWorksurface((id=44, copy=13)) -> llega "SC"
	if (?TekRectSurface rSurf = c1.snapper) {
	    
	    rSurf.invalidate3D;
	}
	rebuildQuickPropertiesIfVisible;
    }


    /**
     * Disconnected.
     * Desconectado
     */
    public void disconnected(Connector c0, Connector c1, bool wasSnapped, bool wasAttached) {
	super(..);
	setDrawDoubleFlag(c1.?snapper.?TekRectSurface);
	/*if (c1.snapper in TekBaseCredenza) {
	    buildPath(force=true);
	    }*/
	if (c1.snapper in MplModestyScreen or c1.snapper in MplWorksurface) invalidate;
	rebuildQuickPropertiesIfVisible;
    }


    /**
     * Set draw double flag.
     * Establecer dibujar doble bandera.
     */
    extend public void setDrawDoubleFlag(TekRectSurface ws) {
	if (ws) {
	    if (ws == getSurfaceOnEdge("b")) {
		if (ws.drawDoubleCableDuct) {
		    drawDoubleCableDuct = false;
		} else {
		    drawDoubleCableDuct = true;
		}
	    }
	}
    }


