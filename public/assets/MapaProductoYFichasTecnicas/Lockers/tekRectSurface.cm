    public bool useNewEdge() { return false; }

    public Primitive3D get3D(FetchEnv3D env) {
	return super(..);
    }
    
    /**
     * Build 3D.
     * Construir 3D
     */
    
    extend public Primitive3D kitNave3D(FetchEnv3D env) {

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;

	Primitive3D top3D = cache3D(env.detail , punchFuntionPosition , countFuntionDoors , h , punchFuntionPosition() , punchPosition , punchFuntionType() , punchType, modulacionTipoCerraduras, modulacionFuncionCerraduras(), modulacionVigasCostados, modulacionVigasCostados, modulacionFuncionVigasCostados() , getSharedLegMaterial, visor, visorFuncion() , w , ls , tipofuncionSuperficie() , tipoSuperficie ) {


	    Primitive3D[] prims();

	
	    //naves lisas
	    Primitive3D kitNave1Respuesta = kitNave(env);
	    Primitive3D kitNave2Respuesta = kitNave(env);
	    Primitive3D kitNave3Respuesta = kitNave(env);
	    Primitive3D kitNave4Respuesta = kitNave(env);
	    
	
	    //naves troqueladas
	    Primitive3D kitNaveTroquel1Respuesta = kitNaveTroquel(env) ;
	    Primitive3D kitNaveTroquel2Respuesta = kitNaveTroquel(env) ;
	    Primitive3D kitNaveTroquel3Respuesta = kitNaveTroquel(env) ;
	    Primitive3D kitNaveTroquel4Respuesta = kitNaveTroquel(env) ;
	
	    //naves lisas
	    if (punchFuntionPosition.none) {
	    
		if (countFuntionDoors.nave1) {
		    prims <<? kitNave1Respuesta;
		} else if (countFuntionDoors.nave2) {
		    prims <<? kitNave1Respuesta;
		    kitNave2Respuesta.move((0, 0, nave2 + (luzNave)));
		    prims <<? kitNave2Respuesta;
		} else if (countFuntionDoors.nave3) {
		    prims <<? kitNave1Respuesta;
		    kitNave2Respuesta.move((0, 0, nave3 + (luzNave)));
		    prims <<? kitNave2Respuesta;
		    kitNave3Respuesta.move(((0, 0, nave3 + (luzNave))*2));
		    prims <<? kitNave3Respuesta;
		} else {
		    prims <<? kitNave1Respuesta;
		    kitNave2Respuesta.move((0, 0, nave4 + (luzNave)));
		    prims <<? kitNave2Respuesta;
		    kitNave3Respuesta.move(((0, 0, nave4 + (luzNave))*2));
		    prims <<? kitNave3Respuesta;
		    kitNave4Respuesta.move(((0, 0, nave4 + (luzNave))*3));
		    prims <<? kitNave4Respuesta;
		}
	    
		//naves troqueladas
	    } else {
		if (countFuntionDoors.nave1) {
		    prims <<? kitNaveTroquel1Respuesta;
		} else if (countFuntionDoors.nave2) {
		    prims <<? kitNaveTroquel1Respuesta;
		    kitNaveTroquel2Respuesta.move((0, 0, nave2 + (luzNave)));
		    prims <<? kitNaveTroquel2Respuesta;
		} else if (countFuntionDoors.nave3) {
		    prims <<? kitNaveTroquel1Respuesta;
		    kitNaveTroquel2Respuesta.move((0, 0, nave3 + (luzNave)));
		    prims <<? kitNaveTroquel2Respuesta;
		    kitNaveTroquel3Respuesta.move(((0, 0, nave3 + (luzNave))*2));
		    prims <<? kitNaveTroquel3Respuesta;
		} else {
		    prims <<? kitNaveTroquel1Respuesta;
		    kitNaveTroquel2Respuesta.move((0, 0, nave4 + (luzNave)));
		    prims <<? kitNaveTroquel2Respuesta;
		    kitNaveTroquel3Respuesta.move(((0, 0, nave4 + (luzNave))*2));
		    prims <<? kitNaveTroquel3Respuesta;
		    kitNaveTroquel4Respuesta.move(((0, 0, nave4 + (luzNave))*3));
		    prims <<? kitNaveTroquel4Respuesta;
		}
	    

	    }

	    
	    //kitNave1Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    //kitNave2Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    //kitNave3Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    //kitNave4Respuesta.setMaterial(getSharedLegMaterial.material3D);
	    
	    result prims.any ? Instance3D(prims) : invisiblePrimitive3D;
	    

	};

	
	
	return top3D;
      
    }

    /**********************************************************************
      *roob : 12/12/2023
      *nave puertas en formica y melamina , construye el kit nave del
      *locker individual
      **********************************************************************/
    
    extend public Primitive3D kitNaveFormicaMelamina3D(FetchEnv3D env) {

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;

	Primitive3D top3D = cache3D(env.detail , countFuntionDoors , h , modulacionTipoCerradurasMadera , modulacionTipoCerraduras, modulacionFuncionCerradurasMadera() , modulacionFuncionCerraduras(), modulacionVigasCostados, modulacionFuncionVigasCostados() , getSharedLegMaterial, visor, visorFuncion() , w , ls , tipofuncionSuperficie() , tipoSuperficie, getEdgeMaterial, getMaterial, manijasMadera, manijasFuncionMadera()   ) {


	    Primitive3D[] prims();

	
	    //naves lisas
	    Primitive3D kitNaveFormicaMelamina1Respuesta = kitNaveFormicaMelamina(env);
	    Primitive3D kitNaveFormicaMelamina2Respuesta = kitNaveFormicaMelamina(env);
	    Primitive3D kitNaveFormicaMelamina3Respuesta = kitNaveFormicaMelamina(env);
	    Primitive3D kitNaveFormicaMelamina4Respuesta = kitNaveFormicaMelamina(env);

	    //canto termofundido 2mm
	    Primitive3D cantoFormicaMelamina1Respuesta = canto2(env);
	    Primitive3D cantoFormicaMelamina2Respuesta = canto2(env);
	    Primitive3D cantoFormicaMelamina3Respuesta = canto2(env);
	    Primitive3D cantoFormicaMelamina4Respuesta = canto2(env);
	    
	   
	    //naves lisas
	    //if (punchFuntionPosition.none) {
	    
	    if (countFuntionDoors.nave1) {
		prims <<? kitNaveFormicaMelamina1Respuesta;
		prims <<? cantoFormicaMelamina1Respuesta;

	    } else if (countFuntionDoors.nave2) {
		prims <<? kitNaveFormicaMelamina1Respuesta;
		prims <<? cantoFormicaMelamina1Respuesta;
		prims <<? kitNaveFormicaMelamina2Respuesta;
		kitNaveFormicaMelamina2Respuesta.move((0, 0, nave2 + (luzNave)));
		prims <<? cantoFormicaMelamina2Respuesta;
		cantoFormicaMelamina2Respuesta.move((0, 0, nave2 + (luzNave)));
		    
	    } else if (countFuntionDoors.nave3) {
		prims <<? kitNaveFormicaMelamina1Respuesta;
		prims <<? cantoFormicaMelamina1Respuesta;
		prims <<? kitNaveFormicaMelamina2Respuesta;
		kitNaveFormicaMelamina2Respuesta.move((0, 0, nave3 + (luzNave)));
		prims <<? cantoFormicaMelamina2Respuesta;
		cantoFormicaMelamina2Respuesta.move((0, 0, nave3 + (luzNave)));
		prims <<? kitNaveFormicaMelamina3Respuesta;
		kitNaveFormicaMelamina3Respuesta.move(((0, 0, nave3 + (luzNave))*2));
		prims <<? cantoFormicaMelamina3Respuesta;
		cantoFormicaMelamina3Respuesta.move(((0, 0, nave3 + (luzNave))*2));
		    
	    } else {
		prims <<? kitNaveFormicaMelamina1Respuesta;
		prims <<? cantoFormicaMelamina1Respuesta;
		prims <<? kitNaveFormicaMelamina2Respuesta;
		kitNaveFormicaMelamina2Respuesta.move((0, 0, nave4 + (luzNave)));
		prims <<? cantoFormicaMelamina2Respuesta;
		cantoFormicaMelamina2Respuesta.move((0, 0, nave4 + (luzNave)));
		prims <<? kitNaveFormicaMelamina3Respuesta;
		kitNaveFormicaMelamina3Respuesta.move(((0, 0, nave4 + (luzNave))*2));
		prims <<? cantoFormicaMelamina3Respuesta;
		cantoFormicaMelamina3Respuesta.move(((0, 0, nave4 + (luzNave))*2));
		prims <<? kitNaveFormicaMelamina4Respuesta;
		kitNaveFormicaMelamina4Respuesta.move(((0, 0, nave4 + (luzNave))*3));
		prims <<? cantoFormicaMelamina4Respuesta;
		cantoFormicaMelamina4Respuesta.move(((0, 0, nave4 + (luzNave))*3));
		    
	    }
	    
        
	    
	    result prims.any ? Instance3D(prims) : invisiblePrimitive3D;
	    

	};

	
	
	return top3D;
      
    }


    /***********************************************************************
     * 14/12/2023 : roob
     * le pertenece a la clase locker individual
     * metodo extend original
     * genera la nave embebida sin troquelados
     *
     ***********************************************************************/
    
     extend public Primitive3D kitNave3DEmbebida(FetchEnv3D env) {

	//naves
	double borde = 25mm;//medida de la tapa superior / inferior 
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)-(2*luzNave)- nivelador;
	double nave2 = (nave1 - (luzNave*2) - (entrepano)) / 2;
	double nave3 = (nave1 - (luzNave*4) - (entrepano*2)) /3;
	double nave4 = (nave1 - (luzNave*6) - (entrepano*3)) /4;

	//pln("cuanto es altura actual : ....  " # alturaActual );
	//pln("cuanto es nave1 : ....  " # nave1 );
	//pln("cuanto es nave2 : ....  " # nave2 );
	//pln("cuanto es nave3 : ....  " # nave3 );
	//pln("cuanto es nave4 : ....  " # nave4 );

	Primitive3D top3D = cache3D(env.detail , punchFuntionPosition , countFuntionDoors , h , punchFuntionPosition() , punchPosition , punchFuntionType() , punchType, modulacionTipoCerraduras, modulacionFuncionCerraduras(), modulacionVigasCostados, modulacionVigasCostados, modulacionFuncionVigasCostados() , getSharedLegMaterial, visor, visorFuncion() , w , ls , tipofuncionSuperficie() , tipoSuperficie ) {


	    /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	    ///// naves embebidas 3D
	    ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	    //naves lisas embebidas

	    Primitive3D[] primsEmbebidas();


	    Primitive3D kitNaveEmbebida1Respuesta = kitNaveEmbebida(env) ;
	    Primitive3D kitNaveEmbebida2Respuesta = kitNaveEmbebida(env) ;
	    Primitive3D kitNaveEmbebida3Respuesta = kitNaveEmbebida(env) ;
	    Primitive3D kitNaveEmbebida4Respuesta = kitNaveEmbebida(env) ;

	    //naves troqueladas
	    
	    Primitive3D kitNaveTroquel1Respuesta = kitNaveTroquelEmbebida(env) ;
	    Primitive3D kitNaveTroquel2Respuesta = kitNaveTroquelEmbebida(env) ;
	    Primitive3D kitNaveTroquel3Respuesta = kitNaveTroquelEmbebida(env) ;
	    Primitive3D kitNaveTroquel4Respuesta = kitNaveTroquelEmbebida(env) ;
	    

	    //kitNaveEmbebida1Respuesta.move((18mm, 0, 10mm));




	    //naves lisas Embebidas
	    if (punchFuntionPosition.none) {
	    
		if (countFuntionDoors.nave1) {
		    kitNaveEmbebida1Respuesta.move((0 , 0, 0));
		    primsEmbebidas <<? kitNaveEmbebida1Respuesta;

		} else if (countFuntionDoors.nave2) {
		    primsEmbebidas <<? kitNaveEmbebida1Respuesta;
		    primsEmbebidas<<? kitNaveEmbebida2Respuesta;
		    kitNaveEmbebida2Respuesta.move((0, 0, nave2 + (entrepano+(luzNave*2))));
		    
		} else if (countFuntionDoors.nave3) {
		    primsEmbebidas<<? kitNaveEmbebida1Respuesta;
		    primsEmbebidas<<? kitNaveEmbebida2Respuesta;
		    kitNaveEmbebida2Respuesta.move((0, 0, nave3 + (entrepano+(luzNave*2))));
		    primsEmbebidas<<? kitNaveEmbebida3Respuesta;
		    kitNaveEmbebida3Respuesta.move(((0, 0, (nave3*2) + ((entrepano*2)+(luzNave*4)))));
		    
		} else {
		    primsEmbebidas<<? kitNaveEmbebida1Respuesta;
		    primsEmbebidas<<? kitNaveEmbebida2Respuesta;
		    kitNaveEmbebida2Respuesta.move((0, 0, nave4 + (entrepano+(luzNave*2))));
		    primsEmbebidas<<? kitNaveEmbebida3Respuesta;
		    kitNaveEmbebida3Respuesta.move(((0, 0, (nave4*2) + ((entrepano*2)+(luzNave*4)))));
		    primsEmbebidas<<? kitNaveEmbebida4Respuesta;
		    kitNaveEmbebida4Respuesta.move(((0, 0, (nave4*3) + ((entrepano*3)+(luzNave*6)))));
		    
		}
	    
		//naves troqueladas Embebidas
	    } else {
		if (countFuntionDoors.nave1) {
		    kitNaveTroquel1Respuesta.move((0 , 0, 0));
		    primsEmbebidas<<? kitNaveTroquel1Respuesta;
		} else if (countFuntionDoors.nave2) {
		    primsEmbebidas<<? kitNaveTroquel1Respuesta;
		    primsEmbebidas<<? kitNaveTroquel2Respuesta;
		    kitNaveTroquel2Respuesta.move((0, 0, nave2 + (entrepano+(luzNave*2))));
		    
		} else if (countFuntionDoors.nave3) {
		    primsEmbebidas<<? kitNaveTroquel1Respuesta;
		    primsEmbebidas<<? kitNaveTroquel2Respuesta;
		    kitNaveTroquel2Respuesta.move((0, 0, nave3 + (entrepano+(luzNave*2))));
		    primsEmbebidas<<? kitNaveTroquel3Respuesta;
		    kitNaveTroquel3Respuesta.move(((0, 0, (nave3*2) + ((entrepano*2)+(luzNave*4)))));
		    
		} else {
		    primsEmbebidas<<? kitNaveTroquel1Respuesta;
		    primsEmbebidas<<? kitNaveTroquel2Respuesta;
		    kitNaveTroquel2Respuesta.move((0, 0, nave4 + (entrepano+(luzNave*2))));
		    primsEmbebidas<<? kitNaveTroquel3Respuesta;
		    kitNaveTroquel3Respuesta.move(((0, 0, (nave4*2) + ((entrepano*2)+(luzNave*4)))));
		    primsEmbebidas<<? kitNaveTroquel4Respuesta;
		    kitNaveTroquel4Respuesta.move(((0, 0, (nave4*3) + ((entrepano*3)+(luzNave*6)))));
		    
		}
	    
	    }

	    
	    result primsEmbebidas.any ? Instance3D(primsEmbebidas) : invisiblePrimitive3D;
	    

	};

	
	//top3D.setMaterial(getSharedLegMaterial.material3D);
	return top3D;
      
     }

     extend public Primitive3D kitAnclajePared3D(FetchEnv3D env) {

        

	 Primitive3D top3D = cache3D(env.detail , h , getSharedLegMaterial , w , ls , getAccessoriesMaterial, isSpecial ) {
	    

	    //entrepanos

	    Primitive3D[] primsAnclajes();

	    Primitive3D kitAnclajeRespuesta = anclajePared(env) ;
	   
	    if (isSpecial) {

		if (ls <= 0.4) {
		    primsAnclajes << kitAnclajeRespuesta;
		}
		    
	    } else {
	        
		
	    }
	    
	    result primsAnclajes.any ? Instance3D(primsAnclajes) : invisiblePrimitive3D;
	    

	};

	
	//top3D.setMaterial(getSharedLegMaterial.material3D);
	return top3D;
      
    }

     extend public Primitive3D kitEntrepano3D(FetchEnv3D env) {

	//naves
	double borde = 25mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 3mm;//medida de luz entre naves
	double entrepano = 20mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;

	Primitive3D top3D = cache3D(env.detail , countFuntionDoors , h , getSharedLegMaterial , w , ls , tipofuncionSuperficie() , tipoSuperficie, getAccessoriesMaterial ) {
	    /*
	    //entrepaños
	    Primitive3D entrepanoRespuesta = entrepano(env) ;
	    entrepanoRespuesta.move((1mm, 0mm, alturaActual/2-5mm));
	    prims <<? entrepanoRespuesta;
	    */

	    /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	    ///// entrepano  3D
	    ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	    //entrepanos

	    Primitive3D[] primsEntrepanos();


	    //Primitive3D kitEntrepano1Respuesta = kitNaveEmbebida(env) ;
	    Primitive3D kitEntrepano2Respuesta = kitEntrepano(env) ;
	    Primitive3D kitEntrepano3Respuesta = kitEntrepano(env) ;
	    Primitive3D kitEntrepano4Respuesta = kitEntrepano(env) ;
	    /*
	    //naves troqueladas
	    
	    Primitive3D kitNaveTroquel1Respuesta = kitNaveTroquelEmbebida(env) ;
	    Primitive3D kitNaveTroquel2Respuesta = kitNaveTroquelEmbebida(env) ;
	    Primitive3D kitNaveTroquel3Respuesta = kitNaveTroquelEmbebida(env) ;
	    Primitive3D kitNaveTroquel4Respuesta = kitNaveTroquelEmbebida(env) ;
	    */

	    //kitNaveEmbebida1Respuesta.move((18mm, 0, 10mm));

	    if (countFuntionDoors.nave1) {
		    /*
		    kitNaveEmbebida1Respuesta.move((0 , 0, 0));
		    primsEntrepanos <<? kitNaveEmbebida1Respuesta;
		    */
	    } else if (countFuntionDoors.nave2) {
		    //primsEntrepanos <<? kitNaveEmbebida1Respuesta;
		primsEntrepanos<<? kitEntrepano2Respuesta;
		//kitEntrepano2Respuesta.rotate((0deg, 0deg, 90deg));
		kitEntrepano2Respuesta.move((1mm, 0, nave2 + (entrepano+(luzNave*2)+0.5mm)));
		    
	    } else if (countFuntionDoors.nave3) {
		//primsEmbebidas<<? kitNaveEmbebida1Respuesta;
		kitEntrepano2Respuesta.move((1mm, 0, nave3 + (entrepano+(luzNave)+0.5mm)));
		primsEntrepanos<<? kitEntrepano2Respuesta;
		kitEntrepano3Respuesta.move(((1mm, 0, (nave3*2) + (entrepano+(luzNave*4)))));
		primsEntrepanos<<? kitEntrepano3Respuesta;
	    } else {
		//primsEmbebidas<<? kitNaveEmbebida1Respuesta;
		primsEntrepanos<<? kitEntrepano2Respuesta;
		kitEntrepano2Respuesta.move((1mm, 0, nave4 + (entrepano+(luzNave)) -1mm));
		primsEntrepanos<<? kitEntrepano3Respuesta;
		kitEntrepano3Respuesta.move(((1mm, 0, (nave4*2) + (entrepano+(luzNave*4)) - 2.5mm)));
		primsEntrepanos<<? kitEntrepano4Respuesta;
		kitEntrepano4Respuesta.move(((1mm, 0, (nave4*3) + (entrepano+(luzNave*6)) - 1.5mm)));
		
	    }
	    
	    result primsEntrepanos.any ? Instance3D(primsEntrepanos) : invisiblePrimitive3D;
	    

	};

	
	//top3D.setMaterial(getSharedLegMaterial.material3D);
	return top3D;
      
    }
    
    //////buil3dindividual



     public void build3D(FetchEnv3D env) {
	 //super(env);
	double i = 1;
	double count = 2;

	//naves
	double borde = 16mm;//medida de borde de tapa superior / inferior a primer arista de nave
	//double anchoNave = ancho - 4mm;//medida de borde de tapa superior / inferior a primer arista de nave
	double nivelador = 10mm;//medida desde piso a tapa inferior
	double luzNave = 2mm;//medida de luz entre naves
	//double alturaTapas = 25mm;//medida desde piso a tapa inferior
	//double alturaCoraza = altura - alturaTapas - nivelador;//medida de altura coraza
	//double nave1 = alturaActual - (2*borde)- nivelador;
	double nave1 = h - (2*borde)- nivelador;
	double nave2 = (nave1 - luzNave) / 2;
	double nave3 = (nave1 - (luzNave*2)) /3;
	double nave4 = (nave1 - (luzNave*3)) /4;


	Primitive3D[] prims();
	//Primitive3D[] prims2();
	//super(env); // Esta es la superficie de la mesa IMPORANTE
	//pln("model : " # env);
	prims <<? coraza(env);
	prims <<? tapaSup(env);
	prims <<? tapaInf(env);
	//prims <<? tabique(env);


	
	//prims <<?kitNave3D(env);
	
	if (tipofuncionSuperficie()==0 ) {
	    prims <<?kitNave3D(env);
	} else if (tipofuncionSuperficie()==1) {
	    //pln("no existe");
	    prims << kitNaveFormicaMelamina3D(env);
	} else if (tipofuncionSuperficie()==2) {
	    //pln("no existe");
	    prims << kitNaveFormicaMelamina3D(env);
	} else {
	    //pln("entro las embebidas");
	    prims <<?kitNave3DEmbebida(env);
	    //roob 06-12-2023  revisar
	    prims << kitEntrepano3D(env);
	    
	}

	/*******************************************************************
	 * kit anclaje pared
	 *******************************************************************/
	if (isSpecial) {
	    //pln("entro aqui ");
	    if (ls <= 0.4) {
		//pln("entro aqui 2");
		prims <<? kitAnclajePared3D(env);
	    }
	    
	}
	


	
	Primitive3D zocalo =  zocalo3D(env);

	Primitive3D locker = Instance3D(prims);
	locker.move((0, 0, elevacionCoraza));


	Primitive3D[] prims2();


	Primitive3D niveladorRespuesta = nivelador(env) ;
	//izquierdo frente
	niveladorRespuesta.move((30mm, 30mm, 0));
	Primitive3D niveladorRespuesta2 = nivelador(env) ;
	//derecho frente
	niveladorRespuesta2.move((w-30mm, 30mm, 0));
	Primitive3D niveladorRespuesta3 = nivelador(env) ;
	//izquierdo atras
	niveladorRespuesta3.move((30mm, ls-30mm, 0));
	Primitive3D niveladorRespuesta4 = nivelador(env) ;
	//derecho atras
	niveladorRespuesta4.move((w-30mm, ls-30mm, 0));
	prims2 <<? niveladorRespuesta;
	prims2 <<? niveladorRespuesta2;
	prims2 <<? niveladorRespuesta3;
	prims2 <<? niveladorRespuesta4;
	/*
	Primitive3D[] nuevo() ;
	nuevo <<? prims2 ;
	*/

	/*
	for ( addOn in getActiveAddons()) {
	    prims <<? addOn.get3D(env);
	    pln(" addOn.get3D(env)" # addOn.get3D(env));
	}
	*/
	//model = safeInstance3D(prims);
	
        //pln("model" # model);

	if (zocaloLockerFuncion().verdadero) {
	    model = safeInstance3D([model] + [locker] + prims2 + [zocalo] );
	} else {
	    model = safeInstance3D([model] + prims + prims2 );
	    //model.rotate((0deg , 0deg , 90deg));
	    /*
	    if (tipofuncionSuperficie().formica30) {
		model = safeInstance3D([model] + prims + prims2 );

	    } else {
		model = safeInstance3D([model] + primsEmbebidas + prims2 );

	    }
	    */


	}

    }
    
