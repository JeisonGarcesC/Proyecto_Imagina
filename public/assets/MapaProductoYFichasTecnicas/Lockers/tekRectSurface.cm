	    Primitive3D[] prims();

	    
	    Cm3D cm = getCm3D(urlCerraduraEmbebida());

	    //mplGetCM3DPrimByID= ESto me retorna el objeto grommet final en si, no en cache
	    //pln("el cm: " # cm);
	    Primitive3D manija = mplGetCM3DPrimByID(env, "2", null, cm);
	    Primitive3D manijaLlave = mplGetCM3DPrimByID(env, "6", null, cm);

	    //////// abelcerradura
	    //manija.move((1mm, 8mm, altura + 12mm));
	    
	    if (countFuntionDoors.nave1) {
	        manija.move((1mm, 8mm, altura + 12mm));
	    } else if (countFuntionDoors.nave2) {
		manija.move((1mm, 8mm, altura + 3.5mm));
	    } else if (countFuntionDoors.nave3) {
		manija.move((1mm, 8mm, altura + 2mm));
	    } else {
		manija.move((1mm, 8mm, altura + 1.5mm));
	    }
	    
	    /*
	    if (modulacionFuncionCerraduras() == 0) {
		manija.move((1mm, 8mm, altura));

		}*/ /*else if (modulacionFuncionCerraduras() == 1) {
		manija.move((2cm, -20mm, altura));
	    } else if (modulacionFuncionCerraduras() == 2) {
		manija.move((21mm, -28mm, altura-50mm));
		manijaLlave.move((21mm, -28mm, altura-50mm));
	    } else if (modulacionFuncionCerraduras() == 3) {
		manija.move((30mm, -2mm, altura-50mm));
		manijaLlave.move((30mm, -2mm, altura-50mm));
	    } else {
		manija.move((2cm, -22mm, altura));
	    }
	      */
	    prims << manija;
	    //prims << manijaLlave;
	    Primitive3D prim = safeInstance3D(prims);
	    
	    result prim;
	};
	return cache;
    }



