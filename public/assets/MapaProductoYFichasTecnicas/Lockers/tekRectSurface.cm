	    altura = 180;
	} else if (alturaReal >180 and alturaReal<=220) {
	    altura = 220;
	}

        double anchoReal= w*100;
	double ancho= 0 ;
	if (anchoReal <=50) {
	    ancho = 50;

	}

	double profundidadReal=ls*100;
	double profundidad=0;
	if (profundidadReal <=50) {
	    profundidad = 50;

	}

	double calibreReal= 22;
	if (calibre== false) {
	    calibreReal= 22;
	} else {
	    calibreReal=24;
	}

	str descripcionSpecial=  "Ancho=" # anchoReal # " Altura=" # alturaReal #  "Profundidad=" # profundidadReal;

	//para el espacial hay que armar uno variable string o una buf y agregar todo las variables que no tienen la palabra real
        
