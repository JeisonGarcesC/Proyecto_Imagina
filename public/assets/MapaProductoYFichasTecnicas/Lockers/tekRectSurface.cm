	    cantidadKitNave= 3;
	} else if (countFuntionDoors()==3) {
	    cantidadVisor= 1 * 3;
	    cantidadKitNave= 4;
	}

	StrBuf buf();
	buf << "LOCKERKITNAVE" # cantidadKitNave # "PFORAP_" # ancho # "_" # profundidad #  "_" # altura ;


	if (isSpecial) {
	    //return MplPart(this, buf.toS, getOptionsMaterialsKitNaveFormica() , quantity=cantidadVisor, descripcionSpecial);
	    //return PriRectWsSpecialPart(this, buf.toS, getOptionsMaterialsKitNaveFormica(),  quantity=cantidadVisor);
