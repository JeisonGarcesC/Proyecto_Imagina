		     kitNave3Respuesta2.move(((moverAFinal3/2, 0, nave3 + (luzNave))*2));
		     prims3 <<? kitNave3Respuesta2;
		 } else {
		     kitNave1Respuesta2.move((moverAFinal3, 0, 0));
		     prims3 <<? kitNave1Respuesta2;
		     kitNave2Respuesta2.move((moverAFinal3, 0, nave4 + (luzNave)));
		     prims3 <<? kitNave2Respuesta2;
		     kitNave3Respuesta2.move(((moverAFinal3/2, 0, nave4 + (luzNave))*2));
		     prims3 <<? kitNave3Respuesta2;
		     kitNave4Respuesta2.move(((moverAFinal3/3, 0, nave4 + (luzNave))*3));
		     prims3 <<? kitNave4Respuesta2;
