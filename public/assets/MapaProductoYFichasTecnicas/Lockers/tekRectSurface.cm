	    return MplSpecialPartJeisonSpecialNaveTriple(this, buf.toS , getOptionsMaterialsKitNaveFormica, quantity=cantidadVisor , withSpecialWord=false);

	}
	return MplPartNoSpecial(this, buf.toS, getOptionsMaterialsKitNaveFormica(), quantity=cantidadVisor);
	 
    }

