    /**
     * Domain.
     */
    //Los parametro de las dimensiones de la mesa. Que tanto puede crece
    // el grommet y el tubo no se estira en lo ancho
    // la sobrecapa y las patas no se ponen si estiro largo
    public SubSet dimensionDomain(str id) {

	//pln("lo que llega en dimensionDomain:  " # id);
	//pln("que es esto   :... " # centimetersS(owner.dimension("s")));
	
	//pln("backWs : " # backWs);
	//pln("que es esto id: " # id);
	//bool hasBack = backWs != null;

	if (isSpecial) {
	    if (id == "b") return DoubleStepRange(30cm, 50cm, 1cm); //22-08-2023
	    if (id == "s") return DoubleStepRange(30cm, 50cm, 1cm);
	    if (id == "h") return DoubleStepRange(165cm, 220cm, 1cm);
	} else {
	    if (id == "b") return DoubleEnum(50cm);
	    if (id == "s") return DoubleEnum(50cm);
	    if (id == "h") return DoubleEnum(180cm, 220cm);
	    
	}
	
	

	return null;
    }

     /**
     * Dimension.
     */
    public double dimension(str id) {
	if (id == "b") return w;
	if (id == "s") return ls;
	if (id == "h") return h;

	return maxDoubleMplWs();
    }

    
    /**
     * Dimensions.
     */
    public str[] dimensions() {
	return ["b", "s", "h"];
    }

    /**
     * Translate.
     */
    public str translateId(str id) {
	if (id == "ls" or id == "rs") return "s";
	if (id == "lb" or id == "rb") return "b";
	if (id == "h") return "h";
	return id;
    }

     /**
     * Set dimension.
     */
    
    public bool setDimension(str id, double v) {
	//pln("lo que hay en id: " # id # "  - lo que hay en v: " # v);

	if (id == "b" and w != v and v in dimensionDomain("b")) {
	    w = v;
	    return true;
	}
	if (id == "s" and ls != v and v in dimensionDomain(translateId("ls"))) {
	    ls = v;
	    return true;
	}
	if (id == "h" and h != v  and v in dimensionDomain("h")) {
	    h = v; // asi debe quedar
	    /*
	    if (alturaLockerFuncion()==0) {
		h= 1800mm;
	    } else {
		h= 2200mm;
	    }
	    */
	    return true;
	}
	
	return false;
    }

     /**
      * getStretchDomain
      */
    
    public str getStretchDomainId(Connector c) {
        str edgeType = getEdgeId(c);
	//pln("lo de ege: " # edgeType);
        if (edgeType == "h") {
	    return "h";
	}
        //return super(..);
	return super(c);
    }

     public bool doStretch(Connector s, point p, AnimationMouseInfo mi) {
        str edgeType = getEdgeId(s);
        if (edgeType == "h") {
	    return stretchHelper(getStretchDomainId(s), -p.y);
	}
	//pln("que es esto " # stretchHelper(getStretchDomainId(h), -p.y) );
	return super(s, p, mi);
	//return true;
        //return MplWorksurface.doStretch(this, s, p, mi);
     }

